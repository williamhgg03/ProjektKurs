tton-container">\n      \x3c!-- Show the create configurations button if not configured --\x3e\n      <div class="btn-group">\n        <button type="button"\n            class="btn btn-secondary add-configuration-button"\n            ng-click="configurationPaneController.addBasicConfigurationTable()"\n            data-bs-original-title="{{ configurationPaneController.getConfigureElementButtonTooltip() }}"\n            data-bs-placement="left">\n          <os-svg icon="configuration-list-button"></os-svg>&ensp;{{configurationPaneController.buttonLabel()}}\n        </button>\n        <button type="button"\n                data-bs-toggle="dropdown"\n                class="btn btn-secondary dropdown-toggle dropdown-toggle-split caret-button"\n                >\n        </button>\n        <ul class="dropdown-menu dropdown-menu-end">\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addListInput()"><os-svg icon="configuration-list-button"></os-svg>&ensp;{{ "List" | i18next}}</a>\n          </li>\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addBooleanInput()"><os-svg icon="configuration-checkbox-button"></os-svg>&ensp;{{ "Checkbox" | i18next}}</a>\n          </li>\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addVariableInput()"><os-svg icon="configuration-variable-button"></os-svg>&ensp;{{ "Configuration variable" | i18next}}</a>\n          </li>\n          <li ng-if="configurationPaneController.hasCopiedConfigurationInputs()">\n            <a class="dropdown-item" ng-click="configurationPaneController.pasteConfigurationInput()"><os-svg icon="paste-command"></os-svg>&ensp;{{ "Paste inputs" | i18next}}</a>\n          </li>\n        </ul>\n      </div>\n    </div>\n    <div ng-if="configurationPaneController.showIsInGlobalVariableStudioAlert()" class="alert-container">\n      <div class="alert alert-info mb-0">\n        <div>\n          <strong>{{ configurationPaneController.getIsInGlobalVariableStudioHeaderText() }}</strong>\n          <br><br>\n          {{ configurationPaneController.getIsInGlobalVariableStudioInfoText() }}\n        </div>\n      </div>\n    </div>\n    <osc-zero-state-screen\n      ng-if="!configurationPaneController.getIsElementConfigured()"\n      class="zero-state-screen-container"\n      icon="configuration-panel-empty"\n      message="{{configurationPaneController.getZeroStateMessage()}}"\n      linkurl="{{configurationPaneController.getHelpUrl()}}"\n      linktext="{{configurationPaneController.getHelpUrlLabel()}}">\n    </osc-zero-state-screen>\n  </div>\n  <div ng-if="configurationPaneController.shouldShowSyncedWithFeatureMessage()" class="configured-status-indicator alert-container">\n    <div class="alert alert-info">\n      <span>\n        {{configurationPaneController.getSyncedWithFeatureMessage()}}\n        <a class="os-alert-link" target="help" href="{{configurationPaneController.getAssemblyMirrorHelpUrl()}}">{{configurationPaneController.getAssemblyMirrorHelpUrlLabel()}}</a>\n      </span>\n    </div>\n  </div>\n  <configuration-tables class="tables-container-wrapper" ng-if="configurationPaneController.getActiveTab() === \'configurations-tab\' && configurationPaneController.getIsElementConfigured()"></configuration-tables>\n  <configured-part-properties class="tables-container-wrapper configured-part-properties-table-container" ng-if="configurationPaneController.getActiveTab() === \'configured-part-properties-tab\' && configurationPaneController.showPartPropertiesTab()"></configured-part-properties>\n  <configured-element-properties class="tables-container-wrapper configured-part-properties-table-container" ng-if="configurationPaneController.getActiveTab() === \'configured-element-properties-tab\' && configurationPaneController.showElementPropertiesTab()"></configured-element-properties>\n  <div class="content-footer os-row"\n       ng-if="configurationPaneController