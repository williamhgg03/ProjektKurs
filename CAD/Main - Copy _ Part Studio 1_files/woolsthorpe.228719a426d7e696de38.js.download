on\' | i18next}}</div>\n              <div class="os-sub-item-value">{{ ctrl.expectedRegion }}</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if="!ctrl.allChecksPassed()" class="card os-compatibility-section reportPanel">\n        <div class="card-header">\n          <h4 class="card-title">\n            {{"Report" | i18next}}\n          </h4>\n        </div>\n        <div class="card-body">\n          <os-download-link id="downloadReport" file-name="OnshapeCompatibilityReport.json" link-text="{{ \'Download report\' | i18next}}" download-method="ctrl.getReport()" ng-if="ctrl.isReportReady()"></os-download-link>\n        </div>\n      </div>\n      <div class="os-check-button-container" ng-if="ctrl.allChecksPassed()">\n        <span class="os-check-goto-button"><a class="btn btn-primary" href="/documents">{{ \'Go to Onshape\' | i18next }}</a></span>\n      </div>\n    </div>\n    <div class="os-filler"></div>\n  </div>\n  <canvas id="testCanvas" data-view-shown="unknown"></canvas>\n</div>\n')}]),e.exports=i},14007:function(e,t,n){var i="/project/web/woolsthorpe/app/partials/confirmDeleteWorkspaceDialog.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="modal-header">\n  <h4 class="modal-title">{{ "Delete workspace?" | i18next}}</h4>\n  <button type="button" class="btn-close" aria-hidden="true" ng-click="$dismiss()"></button>\n</div>\n<div ng-if="!details.isActiveBranch" class="modal-body confirm-delete-workspace-message" ng-i18next="[html:i18next]({name:details.workspaceName, context: \'delete-workspace-confirm\', description: \'Confirmation message when deleting a non-active workspace\'})This will delete workspace <b>__name__</b>."></div>\n<div ng-if="details.isActiveBranch" class="modal-body confirm-delete-workspace-message" ng-i18next="[html:i18next]({name:details.workspaceName, parentName: details.parentName})This will delete workspace <b>__name__</b> and navigate you to <b>__parentName__<