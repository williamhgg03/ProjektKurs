epth.zw);\n    vec3 position = getPosition(gl_FragCoord.xy, depth);\n\n\n    // loop through samples that define occlusion\n    float random = TEXTURE_2D(uRandomTexture, vTextureCoordinate * uRandomTextureScale).r;\n    float occlusion = 0.0;\n    float radiusMax = uRadiusNear + (uRadiusFar - uRadiusNear) * depth;\n    float radiusMin = radiusMax / float(nRadial);\n    float angleStep = 6.2831853 / float(nAngular);\n    float angle = 6.2831853 * random;  // randomly rotate the sampling rings\n    for (int i = 0; i < nRadial; ++i) {\n      float radius = radiusMin * float(i + 1);\n\n      for (int j = 0; j < nAngular; ++j) {\n        vec2 offset = radius * vec2(cos(angle), sin(angle));\n        occlusion += getOcclusion(gl_FragCoord.xy + offset, position, normal);\n        angle += angleStep;\n      }\n      angle -= angleStep / 2.0;  // ensure we hit the in-between samples in the next ring\n    }\n    occlusion /= float(nRadial * nAngular);\n    occlusion *= float(depth < 1.0);\n    FRAG_COLOR = vec4(occlusion, 0.0, 0.0, 1.0);\n}\n"},20364:function(e,t){"use strict";t.A="\n{{{compatibility}}}\n\nuniform vec4 uViewport;\nuniform sampler2D uOcclusionMap;\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    #define uFilterRadius 2\n\n    float occlusion = 0.0;\n    float count = 0.0;\n\n    for (int x = -uFilterRadius; x <= uFilterRadius; ++x) {\n      for (int y = -uFilterRadius; y <= uFilterRadius; ++y) {\n        vec2 offset = vec2(float(x), float(y));\n        vec2 uv = (gl_FragCoord.xy + offset - uViewport.xy) / uViewport.zw;\n        float occlusionSample = TEXTURE_2D(uOcclusionMap, uv).r;\n        float weight = 1.0 / (1.0 + dot(offset, offset));\n        occlusion += weight * occlusionSample;\n        count += weight;\n      }\n    }\n    occlusion /= count;\n\n    FRAG_COLOR = vec4(occlusion, 0.0, 0.0, 1.0);\n}\n"},17671:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN lowp vec4 vColor;\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    FRAG_COLOR = vCol