323:function(e,t){"use strict";t.A="{{{compatibility}}}\n\n#ifndef DRAFT_TOLERANCE\n#define DRAFT_TOLERANCE 0.0001\n#endif\n\nFRAG_IN highp vec3 vPosition;\nFRAG_IN highp vec3 vWorldPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN mediump vec2 vTextureCoordinate;\nFRAG_IN lowp vec3 vAmbient;\nFRAG_IN lowp vec3 vDiffuse;\nFRAG_IN lowp vec3 vSpecular;\nFRAG_IN lowp float vOpacity;\n\nuniform mediump vec3 uDraftAnalysisDirection;\nuniform mediump float uMinimumDraftAngle;\nuniform mediump int uDoDraftAnalysis;\n\nuniform sampler2D uDraftShadowMap;\nuniform mediump mat4 uPMVMatrixWith;\nuniform mediump mat4 uPMVMatrixAgainst;\nuniform mediump float uDraftShadowMapPixelWidth;\nuniform mediump float uDraftShadowMapPixelHeight;\n\nuniform mediump vec4 uSteepDraftColor;\nuniform int uShowUndercut;\nuniform mediump vec4 uUndercutColor;\nuniform mediump vec4 uWithDirectionColor;\nuniform mediump vec4 uAgainstDirectionColor;\n\n{{{constants}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\n// Returns vec4(normalized x position in [0, 1], normalized y position in [0, 1], depth of this fragment)\nDECLARE_FRAG_COLOR\n\nvec3 sampleLocation(mat4 matrix) {\n    vec4 position = matrix * vec4(vWorldPosition, 1.0);\n    vec3 positionInNdcSpace = (1.0 / position.w) * vec3(position);\n    return 0.5 * positionInNdcSpace + 0.5;\n}\n\n\nfloat getCenterUndercutColorWeightSteep(float normalDotDraftDirection) {\n// Apply a larger sampling radius on steep fragments, since there tend to be more areas on them\n#define FILTER_RADIUS 3.0\n// Since there are more errors on such fragments, we have a fairly large sample bias factor to increase the number\n// of samples that need to be considered undercut before shading them as such\n#define SAMPLE_BIAS_FACTOR 0.75\n{{{undercutWeightFunction}}}\n}\n\nfloat getCenterUndercutColorWeight(float normalDotDraftDirection) {\n#undef FILTER_RADIUS\n#undef SAMPLE_BIAS_FACTOR\n// We use a smaller radius for oblique fragments