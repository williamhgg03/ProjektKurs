List.length === 0">\n      {{\'No items found.\' | i18next}}\n    </div>\n    <div class="insert-items-item-row spinner-holder-loading" ng-if="ctrl.loadingItems">\n      <os-spinner spinner="insertItemsSpinner"></os-spinner>\n    </div>\n  </div>\n  <div os-default-length="185px" class="insert-items-splittercontainer-row">\n    <div class=" os-col">\n      <insert-items-details selected-item="ctrl.selectedItem"\n                            bt-parameters="ctrl.btParameters"\n                            build-context-menu-for-parameter="ctrl.buildContextMenuForParameter">\n      </insert-items-details>\n      <div class="insert-items-insert-div">\n        <button type="button"\n                class="btn btn-secondary"\n                ng-disabled="!ctrl.selectedItem || !ctrl.canInsert"\n                data-bs-original-title="{{\'tooltips:::Insert selected item\' | i18next}}"\n                ng-click="ctrl.doInsert()">{{"Insert" | i18next}}\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n')}]),e.exports=i},12147:function(e,t,n){var i="/project/web/ts/items/itemDetailsTemplate.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<form name="itemDetailsForm" novalidate="novalidate" autocomplete="off">\n  <div ng-if="$ctrl.initialized" class="user-settings os-form os-form-container">\n    <div class="section-header os-row">\n      <h4>{{ "Metadata" | i18next }}</h4>\n    </div>\n\n    <metadata-property-sheet class="property-sheet-container"\n      selected="$ctrl.selected"\n      editor="$ctrl.editor"\n      form-ctrl="itemDetailsForm"\n      show-edit-path="false"\n      placeholders="placeholders"\n      on-change="$ctrl.onPropertyChange(propertyId, value)"\n      has-load-failure="false"\n      property-id-to-popover-text="$ctrl.propertyIdToPopoverText"\n      company-id="$ctrl.companyId"\n      part-number-val-gen-config="$ctrl.partNumberGenConfig">\n    </metadata-property-sheet>\n\n    <div class="section-header os-row">\n      