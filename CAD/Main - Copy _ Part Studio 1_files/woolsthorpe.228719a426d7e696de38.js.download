()}}">\n      </osc-zero-state-screen>\n    </div>\n    <div ng-if="$ctrl.canQueryWhereUsed() && !$ctrl.showEmptyState()" oncontextmenu="return false;">\n      <div class="os-where-used-filter-area os-row os-grow info-panel">\n        \x3c!-- item icon --\x3e\n        <span data-bs-original-title="{{$ctrl.sourceItem.name}}" data-expand-delay="0" data-bs-html="true" data-bs-placement="bottom">\n          <os-svg icon="{{$ctrl.getTypeIcon()}}" bt-no-focus class="type-icon"></os-svg>\n        </span>\n        \x3c!-- end item icon --\x3e\n        <div class="os-where-used-section-header os-row os-grow">\n          \x3c!-- configuration filter dropdown --\x3e\n          <div class="ellipseOverflowText os-row" ng-if="$ctrl.hasConfig">\n            <div ng-if="$ctrl.configFiltersDisplay.length === 0">\n              <div class="os-search-highlight-name item-name-container ellipseOverflowText source-name" data-bs-original-title="{{$ctrl.sourceItem.name}}">\n                <span class="ellipseOverflowText">{{$ctrl.sourceItem.name}}</span>\n              </div>\n            </div>\n            <div ng-if="$ctrl.configFiltersDisplay.length > 0" class="ellipseOverflowText">\n              <div data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' class="os-where-used-filter-dropdown os-row os-grow config">\n                <div class="os-search-highlight-name item-name-container ellipseOverflowText source-name" data-bs-original-title="{{$ctrl.sourceItem.name}}">\n                  <span class="ellipseOverflowText">{{$ctrl.sourceItem.name}}</span>\n                </div>\n                <span class="source-filter caret"></span>\n              </div>\n              <ul class="filter-drop-down dropdown-menu config" role="menu">\n                <li ng-repeat="anOption in $ctrl.getConfigFilterArray()" ng-class="{\'os-selected\': $ctrl.isConfigFilterSelected(anOption, $ctrl.selectedConfigFilter)}"\n                  class="os-selectable-item where-used-filter os-col" ng-click="$ctrl.changeConfigFilter(anOption)">\n                  <div class="os-row config-part-name">\n                    <os-svg icon="{{$ctrl.getTypeIcon(anOption)}}" bt-no-focus class="type-icon"></os-svg>\n                    <span class="name ellipseOverflowText" data-bs-original-title="{{anOption.partName}}">{{anOption.partName}}</span>\n                    <span class="versions os-row">\n                      <span class="ellipseOverflowText os-row" data-bs-original-title="{{anOption.version.name}}">\n                        <os-svg icon="{{$ctrl.getConfigVersionType(anOption)}}" class="selected-filter-icon" bt-no-focus></os-svg>\n                        <span class="other-versions ellipseOverflowText">{{anOption.version.name}}</span>\n                      </span>\n                      <span class="ellipseOverflowText os-row" ng-repeat="v in anOption.otherVersions" data-bs-original-title="{{v.name}}">\n                        <os-svg icon="{{$ctrl.getConfigVersionType(v)}}" class="selected-filter-icon" bt-no-focus></os-svg>\n                        <span class="other-versions ellipseOverflowText">{{v.name}}</span>\n                      </span>\n                    </span>\n                  </div>\n                  <div class="os-row">\n                    <where-used-config-list ng-if="anOption.configuration.length !== 0" config-filter="anOption" configuration-name="anOption.partName"\n                      class="config-params os-col" ng-class="{\'os-selected\': $ctrl.isConfigFilterSelected(anOption, $ctrl.selectedConfigFilter)}"></where-used-config-list>\n                    <span class="config-preview" ng-class="{\'non-config\' : anOption.configuration.length === 0}">\n                      <os-thumbnail\n                        class="thumbnail-image-dropdown"\n                        has-thumbnail=\'true\'\n                        document-id="{{anOption.document.id}}"\n                        workspace-id=""\n                        versi