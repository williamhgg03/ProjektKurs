eldName.$error.validtext">\n          {{\' Field must contain at least one letter or number.\' | i18next}}\n      </p>\n    </div>\n\n    <div ng-if="::(!$ctrl.computed)" class="standard-attributes">\n      \x3c!-- Value type --\x3e\n      <div class="clearfix">\n        <div class="custom-properties-form-group col-lg-4">\n          <label for="valueTypeId" class="control-label">\n            {{ \'Type\' | i18next }}\n          </label>\n          \x3c!-- For active or inactive state this field is always disabled  --\x3e\n          <span\n            ng-if="!$ctrl.isInitialPublishStatePending()"\n            id="valueTypeId"\n            name="valueTypeName"\n            ng-disabled="true"\n            class="form-control">\n              {{$ctrl.valueTypeName}}\n          </span>\n          <select\n            ng-if="$ctrl.isInitialPublishStatePending()"\n            id="valueTypeId"\n            name="valueTypeName"\n            ng-change="$ctrl.valueTypeChanged()"\n            ng-model="$ctrl.property.valueType"\n            ng-options="valueType.value as valueType.label for valueType in $ctrl.valueTypeEntries"\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            class="form-control">\n            <option\n              ng-repeat="valueTypeEntry in $ctrl.valueTypeEntries"\n              value="{{valueTypeEntry.value}}"\n              ng-selected="valueTypeEntry.value === $ctrl.property.valueType">\n              {{valueTypeEntry.label || valueTypeEntry.value}}\n            </option>\n          </select>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.valueTypeName.$error.required">\n              {{\'Required field must not be empty.\' | i18next}}\n          </p>\n        </div>\n      </div>\n\n      \x3c!-- Unit type --\x3e\n      <div class="clearfix" ng-if="$ctrl.canHaveUnits()">\n        <div class="custom-properties-form-group col-lg-4">\n          <label for="quantityTypeId" class="control-label"