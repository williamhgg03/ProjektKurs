()}"\n                        data-bs-original-title="{{annotationPaneController.getDefaultFilterTooltip()}}"\n                        class="os-button os-clear">\n                        <os-svg icon="tolerance-schema"></os-svg>\n                      </button>\n                      <div uib-dropdown auto-close="outsideClick">\n                        <button\n                          class="btn btn-secondary dropdown-toggle"\n                          ng-class="{\'filter-selected\': annotationPaneController.hasFilteredAnnotationTypes()}"\n                          type="button"\n                          uib-dropdown-toggle\n                          data-bs-original-title="{{annotationPaneController.getAnnotationTypesFilterTooltip()}}"\n                          aria-expanded="false">\n                          {{annotationPaneController.getAnnotationTypesFilterLabel()}}\n                          <span ng-show="annotationPaneController.hasFilteredAnnotationTypes()" class="badge bg-primary">\n                            {{annotationPaneController.getFilteredAnnotationTypeCount()}}\n                          </span>\n                        </button>\n                        <div uib-dropdown-menu>\n                          <label\n                            ng-repeat="item in annotationPaneController.getFilterableAnnotationTypes()"\n                            data-bs-original-title="{{item.label}}"\n                            data-bs-placement="right"\n                            class="dropdown-item form-check-label clickable ps-2">\n                            <input\n                              class="form-check-input"\n                              type="checkbox"\n                              ng-checked="annotationPaneController.isAnnotationTypeFiltered(item.type)"\n                              ng-click="annotationPaneController.toggleAnnotationTypeFilter(item.type)" />\n                            {{item.label}}\n                          </label>