tal zones\' | i18next}}</label>\n              <select ng-model="drawing.customNumberHorizontalZones">\n                <option value=\'0\'>0</option>\n                <option value=\'2\'>2</option>\n                <option value=\'4\'>4</option>\n                <option value=\'6\'>6</option>\n                <option value=\'8\'>8</option>\n                <option value=\'10\'>10</option>\n                <option value=\'12\'>12</option>\n                <option value=\'14\'>14</option>\n                <option value=\'16\'>16</option>\n                <option value=\'18\'>18</option>\n                <option value=\'20\'>20</option>\n              </select>\n            </div>\n            <div ng-show="drawing.customIncludeBorder === true" class="vertical-zone-options custom-option">\n              <label class="options-label">{{ \'Vertical zones\' | i18next}}</label>\n              <select ng-model="drawing.customNumberVerticalZones">\n                <option value=\'0\'>0</option>\n                <option value=\'2\'>2</option>\n                <option value=\'4\'>4</option>\n                <option value=\'6\'>6</option>\n                <option value=\'8\'>8</option>\n                <option value=\'10\'>10</option>\n                <option value=\'12\'>12</option>\n                <option value=\'14\'>14</option>\n                <option value=\'16\'>16</option>\n                <option value=\'18\'>18</option>\n                <option value=\'20\'>20</option>\n              </select>\n            </div>\n            <div ng-show="drawing.customIncludeBorder === true" class="zone-start-options custom-option radio-text-option">\n              <label class="options-label">{{ \'Start zones\' | i18next}}</label>\n              <span ng-class="{\'strong\': (drawing.customStartZones === \'bottomright\'), \'btn-link\': (drawing.customStartZones !== \'bottomright\')}" class="radio-text-button" ng-click="drawing.customStartZones = \'bottomright\'">{{\'Bottom right\' 