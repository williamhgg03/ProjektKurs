ion && createNewPublicationOnly">\n        <div class="os-modal-control doc-pub-create-update-dialog">\n          <document-name-control\n            doc-type-label="fieldLabelPublicationName"\n            document-name="document.name"\n            is-valid="document.nameValid">\n          </document-name-control>\n        </div>\n        <div class="os-modal-control doc-pub-create-update-dialog">\n          <publication-description-control\n            publication-description="document.description"\n            is-valid="document.descValid">\n          </publication-description-control>\n        </div>\n      </div>\n      <div class="os-modal-control doc-pub-create-update-dialog"\n           ng-if="availableLabels && !(isPublication && !createNewPublicationOnly)"\n           data-automation="dialog-document-labels"\n      >\n        \x3c!-- Create document and publication dialog labels --\x3e\n        <document-labels-control\n          is-publication="isPublication"\n          disable="shouldDisableLabelDropdown()"\n          labels="labels"\n          available-labels="availableLabels"\n          class="os-modal-control doc-pub-create-update-dialog"\n        ></document-labels-control>\n      </div>\n      <section class="os-modal-control doc-pub-create-update-dialog" ng-if="isPublication && !createNewPublicationOnly">\n        <label>\n          <input type="radio" ng-checked="!addToExisting" ng-value="false" ng-model="addToExisting" ng-change="onAddingToExistingPublicationOrNot(addToExisting)"/>\n          <span class="control-label publication">{{"Create new publication" | i18next}}</span>\n        </label>\n        <label class="radio-label-subsequent">\n          <input type="radio" ng-checked="addToExisting" ng-value="true" ng-model="addToExisting" ng-change="onAddingToExistingPublicationOrNot(addToExisting)"/>\n          <span class="control-label publication">{{"Add to existing publication" | i18next}}</span>\n        </label>\n        <div class="alert 