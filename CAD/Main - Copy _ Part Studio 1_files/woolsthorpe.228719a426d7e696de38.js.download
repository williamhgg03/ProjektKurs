ngAngle) / 0.25);\n\n        // Randomize the start angle for each ring to avoid visible patterns\n        float baseAngle = randomSeed * TWO_PI + float(i) * 0.37;\n\n        for (int n = 0; n < samplesPerPass; ++n) {\n            float angle = baseAngle + float(n) * (TWO_PI / float(samplesPerPass));\n            // sample direction on this ring\n            vec3 offsetDir = normalize(\n                worldReflection +\n                axis1 * (cos(angle) * ringAngle) +\n                axis2 * (sin(angle) * ringAngle)\n            );\n\n            vec4 sampleColor = TEXTURE_2D(uEnvironmentTexture, getLatLong(offsetDir));\n            accumulatedColor += (sampleColor * ringWeight);\n            totalWeight += ringWeight;\n        }\n    }\n\n    return accumulatedColor / totalWeight;\n}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    if (uForceDefaultLighting) {\n        FRAG_COLOR = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n        return;\n    }\n\n    vec4 diffuseColor;\n    vec3 worldReflection;\n\n    if (uEnvironmentLockEnabled) {\n        worldReflection = getLockedWorldReflection();\n    } else {\n        worldReflection = getWorldReflection();\n    }\n\n    if (uEnvironmentBlurEnabled) {\n        diffuseColor = getBlurredSample(worldReflection);\n    } else {\n        diffuseColor = TEXTURE_2D(uEnvironmentTexture, getLatLong(worldReflection));\n    }\n\n    FRAG_COLOR = lightFragment(diffuseColor.rgb, diffuseColor.rgb, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},6509:function(e,t){"use strict";t.A="\n{{{compatibility}}}\n\nDECLARE_FRAG_COLOR\n\nuniform mediump vec4 uViewport;\n\nFRAG_IN lowp vec4 vColor;\nFRAG_IN mediump float vLineWidth;\nFRAG_IN mediump float vDistance;\nFRAG_IN mediump float vLength;\nFRAG_IN mediump float vSilhouetteTest;\nFRAG_IN highp vec3 vPosition;\n\n{