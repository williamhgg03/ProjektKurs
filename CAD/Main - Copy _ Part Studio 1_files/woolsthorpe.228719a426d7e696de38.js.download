terisedLink()"\n              data-bs-original-title="{{ NavbarController.getCopyLinkTooltip() }}"\n              data-bs-expanded-content="{{ NavbarController.getExtendedCopyLinkTooltip() }}"\n              data-bs-placement="bottom">\n              <os-svg icon="document-links" class="document-link-icon"></os-svg>\n        </div>\n      </div>\n\n        \x3c!-- parent folder large/small screen --\x3e\n        <div ng-if="(NavbarController.isInFolder() || NavbarController.isInProject()) && !NavbarController.isParentResourceCompany()">\n          <a ng-href="{{NavbarController.goToFolderOrProject()}}" target="_blank" data-bs-placement="bottom" class="os-row folder"\n             data-bs-original-title="{{ \'Go to __folderName__\' | i18next:{folderName: NavbarController.getParentFolderName()} }}">\n            <os-svg icon="folder" class="lg-svg" ng-if="NavbarController.isInFolder()"></os-svg>\n            <os-svg icon="project" class="lg-svg" ng-if="NavbarController.isInProject()"></os-svg>\n            <span class="name ellipseOverflowText d-none d-xl-block">\n              {{NavbarController.getParentFolderName()}}\n            </span>\n          </a>\n        </div>\n\n        \x3c!-- Inline public document icons (large screens) --\x3e\n        <div class="os-no-shrink d-none d-xl-block" ng-class="{\'d-sm-block\': NavbarController.visibilityControls.educationBadge && !NavbarController.visibilityControls.publicBadge}">\n          <span os-document-icon visibility-controls="NavbarController.visibilityControls" is-publication="NavbarController.isPublication()"></span>\n        </div>\n        <os-public-stats class="os-public-stats navbar-public-stats os-no-shrink d-none d-xl-block" document="openDocument" ng-if="openDocument.public"></os-public-stats>\n\n        \x3c!-- Public icons dropdown (small screens) --\x3e\n        <div class="os-no-shrink d-xl-none" uib-dropdown data-bs-original-title="{{\'tooltips:::Public stats\' | i18next}}" data-bs-placement="bottom" 