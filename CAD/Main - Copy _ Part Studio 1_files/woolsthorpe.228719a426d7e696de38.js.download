           ng-change="annotationPaneController.onModelSelected()"\n                ng-options="model.name for model in annotationPaneController.modelList track by model.id">\n        </select>\n        <button\n          ng-if="annotationPaneController.canFilter() && annotationPaneController.canIsolateParts()"\n          ng-click="annotationPaneController.toggleFocusedIsolateMode()"\n          ng-class="{\'os-active\': annotationPaneController.isInFocusedIsolateMode()}"\n          data-bs-original-title="{{annotationPaneController.getFocusedIsolateModeLabel()}}"\n          class="os-button os-clear">\n          <os-svg icon="isolate-button"></os-svg>\n        </button>\n        <div class="os-tolerance-schema-info" ng-if="annotationPaneController.canSelectToleranceSchema()">\n          <osx-reference-parameter ng-if="annotationPaneController.isReferenceParameterAngular20Enabled"\n            [bt-parameter]="annotationPaneController.toleranceSchemaParameter" class="annotations-schema-selector">\n          </osx-reference-parameter>\n          <os-reference-parameter ng-if="!annotationPaneController.isReferenceParameterAngular20Enabled"\n            bt-parameter="annotationPaneController.toleranceSchemaParameter" class="annotations-schema-selector">\n          </os-reference-parameter>\n          <div ng-if="annotationPaneController.hasVersionedSchema()" class="version-icon" ng-click="annotationPaneController.onSchemaVersionIconClicked()">\n            <os-svg icon="{{ annotationPaneController.getSchemaVersionIcon() }}"></os-svg>\n          </div>\n\n          <div ng-if="annotationPaneController.hasVersionedSchema()">\n            {{ annotationPaneController.schemaVersionName }}\n          </div>\n        </div>\n\n        <span ng-switch-when="false" class="no-inspection-panel-models">\n          <div ng-switch="annotationPaneController.haveReceivedInspectionTableData">\n            <span ng-switch-when="true">\n              {{"No models." | i18next}}\n            </span>\n            <span ng-switch-when="false">\n              {{"Fetching models." | i18next}}\n            </span>\n          </div>\n        </span>\n        <div class="dropdown options-dropdown float-end">\n          <button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">\n            <os-svg icon="overflow"></osx-svg>\n          </button>\n          <div class="dropdown-menu">\n            <button ng-if="annotationPaneController.canExport()" class="dropdown-item" ng-click="annotationPaneController.doExport()">{{ "Export to CSV" | i18next}}</button>\n          </div>\n        </div>\n    </div>\n\n    \x3c!-- Toolbar --\x3e\n    <div class="inspection-toolbar os-control-container">\n      <mbd-table-tools annotation-tools="annotationPaneController.annotationTools" annotation-control-tools="annotationPaneController.annotationControlTools" />\n    </div>\n\n    \x3c!-- Inspection Tables --\x3e\n    <div ng-if="annotationPaneController.hasInspectionTableModels()" os-select-dropdown-bounds class="tables-container-wrapper os-grow">\n        <div class="tables-container"\n             os-table-container\n             os-virtual-scroll\n             os-scroll-selected>\n             <div class="inspection-table-container datums-table" data-parameter-id="datumsTable">\n              <div class="os-table-description">\n                <div class="compact-table-row-clickable"\n                       ng-click="annotationPaneController.toggleIsDatumsTableExpanded($event)">\n                    <os-svg\n                      class="os-icon-xsmall"\n                      icon="{{annotationPaneController.isDatumsTableExpanded ? \'expanded\' : \'collapsed\'}}">\n                    </os-svg>\n                  </div>\n                  <div class="os-table-title">\n                    {{annotationPaneController.getActiveDatumsTable().getTitle()}}\n                      <span ng-show="annotationPaneController.canFilter()" class="inspection-table-su