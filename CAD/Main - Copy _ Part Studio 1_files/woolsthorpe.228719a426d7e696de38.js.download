>\n            </div>\n          </div>\n        </div>\n        <div ng-repeat="configParam in $ctrl.allConfigurationParams" class="config-param-row config-param-border"\n          ng-if="$ctrl.shouldShowRowForConfigParam(configParam.getParameterId())"\n          data-automation="visibility-configuration"\n          data-id={{configParam.getParameterId()}}\n          data-label={{configParam.getDisplayName()}}\n          ng-class="{\'no-bottom-border\': !$ctrl.getIsExpanded(configParam.getParameterId())}"\n        >\n          <div class="config-param-header w-100">\n            <div class="d-flex align-items-center w-95">\n              <div class="compact-table-row-clickable"\n                ng-click="$ctrl.toggleIsExpanded(configParam.getParameterId())">\n                <os-svg class="os-icon-xsmall" icon="{{$ctrl.getIsExpanded(configParam.getParameterId()) ? \'expanded\' : \'collapsed\'}}"/>\n              </div>\n              <os-svg ng-if="configParam.getIsCosmetic()" class="cosmetic-icon" icon="configuration-exclude-properties"\n                data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"></os-svg>\n              <div class="config-param-name" data-bs-placement="top" data-bs-original-title="{{configParam.getDisplayName()}}">\n                {{configParam.getDisplayName()}}\n              </div>\n              <div ng-if="$ctrl.showWarningIcon(configParam.getParameterId())" class="flex-even-spacing h-100">\n                <os-svg class="param-warn-icon" icon="performance-warning"\n                  data-bs-original-title="{{\'Some options do not have an option rule. They will always be hidden.\' | i18next}}"\n                  data-bs-placement="right" />\n              </div>\n              <div ng-if="!$ctrl.getIsExpanded(configParam.getParameterId())" class="condition-summary-text w-90"\n                data-bs-original-title="{{$ctrl.getParameterVisibilityText(configParam.getParameterId())}}">\n 