<div class="alert alert-info" ng-switch-when="true">\n      <span>\n        <strong>{{$ctrl.getNoActionLabel()}}</strong>\n      </span>\n    </div>\n    <div class="table-scroll-container" ng-switch-when="false">\n    <table class="os-table">\n      <thead class="os-thead">\n        \x3c!-- Header row --\x3e\n        <tr class="os-tr">\n          \x3c!-- Reference name header --\x3e\n          <th class="os-th reference-name">\n            <div class="cell-content">\n              <span class="cell-label">{{ "References" | i18next }}</span>\n              <label class="os-param-checkbox">\n                <input class="os-param-checkbox-input" type="checkbox" ng-checked="$ctrl.isAllChecked()"\n                  ng-disabled="$ctrl.isAllDisabled()" ng-click="$ctrl.onAllCheckboxChange()" />\n                <span class="os-checkbox-indicator"></span>\n              </label>\n            </div>\n          </th>\n          \x3c!-- Configuration parameter input names --\x3e\n          <th class="os-th config-input-column" ng-if="!$ctrl.isNonexistentInAllReferences(configParam.getParameterId())"\n            ng-repeat="configParam in $ctrl.configurationParameters">\n            <div class="cell-content">\n              <label class="os-param-checkbox">\n                <input class="os-param-checkbox-input" type="checkbox"\n                  ng-checked="$ctrl.isColumnChecked(configParam.getParameterId())"\n                  ng-disabled="$ctrl.isColumnDisabled(configParam.getParameterId())"\n                  ng-click="$ctrl.onColumnCheckboxChange(configParam.getParameterId())" />\n                <span class="os-checkbox-indicator"></span>\n              </label>\n              <span class="cell-label header-label">{{ configParam.getDisplayName()}}</span>\n              <div class="d-flex align-items-center justify-content-center gap-1">\n                \x3c!-- visibility conditions icon --\x3e\n                <div ng-if="configParam.getVisibilityCondition() && configParam.getVisibilityCondition().isEmpty() === false"\n                  class="os-no-shrink d-flex align-items-center show-visibility-condition-icon"\n                  data-bs-original-title="{{\'tooltips:::has visibility conditions\' | i18next}}" data-bs-placement="bottom">\n                  <os-svg icon="configuration-visibiliity" />\n                </div>\n                \x3c!-- Excluded from affecting configured properties icon --\x3e\n                <div ng-if="configParam.getIsCosmetic()" class="os-no-shrink d-flex align-items-center show-visibility-condition-icon"\n                  data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"\n                  data-bs-placement="bottom">\n                  <os-svg icon="configuration-exclude-properties" />\n                </div>\n              </div>\n            </div>\n          </th>\n        </tr>\n      </thead>\n      <tbody class="os-tbody">\n        \x3c!-- Data rows --\x3e\n        <tr class="os-tr" ng-if="!$ctrl.areAllConfigurationInputsNonexistentInReference(configurableNodeId)"\n          ng-repeat="configurableNodeId in $ctrl.getConfigurableNodeIds()">\n          \x3c!-- Reference name cell --\x3e\n          <td class="os-td reference-name os-padded-table-cell">\n            <div class="cell-content">\n              <span class="cell-label">{{$ctrl.getNodeName(configurableNodeId)}}</span>\n              <label class="os-param-checkbox">\n                <input class="os-param-checkbox-input" type="checkbox"\n                  ng-checked="$ctrl.isRowChecked(configurableNodeId)"\n                  ng-disabled="$ctrl.isRowDisabled(configurableNodeId)"\n                  ng-click="$ctrl.onRowCheckboxChange(configurableNodeId)" />\n                <span class="os-checkbox-indicator"></span>\n              </label>\n            </div>\n          </td>\n          \x3c!-- Configuration parameter input cells with checkboxes --\x3e\n          <td class="os-td config-input-column os-padded-table-cell"\n            ng-repeat="configurationParameter in $ctrl.configurationParameters"\n            ng-if="!$ctrl.isNonexistentInAllReferences(configurationParameter.getParameterId())">\n            <div class="cell-content justify-content-start">\n              \x3c!-- Cell-level checkbox --\x3e\n              <label ng-if="!$ctrl.isReadOnly(configurableNodeId, configurationParameter.getParameterId())"\n                class="os-param-checkbox">\n                <input class="os-param-checkbox-input" type="checkbox"\n                  ng-checked="$ctrl.isCellChecked(configurableNodeId, configurationParameter.getParameterId())"\n                  ng-click="$ctrl.onCellCheckboxChange(configurableNodeId, configurationParameter.getParameterId())" />\n                <span class="os-checkbox-indicator"></span>\n              </label>\n              <span class="cell-label">{{$ctrl.getText($ctrl.getStatusFor(configurableNodeId,\n                configurationParameter.getParameterId()))}}</span>\n              \x3c!-- Info icon showing tooltip messages explaining the match, if any --\x3e\n              <div ng-if="$ctrl.hasToolTipMessagesFor(configurableNodeId, configurationParameter.getParameterId())"\n                class="os-no-shrink d-flex align-items-center cell-tooltip-icon"\n                data-bs-html="true"\n                data-bs-original-title="{{$ctrl.getToolTipMessagesHtml(configurableNodeId, configurationParameter.getParameterId())}}"\n                data-bs-placement="bottom">\n                <os-svg icon="info" />\n              </div>\n            </div>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n    </div>\n  </div>\n  \x3c!-- Footer is outside the scrolling table, so Confirm stays put --\x3e\n  <div class="modal-footer d-flex justify-content-between">\n    <os-vue-help-link-component class="mx-2" v-props="{helpContextKey: \'config_pass_through\'}"></os-vue-help-link-component>\n    <div class="d-flex align-items-center footer-actions">\n      <span class="new-inputs-to-wire-count">{{$ctrl.getNewInputsToWireCountLabel()}}</span>\n      <button class="btn btn-primary" type="button" ng-click="$ctrl.onConfirm()">{{ "Confirm" | i18next }}</button>\n    </div>\n  </div>\n</div>\n')}]),e.exports=i},35867:function(e,t,n){var i="/project/web/ts/configurations/configurationSummary.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div ng-controller="ConfigurationSummaryController as configurationSummaryController"\n     id="configuration-summary-container"\n     os-sized-per-tab="true"\n     class="ns-dialog-visibility-hidden"\n     os-min-length="30"\n     os-default-length="80"\n     os-remember-length="true">\n  <div class="os-col"\n       id="configuration-summary">\n    <div class="left-panel-header">\n      <span class="ns-subdialog-title">{{ "Configurations" | i18next }}</span>\n\n      \x3c!-- Plain visibility conditions icon, used when WEB.RESET_CONFIGURATION_BUTTON is disabled, or when\n           "Reset to default" isn\'t available (revisioned assembly in a publication) --\x3e\n      <a ng-if="!configurationSummaryController.getShowResetConfigurationDropdown() && configurationSummaryController.getCanShowVisibilityConditionIcon()"\n        ng-click="configurationSummaryController.openVisibilityConditionDialog()"\n        data-bs-original-title="{{ configurationSummaryController.getVisibilityConditionTooltipAndMenuLabel() }}" data-bs-placement="right"\n        class="visibility-conditions-icon visibility-conditions-button">\n        <os-svg icon="configuration-visibiliity"/>\n      </a>\n\n      \x3c!-- New dropdown for configuration visibility button and reset to default button enabled by WEB.RESET_CONFIGURATION_BUTTON --\x3e\n      \x3c!-- Since the configuration visibility button was gated by timing things, the whole dropdown should be as well --\x3e\n      <div class="set-configuration configuration-summary-dropdown"\n            ng-if="configurationSummaryController.getShowResetConfigurationDropdown()">\n        <a class="set-config-button visibility-conditions-button"\n              data-bs-original-title="{{ configurationSummaryController.getVisibilityConditionTooltipAndMenuLabel() }}"\n              data-bs-placement="right"\n              ng-click="configurationSummaryController.openVisibilityConditionDialog()">\n          <os-svg class="os-icon-medium" icon="configuration-visibiliity"></os-svg>\n        </a>\n        <div class="dropdown">\n          <button class="set-config-dropdown"\n                  data-bs-toggle="dropdown"\n                  data-bs-config=\'{"popperConfig":{"strategy":"fixed"}}\'\n                  type="button"\n                  aria-haspopup="menu"\n                  aria-expanded="false"\n                  aria-label="{{ \'Configuration actions\' | i18next }}">\n            <os-svg class="os-icon-xsmall" icon="dropdown-arrow"></os-svg>\n          </button>\n\n          <ul class="dropdown-menu dropdown-menu-end" role="menu">\n            <li>\n              <button class="dropdown-item"\n                      ng-click="configurationSummaryController.openVisibilityConditionDialog()">\n                <os-svg icon="configuration-visibiliity"></os-svg>\n                <span>{{ configurationSummaryController.getVisibilityConditionTooltipAndMenuLabel() }}…</span>\n              </button>\n            </li>\n            <li>\n              <button class="configuration-reset-default dropdown-item"\n                      ng-click="configurationSummaryController.resetConfiguration()">\n                <os-svg icon="configuration-summary-reset-to-default"></os-svg>\n                <span>{{\'Reset to default\' | i18next}}</span>\n              </button>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    <div class="left-pane-section-container pane-section-scroll-container">\n      <os-parameter-list-view bt-parameters="configurationSummaryController.getConfigurationSelectorBtParameters()"\n                              on-parameter-views-ready="configurationSummaryController.onParameterViewsReady"></os-parameter-list-view>\n    </div>\n  </div>\n</div>\n')}]),e.exports=i},4942:function(e,t,n){var i="/project/web/ts/configurations/configurationTables.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="config-panel-wrapper" ng-controller="ConfigurationTablesController as configurationTablesController">\n  \x3c!-- Configuration tables header: Filters and header menu --\x3e\n  <div class="config-tables-header tables-container-sticky-header"\n    ng-show="configurationTablesController.getIsLoaded()">\n    <div id="configurations-filter"></div>\n    <div class="configurations-type-filters-container">\n      <button class="os-button os-clear document-filter-button"\n        data-automation="list-input-filter-button"\n        ng-class="{\'os-active\': configurationTablesController.configurationsFilterState.getShowOnlyLists()}"\n        ng-click="configurationTablesController.toggleShowLists()"\n        ng-disabled="!configurationTablesController.getIsLoaded()"\n        data-bs-original-title="{{ \'List\' | i18next }}"\n        data-bs-placement="bottom">\n        <os-svg class="os-svg-icon" icon="configuration-list-button"></os-svg>\n      </button>\n      <button class="os-button os-clear document-filter-button"\n        data-automation="checkbox-input-filter-button"\n        ng-class="{\'os-active\': configurationTablesController.configurationsFilterState.getShowOnlyCheckboxes()}"\n        ng-click="configurationTablesController.toggleShowCheckboxes()"\n        ng-disabled="!configurationTablesController.getIsLoaded()"\n        data-bs-original-title="{{ \'Checkbox\' | i18next }}"\n        data-bs-placement="bottom">\n        <os-svg class="os-svg-icon" icon="configuration-checkbox-button"></os-svg>\n      </button>\n      <button class="os-button os-clear document-filter-button"\n        data-automation="variable-input-filter-button"\n        ng-class="{\'os-active\': configurationTablesController.configurationsFilterState.getShowOnlyVariables()}"\n        ng-click="configurationTablesController.toggleShowVariables()"\n        ng-disabled="!configurationTablesController.getIsLoaded()"\n        data-bs-original-title="{{ \'Variable\' | i18next }}"\n        data-bs-placement="bottom">\n        <os-svg class="os-svg-icon" icon="configuration-variable-button"></os-svg>\n      </button>\n  </div>\n    <div class="os-no-shrink config-header-more-button-container">\n      <li class="dropdown os-table-more-button-container">\n        <a data-bs-toggle="dropdown"\n          class="os-table-more-button-control"\n          ng-click="$parent.removeContextMenuStyle(true)">\n          <os-svg icon="overflow"></os-svg>\n        </a>\n        <ul class="dropdown-menu dropdown-menu-end os-table-more-menu">\n          <li ng-if="configurationTablesController.canCopyConfigurationInputs()">\n            <a class="dropdown-item"\n              ng-click="configurationTablesController.copyAllVisibleConfigurationInputs()">\n              {{ configurationTablesController.getCopyFilteredInputsLabel() }}\n            </a>\n          </li>\n          <li ng-if="configurationTablesController.getCanExpandAllConfigs()">\n            <a class="dropdown-item" ng-click="configurationTablesController.expandAllConfigurationTables()">{{ "Expand all inputs" | i18next}}</a>\n          </li>\n          <li ng-if="configurationTablesController.getCanCollapseAllConfigs()">\n            <a class="dropdown-item" ng-click="configurationTablesController.collapseAllConfigurationTables()">{{ "Collapse all inputs" | i18next}}</a>\n          </li>\n          <li ng-if="configurationTablesController.getCanEditVisibilityConditions()">\n            <a class="dropdown-item" ng-click="configurationTablesController.openVisibilityConditionDialog()">{{ "Visibility conditions…" | i18next }}</a>\n          </li>\n          <li ng-if="configurationTablesController.canShowPassThroughDialog()">\n            <a class="dropdown-item" ng-click="configurationTablesController.openPassThroughDialog()">{{ "Show input propagation table" | i18next }}</a>\n          </li>\n        </ul>\n      </li>\n    </div>\n  </div>\n  \x3c!-- Configuration tables --\x3e\n  <div class="config-tables-container-wrapper">\n    <div class="tables-container config-tables-container"\n       os-table-container\n       os-virtual-scroll\n       os-scroll-selected>\n      <div ng-if="configurationTablesController.getIsLoaded()"\n           class="single-table-container single-config-table-container"\n           ng-repeat="configurationTable in configurationTablesController.configurationTables track by configurationTable.parameterId"\n           data-parameter-id="{{ configurationTable.parameterId }}">\n        <div ng-if="configurationTablesController.isTableVisible(configurationTable)" class="draggable-header" data-parameter-id="{{ configurationTable.parameterId }}"\n             ng-class="{\'is-draggable\': configurationTablesController.getCanEditDefinitions()}">\n          <div class="os-no-shrink os-wrap os-justify-between os-table-description">\n            <div class="os-table-header-responsive-first-row"\n                ng-class="{\'os-config-variable-description\': !configurationTable.getHasTable(),\n                            \'is-editing-title\': configurationTable.configurationParameterNameBtParameter.getIsInFocus()}">\n              <div class="compact-table-row-clickable"\n                  ng-click="configurationTable.toggleIsExpanded(null)">\n                <os-svg\n                  class="os-icon-xsmall"\n                  icon="{{configurationTable.isExpanded ? \'expanded\' : \'collapsed\'}}">\n                </os-svg>\n              </div>\n              <div class="table-header-icon" ng-if="configurationTable.getShouldShowHeaderIcon()"\n                  data-bs-original-title="{{ configurationTable.getHeaderIconTooltip() }}">\n                <os-svg icon="{{ configurationTable.getHeaderIcon() }}"></os-svg>\n              </div>\n\n              <div class="editable-title">\n                <span class="os-table-title-sizer os-table-display-name">{{configurationTable.configurationParameterNameBtParameter.getPendingStringValue()}}</span>\n                <div class="title-parameter"\n                    ng-class="{\'configuration-parameter-variable-name\': !configurationTable.getHasTable()}"\n                    os-parameter="configurationTable.configurationParameterNameBtParameter">\n                </div>\n              </div>\n              <div class="configuration-parameter-variable-id-name os-param-not-editing" ng-if="configurationTable.getHasTable()">\n                <span class="default-value-text" data-bs-original-title="{{configurationTable.configurationParameter.getDefaultValueText()}}">\n                  {{configurationTable.configurationParameter.getDefaultValueText()}}\n                </span>\n              </div>\n            </div>\n            <div class="os-table-header-responsive-last-row">\n              <div class="configuration-parameter-variable-id-name os-param-not-editing" ng-if="!configurationTable.getHasTable()">\n                <span class="configuration-parameter-variable-id-text">\n                  (#{{configurationTable.parameterId}})\n                </span>\n                <span class="default-value-text" data-bs-original-title="{{configurationTable.configurationParameter.getDefaultValueText()}}">\n                  {{configurationTable.configurationParameter.getDefaultValueText()}}\n                 </span>\n              </div>\n              <div ng-if="configurationTable.getHasTable()" class="os-configuration-table-button">\n                <button ng-if="configurationTable.getShouldShowConfigureFeaturesButton()"\n                        type="button"\n                        class="btn btn-secondary btn-sm small-secondary-btn os-configure-features-btn ellipseOverflowText"\n                        ng-click="configurationTablesController.configureFeatures(configurationTable)"\n                        ng-disabled="configurationTable.getIsConfiguringFeaturesForThisConfiguration()"\n                        data-bs-original-title="{{ configurationTablesController.getConfigureFeatureModeButtonTooltip() }}"\n                        data-bs-placement="bottom">\n                  <os-svg icon="add-button"></os-svg>{{configurationTablesController.getConfigureFeatureButtonLabel()}}\n                </button>\n              </div>\n              <div class="d-flex">\n                <div ng-if="configurationTable.getCanShowVisibilityConditionIcon()"\n                  class="os-no-shrink d-flex align-items-center show-visibility-condition-icon"\n                  data-bs-original-title="{{ configurationTable.getVisibilityConditionTooltip() }}" data-bs-placement="bottom">\n                  <a ng-click="configurationTable.openVisibilityConditionDialog()">\n                    <os-svg icon="configuration-visibiliity"/>\n                  </a>\n                </div>\n                \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n                <div ng-if="true" class="os-no-shrink">\n                  <li class="dropdown os-table-more-button-container"\n                      ng-show="configurationTable.getCanEditDefinition() || configurationTable.getCanCopyTable()">\n                    <a data-bs-toggle="dropdown"\n                      class="os-table-more-button-control"\n                      ng-click="$parent.removeContextMenuStyle(true)">\n                      <os-svg icon="overflow"></os-svg>\n                    </a>\n\n                    <ul class="dropdown-menu dropdown-menu-end os-table-more-menu">\n                      <li ng-if="configurationTable.getCanCopyTable()">\n                        <a class="dropdown-item" os-clipboard\n                          os-generate-clipboard-text="configurationTable.copyTableDataForClipboard()"\n                          os-clipboard-success="configurationTable.onCopyTableSuccess();"\n                          os-clipboard-error="configurationTable.onCopyTableFailed(e);">{{ "Copy table" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.canCopyConfigurationInputs()">\n                        <a class="dropdown-item"\n                          ng-click="configurationTable.copyConfigurationInput()">\n                          {{ "Copy input" | i18next}}\n                        </a>\n                      </li>\n                      <li ng-if="configurationTablesController.canShowPassThroughDialog()">\n                        <a class="dropdown-item" ng-click="configurationTablesController.openPassThroughDialog(configurationTable.parameterId)">{{ "Show input propagation table" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTablesController.moveConfigurationTableManager.getCanMoveTableUp(configurationTable.parameterId)">\n                        <a class="dropdown-item" ng-click="configurationTablesController.moveConfigurationTableManager.moveTableUp(configurationTable.parameterId)">{{ "Move up" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTablesController.moveConfigurationTableManager.getCanMoveTableDown(configurationTable.parameterId)">\n                        <a class="dropdown-item" ng-click="configurationTablesController.moveConfigurationTableManager.moveTableDown(configurationTable.parameterId)">{{ "Move down" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanRenameTable()">\n                        <a class="dropdown-item" ng-click="configurationTable.renameConfigurationParameter()">{{ "Rename" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getSupportsEditDefinitionDialog() && configurationTable.getCanEditDefinition()">\n                        <a class="dropdown-item" ng-click="configurationTable.editInputDefinition()">{{ "Edit definition…" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanEditFeatureScriptIdentifiers()">\n                        <a class="dropdown-item" ng-click="configurationTable.editFeatureScriptIdentifiers()">{{configurationTable.getEditIndentifiersLabel()}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanSetCosmetic()">\n                        <a class="dropdown-item" ng-click="configurationTable.setIsCosmetic()">{{ "Exclude from properties" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanSetNotCosmetic()">\n                        <a class="dropdown-item" ng-click="configurationTable.setIsNotCosmetic()">{{ "Include in properties" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanEditVisibilityConditions()">\n                        <a class="dropdown-item" ng-click="configurationTable.openVisibilityConditionDialog()">{{ "Visibility conditions…" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanDeleteConfigurationParameter()">\n                        <a class="dropdown-item" ng-click="configurationTable.deleteConfigurationParameter()">{{ "Delete" | i18next}}</a>\n                      </li>\n                    </ul>\n                  </li>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div ng-if="!configurationTablesController.isTableVisible(configurationTable) && configurationTablesController.filteredConfigurationTables.length > 0" class="draggable-header drag-skip" data-parameter-id="{{ configurationTable.parameterId }}"\n          ng-show="!configurationTablesController.shouldHidePlaceholderDiv(configurationTable.parameterId)">\n          <div class="os-no-shrink os-wrap os-justify-between os-table-description" data-bs-original-title="{{ configurationTablesController.getPlaceholderDivTooltip(configurationTable.parameterId) }}">\n            {{ "..." }}\n          </div>\n        </div>\n        <div ng-show="configurationTablesController.isTableVisible(configurationTable) && configurationTable.isExpanded">\n          <osc-sticky-scroll-component ng-if="configurationTable.getHasTable()" view-box=".tables-container">\n            <os-table resizable="true"\n                    bt-table="configurationTable.btTable" class="os-table-wrapper"\n                    context-menu-manager="configurationTable.contextMenuManager"\n                    highlight-manager="configurationTable.highlightManager"\n                    cell-parameter-manager="configurationTable.cellParameterManager"\n                    add-row-manager="configurationTable.addRowManager"\n                    move-row-manager="configurationTable.moveRowManager"\n                    rename-callback="configurationTable.onColumnRenamed"\n                    validate-name-callback="configurationTable.validateNewColumnName">\n            </os-table>\n          </osc-sticky-scroll-component>\n          <div ng-if="!configurationTable.getHasTable() && configurationTable.getHasUsages()" class="os-row os-table-wrapper os-configuration-input-usages">\n            <div class="os-table">\n              <div class="os-colgroup-fluid">\n                <div class="os-thead">\n                  <div class="os-tr">\n                    <div class="os-th table-cell--header">\n                      <div class="column-header-text"><strong>{{ \'Usages\' | i18next}}</strong></div>\n                      <div class="badge rounded-pill">{{configurationTable.getUsageCount()}}</div>\n                    </div>\n                  </div>\n                </div>\n                <div class="os-tbody">\n                  <div class="os-tr" ng-repeat="usage in configurationTable.btTable.getTableColumns()">\n                    <div os-robust-hover-highlight-element\n                         hover-highlight-element="::configurationTable.highlightManager.getRobustHighlightElementForHeader(usage)"\n                         class="os-td os-table-cell-block-content">\n                      <span>{{ usage.parentName }}</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div ng-if="!configurationTable.getHasUsages()" class="configured-status-indicator alert-container">\n            <div class="alert alert-info">\n              <span>\n                <strong>{{configurationTablesController.getNoFeatureConfiguredLabel()}}</strong>\n                <span ng-if="configurationTable.getIsTheOnlyEnumConfigurationParameter()"><br/>{{configurationTablesController.getNoFeatureConfiguredMessage()}}</span>\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class="configured-status-indicator alert-container"\n        ng-if="configurationTablesController.getIsLoaded() && configurationTablesController.filteredConfigurationTables.length === 0 && configurationTablesController.configurationTables.length > 0"\n        ng-class="{\'negative-margin-top\': configurationTablesController.configurationTables.length > 1}">\n          <div class="alert alert-info">\n            <span>\n              <strong>{{"No results found" | i18next}}</strong>\n            </span>\n          </div>\n        </div>\n    </div>\n    <drop-indicator class="drop-indicator"\n                    ng-if="configurationTablesController.m