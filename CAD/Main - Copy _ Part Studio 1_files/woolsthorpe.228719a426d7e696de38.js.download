eLocations[0] = vec3(-1.0, -1.0, 1.41421356237);\n  sampleLocations[1] = vec3(-1.0, 1.0, 1.41421356237);\n  sampleLocations[2] = vec3(1.0, -1.0, 1.41421356237);\n  sampleLocations[3] = vec3(1.0, 1.0, 1.41421356237);\n\n  // Get the highlight index (r channel), id (g, b channels) and count (a channel) from the highlight buffer\n  vec4 centralSample = TEXTURE_2D(uHighlightBuffer, vTextureCoordinate);\n\n  // By default the color will be totally transparent, unless the pixel is near or on a highlight\n  FRAG_COLOR = vec4(uHighlightColor1.rgb, 0.0);\n\n  // Sample within a radius of this pixel to determine if we're near the edge of the highlight\n  float distance = DISTANCE_BEYOND_NEIGHBORHOOD;\n  float centralId =  getSampleId(centralSample);\n  bool centralWhole = isNumberWhole(centralId);\n\n  for (int i = 0; i < TOTAL_SAMPLES; ++i) {\n    vec2 offset = sampleLocations[i].xy / uViewport.zw;\n    vec2 uv = vTextureCoordinate + offset;\n    vec4 textureSample = TEXTURE_2D(uHighlightBuffer, uv);\n    float sampleId =  getSampleId(textureSample);\n    // Put the border on fragments that are on the outside of highlighted regions.  We can find the outsides by\n    // comparing the number of crossings (in the alpha channel).  We also want to put a border around highlights\n    // with different ids - so we will compare the id channels to see if they are different.\n\n    if (!compareWithTolerance(centralId, sampleId, COMPARE_TOLERANCE) &&\n       (centralWhole || isNumberWhole(sampleId) || uOutlineOverlappingInteriorRegions != 0)) {\n      distance = min(distance, sampleLocations[i].z);\n    }\n  }\n\n  // Color the interior of the highlight if it is not set to be hidden.\n  if (centralSample.a > 0.0 && uHideSelectionInterior != 1) {\n    // The mask value will be zero if the highlight is occluded, 1.0 otherwise. If the fragment  is not occluded,\n    // we can color the fragment based on how many highlights are in this fragment.\n    float occlusionMask = TEXTURE_2D(uHighlightMask, vTextureCoordinate).r;\n\n    FRAG_COLOR = vec4(uHighlightColor1.rgb, uHighlightColor1.a * uInteriorHighlightOpacity);\n\n    FRAG_COLOR.a = mix(0.0, FRAG_COLOR.a, occlusionMask);\n  }\n\n  // If this fragment is near the border of the highlight, draw a line\n  if (distance < DISTANCE_BEYOND_NEIGHBORHOOD) {\n    FRAG_COLOR = uHighlightColorBorder;\n  }\n}\n"},87412:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN lowp float vHighlighted;\nFRAG_IN highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    // The value of the fragment should take on the highlight value of the primitive.  The last fragment to pass\n    // the depth test will determine if a highlight was visible, or not.\n    FRAG_COLOR = vec4(vHighlighted, vHighlighted, vHighlighted, 1.0);\n}\n"},1896:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform FRAGMENT_PRECISION_OPTIONAL mat4 uPMatrix_fs;\nFRAG_IN vec3 vPosition;\nFRAG_IN vec3 vNormal;\nFRAG_IN FRAGMENT_PRECISION_OPTIONAL float vDepth;\n\nDECLARE_FRAG_COLOR\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec2 encNormal = encodeNormal(flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs));\n    vec2 encDepth  = encodeDepth(vDepth);\n\n    FRAG_COLOR = vec4(encNormal, encDepth);\n}\n"},51105:function(e,t){"use strict";t.A='{{{compatibility}}}\n\nDECLARE_FRAG_COLOR\n\nuniform mediump vec4 uViewport;\nuniform sampler2D uNormalDepthTexture;\n\n{{{depthNormalFunctions}}}\n\n// Median operations based on: http://graphics.cs.williams.edu/papers/MedianShaderX6/\n// Copyright notice:\n// Copyright (c) Morgan McGuire and Williams College, 2006\n// All rights reserved.\n//\n// Redistribution and use in source and binary forms, with or without\n// modification, are perm