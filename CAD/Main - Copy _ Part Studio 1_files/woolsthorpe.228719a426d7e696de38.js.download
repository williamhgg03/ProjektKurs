span data-bs-original-title="{{$ctrl.getSourceFilterName($ctrl.selectedVersionFilter)}}" data-bs-placement="bottom">{{$ctrl.getSourceFilterName($ctrl.selectedVersionFilter)}}</span>\n                  </div>\n                  <span class="source-filter caret" ng-click="$ctrl.collapseMoreVersionFilter()"></span>\n                </div>\n                <ul ng-if="$ctrl.deDupeVersionFilters.length > 0" class="filter-drop-down dropdown-menu" role="menu"\n                  ng-class="{\'show-more-version-filter\': $ctrl.showingMoreVersionFilters}">\n                  <li ng-if="!$ctrl.showingMoreVersionFilters" ng-repeat="anOption in $ctrl.deDupeVersionFilters"\n                    ng-class="{\'os-selected\': $ctrl.shouldSelectVersion(anOption)}"\n                    class="os-selectable-item where-used-filter" ng-click="$ctrl.changeSourceVersionFilter(anOption)">\n                    <a>\n                      <os-svg icon="{{$ctrl.getFilterTypeIcon(anOption)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                      <span class="ellipseOverflowText" data-bs-original-title="{{$ctrl.getSourceFilterName(anOption)}}">{{$ctrl.getSourceFilterName(anOption)}}</span>\n                    </a>\n                  </li>\n                  <li ng-if="$ctrl.showingMoreVersionFilters" ng-repeat="anOption in $ctrl.versionFiltersInGroup" class="where-used-filter">\n                    <div class="card">\n                      <div class="header">\n                        <span class="os-row">\n                          <os-svg icon="{{$ctrl.getFilterTypeIcon(anOption.items[0])}}" bt-no-focus class="selected-filter-icon"></os-svg>\n                          <span class="ellipseOverflowText" data-bs-original-title="{{$ctrl.getSourceFilterName(anOption.items[0])}}">{{$ctrl.getSourceFilterName(anOption.items[0])}}</span>\n                        </span>\n                      </div>\n                      <div ng-repeat="item in anOption.items" ng-class="{\'os-selected\': item.id === $ctrl.selectedVersionFilter.id && item.partId === $ctrl.selectedVersionFilter.partId}"\n                        class="selectable-item">\n                        <div class="body os-row" ng-click="$ctrl.changeSourceVersionFilter(item)">\n                          <div class="os-col">\n                            <div class="name ellipseOverflowText">{{item.partName}}</div>\n                            <div class="os-item-identifier">\n                              <span class="os-item-identifier-part-number ellipseOverflowText">{{item.partNumber}}</span>\n                            </div>\n                          </div>\n                          <os-thumbnail\n                            class="thumbnail-image-dropdown"\n                            has-thumbnail=\'true\'\n                            document-id="{{$ctrl.sourceItem.documentId}}"\n                            workspace-id=""\n                            version-id="{{item.id}}"\n                            element-id="{{item.elementId}}"\n                            part-id="{{item.partId}}"\n                            ideal-height="170"\n                            ideal-width="300"\n                            document-thumbnail-stamp="{{}}"\n                            fallback-image="{{$ctrl.getFallBackImageForItem(item)}}"\n                            watch-changes="true">\n                          </os-thumbnail>\n                        </div>\n                      </div>\n                    </div>\n                  </li>\n                  <div ng-if="$ctrl.needShowMore()" class="show-more-less" ng-click="$ctrl.stopPropagation($event)">\n                    <span\n                      ng-if="!$ctrl.showingMoreVersionFilters"\n                      ng-click="$ctrl.toggleMoreVersionFilters($event)">\n                      {{\'Show more\' | i18next}}\n                    </span>\n                    <span\n                      ng-if="$ctrl.showingMoreVersionFilters"\n                      ng-click="$ctrl.toggleMoreVersionFilters($event)">\n                      {{\'Show less\' | i18next}}\n                    </span>\n                  </div>\n                </ul>\n              </div>\n              \x3c!-- end non-configured versions dropdown --\x3e\n            </div>\n          </div>\n        </div>\n        <os-svg icon="view-preview" class="expand-collapse-source-preview type-icon view-icon"\n          ng-class="{\'active\': !$ctrl.sourcePreviewCollapsed}"\n          ng-click="$ctrl.toggleSourcePreview()" data-bs-original-title="{{\'Toggle preview\' | i18next}}"></os-svg>\n      </div>\n      \x3c!-- source item preview area --\x3e\n      <div ng-if="!$ctrl.sourcePreviewCollapsed && $ctrl.isQueryingWhereUsed && $ctrl.needReload" class="os-where-used-source-preview os-row" ng-class="{\'config\': $ctrl.shouldShowConfigList()}">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div ng-show="!$ctrl.sourcePreviewCollapsed && (!$ctrl.isQueryingWhereUsed || ($ctrl.isQueryingWhereUsed && !$ctrl.needReload))" class="os-where-used-source-preview os-row" ng-class="{\'config\': $ctrl.shouldShowConfigList()}">\n        <os-thumbnail\n          ng-if="!$ctrl.hasConfig"\n          has-thumbnail=\'{{$ctrl.hasThumbnail()}}\'\n          document-id="{{$ctrl.sourceItem.documentId}}"\n          workspace-id="{{$ctrl.getVersionFilterForThumbnail().versionOrWorkspace === \'w\' ? $ctrl.selectedVersionFilter.id : \'\'}}"\n          version-id="{{$ctrl.getVersionFilterForThumbnail().versionOrWorkspace === \'v\' ? $ctrl.selectedVersionFilter.id : \'\'}}"\n          element-id="{{$ctrl.sourceItem.elementId}}"\n          part-id="{{$ctrl.sourceItem.partId}}"\n          ideal-height="170"\n          ideal-width="300"\n          document-thumbnail-stamp="{{$ctrl.sourceItem.thumbnailStamp ? $ctrl.sourceItem.thumbnailStamp : \'\'}}"\n          fallback-image="{{$ctrl.sourceItemDefaultPreview ? $ctrl.sourceItemDefaultPreview : $ctrl.getFallBackImageForItem($ctrl.sourceItem)}}"\n          watch-changes="true">\n        </os-thumbnail>\n        <where-used-config-list ng-if="$ctrl.shouldShowConfigList()" config-filter="$ctrl.selectedConfigFilter"\n            configuration-name="$ctrl.sourceItem.name" class="config-params ellipseOverflowText os-col"></where-used-config-list>\n        <span class="config-preview" ng-if="$ctrl.hasConfig">\n          <os-thumbnail\n            ng-if="!$ctrl.isDefaultConfigFilter()"\n            has-thumbnail=\'true\'\n            document-id="{{$ctrl.selectedConfigFilter.document.id}}"\n            workspace-id="{{$ctrl.selectedConfigFilter.versionOrWorkspace === \'w\' ? $ctrl.selectedConfigFilter.version.id : \'\'}}"\n            version-id="{{$ctrl.selectedConfigFilter.versionOrWorkspace === \'v\' ? $ctrl.selectedConfigFilter.version.id : \'\'}}"\n            element-id="{{$ctrl.selectedConfigFilter.elementId}}"\n            api-configuration="{{$ctrl.getApiconfigForThumbnail($ctrl.selectedConfigFilter)}}"\n            ideal-height="170"\n            ideal-width="300"\n            document-thumbnail-stamp="{{$ctrl.sourceItem.thumbnailStamp ? $ctrl.sourceItem.thumbnailStamp : \'\'}}"\n            fallback-image="{{$ctrl.sourceItemDefaultPreview ? $ctrl.sourceItemDefaultPreview : $ctrl.getFallBackImage($ctrl.selectedConfigFilter)}}"\n            require-config-match="true"\n            retry-on-error="true"\n            watch-changes="true">\n          </os-thumbnail>\n          <os-thumbnail\n            ng-if="$ctrl.isDefaultConfigFilter()"\n            has-thumbnail=\'true\'\n            document-id="{{$ctrl.sourceItem.documentId}}"\n            workspace-id="{{$ctrl.sourceItemVersionOrWorkspace === \'w\' ? $ctrl.sourceItemVersionWorkspaceId : \'\'}}"\n            version-id="{{$ctrl.sourceItemVersionOrWorkspace === \'v\' ? $ctrl.sourceItemVersionWorkspaceId : \'\'}}"\n            element-id="{{$ctrl.sourceItem.elementId}}"\n            part-id="{{$ctrl.sourceItem.partId}}"\n            ideal-height="170"\n            ideal-width="300"\n            document-thumbnail-stamp="{{$ctrl.sourceItem.thumbnailStamp ? $ctrl.sourceItem.thumbnailStamp : \'\'}}"\n            fallback-image="{{$ctrl.sourceItemDefaultPreview ? $ctrl.sourceItemDefaultPreview : $ctrl.getFallBackImageForItem($ctrl.sourceItem)}}"\n            require-config-match="true"\n            watch-changes="true">\n          </os-thumbnail>\n        </span>\n      </div>\n      \x3c!-- end source item preview area --\x3e\n      \x3c!-- result filter area --\x3e\n      <div class="os-where-used-filter-area os-row"  ng-if="!$ctrl.isRequestingWorkspaceItem">\n        <div class="result-label os-row">\n          <span class="title">{{\'Results:\' | i18next}}</span>\n          <a ng-click="$ctrl.refresh()" data-bs-original-title="{{\'Refresh\' | i18next}}">\n            <os-svg class="refresh" icon="refresh-button"></os-svg>\n          </a>\n        </div>\n        <div class="os-row filter-container">\n          <div class="os-row">\n            <span ng-if="$ctrl.resultVersionFilterOptions.ALL.id !== $ctrl.selectedResultVersionFilter.id">\n              <os-svg icon="{{$ctrl.getFilterTypeIcon($ctrl.selectedResultVersionFilter)}}" bt-no-focus class="selected-filter-icon"></os-svg>\n            </span>\n            <span ng-if="$ctrl.resultVersionFilterOptions.ALL.id === $ctrl.selectedResultVersionFilter.id">\n              <os-svg icon="where-used-all-versions" bt-no-focus class="all-icon-release"></os-svg>\n            </span>\n            <div>\n              <div data-bs-toggle="dropdown" class="dropdown-toggle os-where-used-filter-dropdown">\n                <span>{{$ctrl.selectedResultVersionFilter.name}}</span>\n              </div>\n              <ul class="filter-drop-down dropdown-menu" role="menu">\n                <li ng-repeat="anOption in $ctrl.resultVersionFilterOptions" class="os-selectable-item where-used-filter"\n                  ng-class="{\'os-selected\': anOption.id === $ctrl.selectedResultVersionFilter.id}"\n                  ng-if="$ctrl.resultVersionFilterOptions.ALL.id !== anOption.id" ng-click="$ctrl.changeResultVersionFilter(anOption)">\n                  <a>\n                    <os-svg icon="{{$ctrl.getFilterTypeIcon(anOption)}}" bt-no-focus class="icon-in-dropdown"></os-svg>\n                    <span>{{anOption.name}}</span>\n                  </a>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n      \x3c!-- end result filter area --\x3e\n    </div>\n    <div ng-if="!$ctrl.showEmptyState()" class="os-col os-grow os-where-used-main-content-container" oncontextmenu="return false;">\n      <div class="os-padded-centered-holder where-used-loading os-row"\n        ng-class="{\'show-loading\': $ctrl.isQueryingWhereUsed}" ng-if="!$ctrl.isRequestingWorkspaceItem">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div class="empty-message">\n        <div ng-if="$ctrl.whereUsedTreeNodeList.length === 0 && !$ctrl.isQueryingWhereUsed && $ctrl.errorInRequest === \'\'" class="no-info">\n          <span ng-if="!$ctrl.isWorkspaceFilter($ctrl.selectedVersionFilter)">\n            <span data-bs-original-title="{{$ctrl.sourceItem.name}}" data-expand-delay="0" data-bs-html="true" data-bs-placement="bottom">\n              <os-svg icon="{{$ctrl.getTypeIcon()}}" bt-no-focus class="type-icon"></os-svg>\n            </span>\n          </span>\n          <span ng-bind-html="$ctrl.getEmptyWhereUsedMessage()"></span>\n        </div>\n        \x3c!-- error messgae --\x3e\n        <div ng-if="$ctrl.errorInRequest !== \'\'" class="no-info">\n          <span>{{$ctrl.errorInRequest}}</span>\n        </div>\n        \x3c!-- end error messgae --\x3e\n      </div>\n      <div ng-if="!$ctrl.isNewSource && $ctrl.whereUsedTreeNodeList.length > 0" class="os-col os-grow">\n        \x3c!-- where-used result area --\x3e\n        <div class="os-col os-grow where-used-top-container" ng-click="$ctrl.clearSelection()">\n          <div ng-repeat="whereUsedItem in $ctrl.whereUsedTreeNodeList" class="where-used-list-item-container" ng-class="{\'dim\': $ctrl.isQueryingWhereUsed}">\n            <where-used-list-item source-item="whereUsedItem" item-level="0" container-css="$ctrl.containerCss"\n              result-version-filter="$ctrl.selectedResultVersionFilter" source-version-filter="$ctrl.selectedVersionFilter"\n              show-preview="$ctrl.showPreview" query-instance="$ctrl.sourceItem"></where-used-list-item>\n          </div>\n          \x3c!-- failed capture docs --\x3e\n          <div ng-if="$ctrl.failedCaptureDocs.length > 0" class="failed-capture-docs-container" ng-class="{\'dim\': $ctrl.isQueryingWhereUsed}">\n            <div ng-click="$ctrl.toggleFailedCaptureDocs()" class="node-expander">\n              <os-svg ng-if="$ctrl.failedCaptureDocsOpened" icon="expanded" bt-no-focus class="type-icon"></os-svg>\n              <os-svg ng-if="!$ctrl.failedCaptureDocsOpened" icon="collapsed" bt-no-focus class="type-icon"></os-svg>\n              <os-svg icon="feature-studio-warning" bt-no-focus class="type-icon warning-icon" data-bs-original-title="{{\'The results cannot be displayed due to a problem capturing the document references\' | i18next}}" data-bs-placement="right"></os-svg>\n              <span data-bs-original-title="{{\'The results cannot be displayed due to a problem capturing the document references\' | i18next}}" data-bs-placement="right">{{\'Failed captures\' | i18next}}</span>\n            </div>\n            <div ng-if="$ctrl.failedCaptureDocsOpened" ng-repeat="item in $ctrl.failedCaptureDocs"\n              class="where-used-list-item-container failed-capture-doc" ng-click="$ctrl.openDoc(item)">\n              <os-svg icon="document" bt-no-focus class="type-icon"></os-svg>\n              <span ng-if="!item.omitted" class="name" data-bs-original-title="{{\'Open to investigate\' | i18next}}" data-bs-placement="right">{{item.name}}</span>\n              <span ng-if="item.omitted" data-bs-original-title="{{\'Some results omitted due to lack of permissions\' | i18next}}" data-bs-placement="right">{{\'Not permitted\' | i18next}}</span>\n            </div>\n          </div>\n          \x3c!-- end failed capture docs --\x3e\n        </div>\n        \x3c!-- end where-used result area --\x3e\n      </div>\n    </div>\n    \x3c!-- selected result item preview area --\x3e\n    <div ng-if="!$ctrl.showEmptyState() && $ctrl.canShowResultPreview() && $ctrl.showPreview && !$ctrl.isQueryingWhereUsed && !$ctrl.isNewSource && $ctrl.whereUsedTreeNodeList.length > 0" class="where-used-item-detail">\n      <div class="item-detail-row os-row">\n        <osc-svg-icon icon="document" width="25" height="20"></osc-svg-icon>\n        <span class="item-detail-path doc-name" data-bs-original-title="{{$ctrl.selectedWhereUsedItem.documentName}}" data-bs-placement="bottom">&nbsp;{{$ctrl.selectedWhereUsedItem.documentName}}</span>\n        <span class="item-detail-path separator">&nbsp;> </span>\n        <osc-svg-icon icon="{{$ctrl.getSourceItemIcon()}}" width="25" height="20"></osc-svg-icon>\n        <span class="item-detail-path detail">\n          &nbsp;\n          <a href="#" ng-if="!$ctrl.isSelectedItemInTrash()" ng-mouseup="$ctrl.openWhereUsedItemInNewTab($ctrl.selectedWhereUsedItem)">{{$ctrl.selectedWhereUsedItem.name}}</a>\n          <span ng-if="$ctrl.isSelectedItemInTrash()">{{$ctrl.selectedWhereUsedItem.name}}</span>\n        </span>\n      </div>\n      <div class="os-where-used-result-preview os-row" ng-class="{\'config\': $ctrl.hasConfig}">\n        <where-used-config-list ng-if="$ctrl.isResultItemConfigured($ctrl.selectedWhereUsedItem)" config-filter="$ctrl.selectedWhereUsedItem"\n          configuration-name="$ctrl.selectedWhereUsedItem.name" class="config-params os-col"></where-used-config-list>\n        <os-thumbnail\n          ng-if="!$ctrl.isResultItemConfigured($ctrl.selectedWhereUsedItem)"\n          has-thumbnail=\'true\'\n          document-id="{{$ctrl.selectedWhereUsedItem.documentId}}"\n          workspace-id=""\n          version-id="{{$ctrl.selectedWhereUsedItem.versionId}}"\n          element-id="{{$ctrl.selectedWhereUsedItem.elementId}}"\n          ideal-height="170"\n          ideal-width="300"\n          document-thumbnail-stamp="{{}}"\n          fallback-image="{{$ctrl.getFallBackImage($ctrl.selectedWhereUsedItem)}}"\n          watch-changes="true">\n        </os-thumbnail>\n        <span class="config-preview">\n          <os-thumbnail\n            ng-if="$ctrl.isResultItemConfigured($ctrl.selectedWhereUsedItem)"\n            has-thumbnail=\'true\'\n            document-id="{{$ctrl.selectedWhereUsedItem.documentId}}"\n            workspace-id=""\n            version-id="{{$ctrl.selectedWhereUsedItem.versionId}}"\n            element-id="{{$ctrl.selectedWhereUsedItem.elementId}}"\n            api-configuration="{{$ctrl.getApiconfigForThumbnail($ctrl.selectedWhereUsedItem)}}"\n            ideal-height="40"\n            ideal-width="70"\n            document-thumbnail-stamp="{{}}"\n            fallback-image="{{$ctrl.getFallBackImage($ctrl.selectedWhereUsedItem)}}"\n            require-config-match="true"\n            retry-on-error="true"\n            watch-changes="true">\n          </os-thumbnail>\n        </span>\n      </div>\n    </div>\n    \x3c!-- end selected result item preview area --\x3e\n    \x3c!-- Footer --\x3e\n    <div class="document-panel-footer"\n         ng-class="{ \'document-details-panel-footer\': !$ctrl.getIsDocumentPanel() }"\n         oncontextmenu="return false;">\n      <div class="os-row os-pin-right view-icons">\n        <os-svg class="view-icon footer-icon"\n                ng-if="$ctrl.canShowResultPreviewButton()"\n                icon="view-preview"\n                ng-click="$ctrl.togglePreview()"\n                ng-class="{\'active\': ($ctrl.canShowResultPreview() && $ctrl.showPreview)}"\n                data-bs-original-title="{{(\'Toggle preview\' | i18next)}}"></os-svg>\n        <os-vue-help-link-component v-props="{helpContextKey: \'where_used\'}"></os-vue-help-link-component>\n      </div>\n    </div>\n',controller:WK,bindings:{isDocumentPanel:"<",sourceItemDocumentId:"<",sourceItemVersionOrWorkspace:"<",sourceItemVersionWorkspaceId:"<",sourceItemVersionWorkspaceName:"<",sourceItemElementId:"<",sourceItemElementType:"<",sourceItemPartId:"<",sourceItemPartName:"<",sourceItemPartNumber:"<",sourceItemName:"<",sourceItemType:"<",sourceItemState:"<",sourceItemConfiguration:"<",sourceItemDefaultPreview:"<",sourceItemThumbnailStamp:"<",sourceItemRevision:"<",containerCss:"<",showTitle:"<",rightAlign:"<"}};var HK=n(91716);const jK={template:'\n  <div class="where-used-list-item-row os-grow" oncontextmenu="return false;">\n    <div class="os-grow os-row item-row" ng-class="{\'selected\': $ctrl.sourceItem.selected, \'trashed\': $ctrl.isSourceDocumentInTrash()}"\n      os-context-menu="$ctrl.getContextMenu()" os-context-menu-class="enterprise-context-menu" ng-click="$ctrl.selectWhereUsedItem($event, false)">\n      <div class="node-expander" ng-if="!$ctrl.sourceItem.isTop">\n        <os-svg ng-if="!$ctrl.isOmittedNode && !$ctrl.sourceItem.expanded" class="os-where-used-expand-icon"\n          ng-click="$ctrl.toggleNextLevelWhereUsed($event)" icon="where-used-arrow-collapsed-button" data-bs-original-title="{{\'Show Where used\' | i18next}}"></os-svg>\n        <os-svg ng-if="!$ctrl.isOmittedNode && $ctrl.sourceItem.expanded" class="os-where-used-collapse-icon"\n          ng-click="$ctrl.toggleNextLevelWhereUsed($event)" icon="where-used-arrow-expanded-button" data-bs-original-title="{{\'Collapse Where used\' | i18next}}"></os-svg>\n        <span ng-if="!$ctrl.isOmittedNode" class="type-icon os-row">\n          <div ng-if="!$ctrl.isSourceItemConfiguredAssembly()">\n            <os-svg class="os-search-icon-list-view" icon="{{ $ctrl.getSourceItemIcon() }}"></os-svg>\n          </div>\n          <div ng-if="$ctrl.isSourceItemConfiguredAssembly()" data-bs-original-title="{{$ctrl.sourceItem.name}}"\n            os-tooltip="{{$ctrl.getConfigTooltip()}}" data-expand-delay="0" data-bs-html="true" data-bs-placement="bottom">\n            <os-svg class="os-search-icon-list-view" icon="{{ $ctrl.getSourceItemIcon() }}"></os-svg>\n          </div>\n        </span>\n        <div ng-if="$ctrl.isOmittedNode" class="all-filter-spacer"></div>\n        <span ng-if="$ctrl.isOmittedNode" class="type-icon os-row">\n          <os-svg class="icon-warning os-row" icon="feature-studio-warning"\n            data-bs-original-title="{{\'Some results omitted due to lack of permissions\' | i18next}}" data-bs-placement="right">\n          </os-svg>\n        </span>\n        <span ng-if="$ctrl.isOmittedNode">{{\'Not permitted\' | i18next}}</span>\n        <span ng-if="$ctrl.isFailedCapture">{{$ctrl.sourceItem.name}}</span>\n      </div>\n      <div ng-if="!$ctrl.isOmittedNode && $ctrl.sourceItem.isTop" class="no-toggle os-row">\n        <os-svg class="os-where-used-not-used" icon="where-used-not-used"></os-svg>\n        <os-icon ng-if="!$ctrl.isSourceItemConfiguredAssembly()" class="os-search-icon-list-view os-row" icon="{{ $ctrl.getSourceItemIcon() }}"\n            overlay-icon="{{ $ctrl.getSourceItemOverlayIcon() }}" show-overlay="$ctrl.isPeerOutOfDate()"\n            overlay-tooltip="$ctrl.getSourceItemOverlayTooltip()"></os-icon>\n        <div ng-if="$ctrl.isSourceItemConfiguredAssembly()" data-bs-original-title="{{$ctrl.sourceItem.name}}"\n          os-tooltip="{{$ctrl.getConfigTooltip()}}" data-expand-delay="0" data-bs-html="true" data-bs-placement="bottom">\n          <os-svg class="os-search-icon-list-view" icon="{{ $ctrl.getSourceItemIcon() }}"></os-svg>\n        </div>\n      </div>\n      <div ng-if="!$ctrl.isOmittedNode" class="os-item-identifier os-row os-grow os-search-highlight-name item-name-container ellipseOverflowText">\n        <span class="item-name ellipseOverflowText" data-bs-original-title="{{$ctrl.sourceItem.documentName}} -> {{$ctrl.sourceItem.name}}" data-bs-placement="bottom">{{$ctrl.sourceItem.name}}</span>\n        \x3c!-- cases for released, pending obsolete and rejected --\x3e\n        <span ng-if="$ctrl.shouldShowReleaseStateIcon($ctrl.sourceItem)" class="os-where-used-result-release-icon">\n          <os-svg icon="{{$ctrl.getAReleasedStateIcon($ctrl.sourceItem)}}" bt-no-focus class="all-filter-icon icon-in-item"></os-svg>\n        </span>\n        <span ng-if="$ctrl.canShowRevision()" class="rev-ptor-test rev-number ellipseOverflowText"\n          data-bs-original-title="{{$ctrl.sourceItem.revision}}" data-bs-placement="bottom">({{$ctrl.sourceItem.revision}})</span>\n        <span ng-if="!$ctrl.canShowRevision()" class="rev-ptor-test"></span>\n        <span ng-if="$ctrl.shouldShowReleaseStateIcon($ctrl.sourceItem)" class="item-wvname"></span>\n        \x3c!-- end cases for released, pending obsolete and rejected --\x3e\n        \x3c!-- cases for non-release and non-obsolete --\x3e\n        <span ng-if="!$ctrl.isWhereUsedItemReleased($ctrl.sourceItem) && !$ctrl.isWhereUsedItemObsolete($ctrl.sourceItem) && !$ctrl.isWhereUsedItemPending($ctrl.sourceItem) && $ctrl.isSourceInVersion()">\n          <os-svg icon="version" class="all-filter-icon icon-in-item"></os-svg>\n        </span>\n        <span ng-if="!$ctrl.isWhereUsedItemReleased($ctrl.sourceItem) && !$ctrl.isWhereUsedItemObsolete($ctrl.sourceItem) && !$ctrl.isWhereUsedItemPending($ctrl.sourceItem) && $ctrl.isSourceInVersion()" class="item-wvname ellipseOverflowText"\n          data-bs-original-title="{{$ctrl.getWvNameAndVersionName()}}" data-bs-placement="bottom">{{$ctrl.getWvNameAndVersionName()}}</span>\n        \x3c!-- end cases for non-release and non-obsolete --\x3e\n        \x3c!-- part number and state--\x3e\n        <span class="os-row release-rev">\n          <div ng-if="$ctrl.getPartNu