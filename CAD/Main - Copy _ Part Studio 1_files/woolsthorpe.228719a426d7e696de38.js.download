ionPicker.shouldShowSourceFilters()">\n    <div class="os-dialog-tab document-version-picker-header-tab"\n         ng-repeat="documentSelector in Ctrl.documentVersionPicker.getDocumentSelectors()"\n         ng-if="documentSelector.getCanShowSelector()"\n         ng-class="{\'active-tab\': (viewState.getDocumentSelector() === documentSelector)}"\n         ng-disabled="viewState.getIsReadOnly()"\n         ng-click="Ctrl.documentVersionPicker.changeTabAsUserEdit(documentSelector)">{{documentSelector.getSelectorName()}}</div>\n  </div>\n\n  \x3c!-- Document title row --\x3e\n  <div class="os-dialog-title-row os-no-shrink"\n    ng-if="viewState.shouldShowDocumentTitleRow()">\n    <os-select-item-home-btn view-state="viewState"></os-select-item-home-btn>\n    <button class="os-button os-clear document-version-picker-go-back-from-selected-document"\n            type="button"\n            ng-if="viewState.getDocumentSelector().getCanGoBackFromPickedDocument()"\n            ng-click="viewState.getDocumentSelector().goBackFromPickedDocument()"\n            data-bs-original-title="{{ viewState.getDocumentSelector().getBackButtonTitle() }}"\n            data-bs-placement="left">\n      <os-svg icon="back-tab" class="button-icon"></os-svg>\n    </button>\n    <div class="select-item-dialog-document-name-box os-col os-grow">\n      <span class="select-item-dialog-document-name document-version-picker-current-document ellipseOverflowText"\n            ng-class="{\'no-workspace-name\': viewState.getDocumentSelector().getIsShowingReleasedItems()}">\n        {{viewState.getDocumentDisplayName()}}\n      </span>\n      <span class="select-item-dialog-document-version-name ellipseOverflowText"\n            ng-show="!viewState.getDocumentSelector().getIsShowingReleasedItems() && !!viewState.getDocumentSelector().getWorkspaceOrVersionName()">\n        <img src="/images/version-graph-button.svg" class="select-item-dialog-document-version-image"/>\n        {{viewState.getDocumentSelector()