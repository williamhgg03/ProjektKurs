nt-notice-expand-button">\n        <os-svg\n          class="os-icon-xsmall"\n          icon="collapsed">\n        </os-svg>\n      </span>\n      <os-svg class="compact-table-icon"\n              icon="{{::elementNoticeSet.getIconSrc()}}"\n              alt="{{::elementNoticeSet.getIconAlt()}}"></os-svg>\n      <span class="element-notice-title">{{ elementNoticeSet.getTitle() }}</span>\n      <span ng-if="!elementNoticeSet.hasSubtitleLink()"\n            ng-bind="elementNoticeSet.getSubtitleText()"\n            class="element-notice-subtitle"></span>\n      <a ng-if="elementNoticeSet.hasSubtitleLink()"\n         ng-href="{{ elementNoticeSet.getSubtitleLink() }}"\n         target="_blank"\n         ng-bind="elementNoticeSet.getSubtitleText()"\n         ng-click="$event.stopPropagation()"\n         class="element-notice-subtitle"></a>\n      <os-svg ng-if="elementNoticeSet.hasSubtitleLink()"\n              icon="arrow-up-right"\n              class="element-notice-subtitle-link-icon"></os-svg>\n      <button ng-if="elementNoticeSet.isGlobalWatchResult"\n              ng-click="clearGlobalWatchResult()"\n              class="btn btn-link upload-btn-link clear-global-profile-result">\n        {{ \'Clear latest profile result\' | i18next }}\n      </button>\n    </div>\n\n    <div ng-if="elementNoticeSet.getIsExpanded()"\n         ng-class="{\'notices-out-of-date\' : elementNoticeSet.getIsOutOfDate()}">\n      <table class="compact-table feature-script-notice-table" ng-repeat="notice in getNoticesFromSet(elementNoticeSet)" feature-script-notice></table>\n      <div ng-if="elementNoticeSet.getHasConsoleOutput()"\n           class="part-studio-console-output">{{elementNoticeSet.getConsoleOutput()}}</div>\n      <div ng-if="elementNoticeSet.getHasActivityResults()">\n        <div class="manipulator-log-header-bar">\n          <span>{{ \'Activity log\' | i18next }}</span>\n          <button class="btn btn-link upload-btn-link" ng-click="elementNoticeSet.clearActivityLog()">