luded/suppressed" | i18next}}</a>\n                      </li>\n                      <li><a class="dropdown-item" ng-if="bomController.isIndented()" ng-click="bomController.expandOrCollapseAll(false)">{{ "Collapse all" | i18next}}</a></li>\n                      <li><a class="dropdown-item" ng-if="bomController.isIndented()" ng-click="bomController.expandOrCollapseAll(true)">{{ "Expand all" | i18next}}</a></li>\n                      <li ng-switch="bomController.isShowingTopLevelAssemblyRow()">\n                        <a class="dropdown-item" ng-switch-when="true" ng-click="bomController.showTopLevelAssemblyRow(false)">{{ "Hide top level assembly row" | i18next}}</a>\n                        <a class="dropdown-item" ng-switch-when="false" ng-click="bomController.showTopLevelAssemblyRow(true)">{{ "Show top level assembly row" | i18next}}</a>\n                      </li>\n                      <li><a class="dropdown-item" ng-if="bomController.shouldShowSaveAsTemplate()" ng-click="bomController.saveAsTemplate()">{{ "Save as template…" | i18next }}</a></li>\n                      <li ng-if="bomController.canExport()" class="dropdown-divider"></li>\n                      <li><a class="dropdown-item" ng-if="bomController.canExport()" ng-click="bomController.exportBillOfMaterials()">{{ "Export to CSV" | i18next}}</a></li>\n                    </ul>\n                  </li>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div ng-if="bomController.bomTable" ng-hide="bomController.retrievingBOMData">\n            <div ng-if="!bomController.isTableEmpty() && bomController.isReadOnlyOrInVersion()"\n                 class="billofmaterials-status-indicator alert-container-view-only">\n              <div class="alert alert-info">\n                <span>\n                  <strong>{{"You are viewing this bill of materials" | i18next}}</strong>\n                  <br>\n                  <span ng-if="!bomController.isBomTableReadOnly()