) {\n    // Max region (1.0 - blendDistance, Inf)\n    blendDistance = max(0.0, 1.0 - value);\n    outColor = uMaxColor;\n  }\n\n  if (blendDistance > 0.0) {\n    float blendMaxWidthInverse = uHighlightRegionBlendDistanceInverse * uScalarOutputMagnitude;\n    float blendProgress = min(blendDistance * blendMaxWidthInverse, 1.0);\n\n    // Use `sampleBackgroundColor` here to ensure that we blend from one highlight region to\n    // another if they are adjacent, rather than relying on the potentially incorrect normal color.\n    vec4 backgroundColor = sampleBackgroundColor(value, normalColor);\n    vec4 blendedColor = mix(outColor, backgroundColor, blendProgress);\n    return blendedColor;\n  }\n\n  return outColor;\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    float toBeVisualized = vTextureCoordinate[0];\n\n    // By default we don't visualize. Instead, set the color as we would in the shaded mode.\n    // The toBeVisualized should only be 0.0 (not visualized) or 1.0 (visualized).  However,\n    // there are some precision issues that arise on nvidia drivers in perspective mode (BEL-193801),\n    // hence we make the comparison more tolerant by not directly comparing to those values.\n    if (toBeVisualized < 0.5) {\n      FRAG_COLOR = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n      return;\n    }\n\n    float scalarValue = vTextureCoordinate[1];\n    if (uMakeUnsigned) {\n      scalarValue *= sign(scalarValue);\n    }\n\n    // Here we map the vertex's scalar value (stored in the texture coordinate) to a texture coordinate\n    // value mapped to 0-1.  This mapping is based on the scalar output range, which can be dynamically adjusted\n    // by the user.\n    float normalizedValue = (uScalarOutputMax - scalarValue) * uScalarOutputMagnitudeInverse;\n    vec2 shiftedCoordinate = vec2(0.0, clamp(normalizedValue, 0.0, 1.0));\n\n    vec4 color = u