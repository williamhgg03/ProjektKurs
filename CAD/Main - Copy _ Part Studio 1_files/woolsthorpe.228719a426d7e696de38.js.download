ons="stepUnit.unitName for stepUnit in stepUnitChoices"> </select>\n      </div>\n      <div class="form-check" ng-show="allowMBDExport()">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="include-derived-tolerances-export-checkbox" class="form-check-input" type="checkbox" ng-model="options.includeDerivedTolerances">{{ "Include derived tolerances in export" | i18next }}</label>\n      </div>\n      <div class="form-check" ng-show="allowMBDExport()">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="custom-mbd-annotation-font-height-checkbox" class="form-check-input" type="checkbox" ng-model="options.useCustomAnnotationsFontHeightForStepExport"\n          ng-change="onUseCustomAnnotationsFontHeightForStepExportChanged()">{{ "Use custom annotation text height for MBD export" | i18next }}</label>\n      </div>\n      <div class="form-group" ng-show="showAnnotationsFontHeightExportOption()">\n        <label class="control-label">{{ getAnnotationsFontHeightLabelText() }}</label>\n        <input class="form-control" type="number" name="annotationsFontHeight"  ng-model="options.annotationsFontHeightInWorkspaceUnits"\n          min="0.0001" max="50" step="any" placeholder="min 0.0001, max 50"></input>\n        <span class="text-danger export-annotationsFontHeight-error" ng-show="exportForm.annotationsFontHeight.$invalid">{{ "Valid annotations text height in range from 0.0001 to 50 is required." | i18next }}</span>\n      </div>\n      <div class="form-group" ng-show="options.format.name === \'STL\'" ng-include="\'/project/web/woolsthorpe/app/partials/exportPartsStl.html\'"></div>\n      <div class="form-group" ng-show="hasTessellationResolution()" ng-include="\'/project/web/woolsthorpe/app/partials/exportPartsWithResolution.html\'"></div>\n      <div class="form-group form-check" ng-show="options.format.name === \'IGES\'">\n        <label class="checkbox os-export-checkbox-label for