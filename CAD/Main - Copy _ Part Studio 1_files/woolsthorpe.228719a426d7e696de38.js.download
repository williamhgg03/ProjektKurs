ass="select-item-dialog-thumbnail-container os-col os-no-shrink">\n                <img ng-src="{{updateItemViewModel.getDisplayThumbnailUri(activeTab)}}" img-fallback-src="{{updateItemViewModel.getDefaultThumbnailUri()}}">\n              </span>\n              <div class="select-item-dialog-document-name-box os-col os-grow">\n                <span class="select-item-dialog-document-name">{{updateItemViewModel.getItemHeaderLabel()}}</span>\n                <span class="select-item-dialog-document-version-name os-row">\n                  <span class="current-version ellipseOverflowText" ng-if="canShowItemFromLabel(activeTab, updateItemViewModel)">{{getItemFromLabel(activeTab, updateItemViewModel)}}</span>\n                  <span class="version-arrow" ng-if="canShowFromToArrow(activeTab, updateItemViewModel)">&#x21e8;</span>\n                  <span class="newest-version ellipseOverflowText" ng-if="canShowItemToLabel(activeTab, updateItemViewModel)" style="max-width: {{custommizeMaxVersionLength(activeTab, updateItemViewModel)}}%;">{{getItemToLabel(activeTab, updateItemViewModel)}}</span>\n                </span>\n              </div>\n              <div class="out-of-date-icon" data-bs-placement="right" data-bs-original-title="{{updateItemViewModel.getOutOfDateIconTooltip(activeTab)}}">\n                <os-svg icon="{{updateItemViewModel.getOutOfDateIcon(activeTab)}}"></os-svg>\n              </div>\n              <div ng-if="activeTab === SELECTIVE_UPDATE && updateItemViewModel.hasRevisions() && !revisionHistoryVisible" class="btn-group os-split-btn os-no-shrink external-reference-update-version-graph-button">\n                <button class="btn btn-secondary os-btn" ng-if="!updateItemViewModel.isTrackingRevisions()"\n                ng-click="showVersionGraph(updateItemViewModel)" data-bs-original-title="{{\'Version graph\' | i18next}}" data-bs-placement="right">\n                  <div class="button-content d-flex">\n                    <os-svg icon="version-gra