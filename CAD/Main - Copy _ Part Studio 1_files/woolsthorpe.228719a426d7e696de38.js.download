ase-button" alt=""></os-svg>\n      </button>\n      <button class="os-button os-clear"\n              type="button"\n              data-bs-original-title="{{\'tooltips:::Release…\' | i18next}}"\n              data-bs-placement="bottom"\n              ng-if="canAccessFeatureCallouts()"\n              ng-click="openFeatureCalloutDialog()">\n        <div class="feature-callouts-icon-container">\n          <os-svg icon="released" class="main-icon">\n          </os-svg><os-svg icon="lock-badge" class="lock-icon"></os-svg>\n        </div>\n      </button>\n      <button class="os-button os-clear"\n              type="button"\n              data-bs-original-title="{{\'tooltips:::Create version…\' | i18next}}"\n              data-bs-placement="bottom"\n              ng-if="canCreateVersionInWorkspace() && !isInCompareSetupMode && !isInCompareMode"\n              ng-click="saveVersion()">\n        <os-svg icon="create-version-button" alt=""></os-svg>\n      </button>\n      <button class="os-button os-clear"\n              type="button"\n              data-bs-original-title="{{\'tooltips:::Compare history entries\' | i18next}}"\n              data-bs-placement="bottom"\n              ng-class="{\'os-active\': isInCompareSetupMode}"\n              ng-click="toggleCompareMode()"\n              ng-if="canShowCompareButton()"\n              ng-disabled="isLoadingElementState">\n        <os-svg icon="compare-versions-button" alt=""></os-svg>\n      </button>\n      <button class="os-button os-clear"\n              type="button"\n              data-bs-original-title="{{\'tooltips:::Repair\' | i18next}}"\n              data-bs-placement="bottom"\n              ng-class="{\'os-active\': isInRepairSetupMode}"\n              ng-click="toggleRepairMode()"\n              ng-if="canShowRepairButton()"\n              ng-disabled="isLoadingElementState">\n        <os-svg icon="repair" alt=""></os-svg>\n      </button>\n      <os-svg class="document-panel-close" icon="close-x" ng-click="cl