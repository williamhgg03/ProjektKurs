ill result in failed or missing features in __count__ tab" | i18next:{count: dependents.length} }}\n             </label>\n          </div>\n        <div class="confirm-tabs-deletion-details">\n          <div ng-repeat="dependent in dependents" class="ellipseOverflowText">\n            <span class="os-list-item-name-icon">\n              <span class="os-feature-type-icon">\n                <osc-svg-icon\n                  icon="{{getElementIcon(dependent.id)}}"\n                  height="15"\n                  width="15"\n                  ng-if="!getElementIcon(dependent.id).includes(\'http\')"\n                  class="os-svg-icon">\n                </osc-svg-icon>\n                <img ng-if="getElementIcon(dependent.id).includes(\'http\')" class="element-icon" ng-src="{{getElementIcon(dependency.id)}}">\n              </span>\n              <span class="os-list-item-name">{{dependent.name}}</span>\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class="modal-footer">\n      <button id="confirm-tabs-deletion-dialog-ok" class="btn btn-primary" os-enter="ok()" type="submit">\n        <span >{{ "Delete" | i18next}}</span>\n      </button>\n      <button class="btn btn-secondary button-cancel" type="button" ng-click="cancel()">{{ "Cancel" | i18next}}\n      </button>\n    </div>\n  </form>\n</div>\n')}]),e.exports=i},46688:function(e,t,n){var i="/project/web/woolsthorpe/app/partials/customFeaturesMenu.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div\n  ng-if="getShouldShowWaitingMessage() || getShouldShowTableAddButton()" class="toolbar-icon">\n</div>\n\n\x3c!--If we\'re in a version waiting for feature studio analysis, show a spinner and a message.--\x3e\n\n<div ng-if="getShouldShowWaitingMessage()"\n     class="waiting-for-analysis-message">\n  <div class="os-spinner-small os-spinner-spinning"></div>\n  <span>\n    {{ \'Loading custom features and tables…\' | i18next }}\n  </span>\n</div>\n\n\x3c!