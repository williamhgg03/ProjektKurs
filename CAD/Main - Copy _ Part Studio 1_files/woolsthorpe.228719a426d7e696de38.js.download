ct/web/ts/customProperties/inner-node.html\'"\n              label-with="$ctrl.catTreeLabelWith"\n              rebuild-event="rebuildCategoryTree"\n            ></category-tree>\n          </div>\n        </os-layout>\n        <os-layout os-min-size="600" os-size="false">\n          <div class="os-col os-grow category-properties-column">\n            <h4 class="section-header second-column">{{ "Properties" | i18next }}</h4>\n            <property-picker\n              ng-if="$ctrl.canEdit"\n              local-properties="$ctrl.allProperties"\n              os-multiple="false"\n              ng-model="$ctrl.nextProperty"\n              ng-change="$ctrl.onNextProperty()"\n              prop-filter="$ctrl.isPropertyPickable"\n              reset-index="true"\n              placeholder="$ctrl.propPickerPlaceholder"\n              ng-disabled="$ctrl.readOnly"\n            ></property-picker>\n            <category-properties\n              category-id="$ctrl.detailCategory.getId()"\n              category-name="$ctrl.detailCategory.name"\n              read-only="$ctrl.readOnly"\n              inherited-props="$ctrl.inheritedProps"\n              own-props="$ctrl.ownProps"\n              source-provider="$ctrl.getPropertySource(prop)"\n            ></category-properties>\n          </div>\n        </os-layout>\n      </os-layout>\n    </div>\n\n    <div class="properties-details-action-container">\n      <button\n        ng-if="!$ctrl.readOnly"\n        class="btn btn-primary"\n        type="button"\n        ng-disabled="$ctrl.isFormDisabled()"\n        ng-click="$ctrl.onSaveClick()">\n        <span ng-if="$ctrl.isNew"> {{ \'Create\' | i18next }} </span>\n        <span ng-if="!$ctrl.isNew"> {{ \'Save changes\' | i18next }} </span>\n      </button>\n      <button\n        class="btn btn-secondary button-cancel add-space-left"\n        type="button"\n        ng-click="$ctrl.onCancel()">\n          {{ \'Cancel\' | i18next }}\n      </button>\n    </div>\n  </div>\n</form>