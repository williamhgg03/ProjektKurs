ntent" | i18next}}</h4>\n    <h4 ng-if="isAdministrationMode" class="modal-title">{{"Standard Content Administration" | i18next}}</h4>\n    <button type="button" class="btn-close" ng-click="cancel()" aria-hidden="true"></button>\n  </div>\n  <div class="modal-body">\n    <label>{{"Standard:" | i18next}}</label>\n    <div ng-show="!isAdministrationMode && (newStandard || isMarked)">\n      <label class="form-control col-right">{{selectionData.selectedStandard}}</label>\n    </div>\n    <div ng-show="isAdministrationMode || (!newStandard && !isMarked)">\n      <select class="form-control" ng-model="selectionData.selectedStandard" ng-options="theStandard for theStandard in standards" ng-change="onStandardChange()"></select>\n    </div>\n    <div class="float-end">\n      <button ng-if="!isAdministrationMode" class="btn btn-primary" ng-show="!isMarked" ng-disabled="isMarked" ng-click="createNewStandard()">{{"Create" | i18next}}</button>\n      <button ng-if="isFullAdministrationMode" class="btn btn-primary" ng-disabled="standards.length === 0" ng-click="renameStandard()">{{"Rename" | i18next}}</button>\n      <button ng-if="isFullAdministrationMode" class="btn btn-primary" ng-disabled="standards.length === 0" ng-click="deleteStandard()">{{"Delete" | i18next}}</button>\n    </div>\n    <br>\n    <label>{{"Category:" | i18next}}</label>\n    <div ng-show="!isAdministrationMode && (newCategory || isMarked)">\n      <label class="form-control col-right">{{selectionData.selectedCategory}}</label>\n    </div>\n    <div ng-show="isAdministrationMode || (!newCategory && !isMarked)">\n      <select class="form-control" ng-disabled="isContentLoading || categories.length === 0" ng-model="selectionData.selectedCategory" ng-options="theCategory for theCategory in categories" ng-change="onCategoryChange()"></select>\n    </div>\n    <div class="float-end">\n      <button ng-if="!isAdministrationMode" class="btn btn-primary" ng-show="!isMarked" ng-disabled="isMarked" ng-click="createNewCategory()">{{"Create" | i18next}}</button>\n      <button ng-if="isFullAdministrationMode" class="btn btn-primary" ng-disabled="categories.length === 0" ng-click="renameCategory()">{{"Rename" | i18next}}</button>\n      <button ng-if="isFullAdministrationMode" class="btn btn-primary" ng-disabled="categories.length === 0" ng-click="deleteCategory()">{{"Delete" | i18next}}</button>\n    </div>\n    <br>\n    <label>{{"Class:" | i18next}}</label>\n    <div ng-show="!isAdministrationMode && (newTypes || isMarked)">\n      <label class="form-control col-right">{{selectionData.selectedTypes}}</label>\n    </div>\n    <div ng-show="isAdministrationMode || (!newTypes && !isMarked)">\n      <select class="form-control" ng-disabled="isContentLoading || types.length === 0" ng-model="selectionData.selectedTypes" ng-options="theTypes for theTypes in types" ng-change="onTypesChange()"></select>\n    </div>\n    <div class="float-end">\n      <button ng-if="!isAdministrationMode" class="btn btn-primary" ng-show="!isMarked" ng-disabled="isMarked" ng-click="createNewTypes()">{{"Create" | i18next}}</button>\n      <button ng-if="isFullAdministrationMode" class="btn btn-primary" ng-disabled="types.length === 0" ng-click="renameTypes()">{{"Rename" | i18next}}</button>\n      <button ng-if="isFullAdministrationMode" class="btn btn-primary" ng-disabled="types.length === 0" ng-click="deleteTypes()">{{"Delete" | i18next}}</button>\n    </div>\n    <br>\n    <label>{{"Component:" | i18next}}</label>\n    <div ng-if="isFullAdministrationMode">\n      <select class="form-control" ng-disabled="isContentLoading || type.length === 0" ng-model="selectionData.selectedType" ng-options="theType for theType in type" ng-change="onTypeChange()"></select>\n      <div class="float-end">\n        <button class="btn btn-primary" ng-disabled="type.length === 0" ng-click="renameType()">{{"Rename" | i18next}}</button>\n        <button class="btn btn-primary" ng-disabled="type.length === 0" ng-click="deleteType()">{{"Delete" | i18next}}</button>\n      </div>\n      <br>\n      <br>\n    </div>\n    <div ng-if="!isAdministrationMode">\n      <div ng-show="isMarked">\n        <label class="form-control col-right">{{selectionData.selectedType}}</label>\n        <br>\n        <span>{{"This component has already been added as standard content, no changes allowed." | i18next}}</span>\n      </div>\n      <div ng-show="!isMarked">\n        <input class="form-control col-right" ng-model="selectionData.selectedType" type="text"/>\n      </div>\n    </div>\n     <div ng-if="isAdministrationMode || !isMarked">\n      <br/>\n       <div class="standard-content-admin-component-container">\n        <div class="standard-content-admin-component-left-column">\n         <div>\n           <span>{{"Component document Id:" | i18next}}</span>\n         </div>\n         <div>\n           <span>{{"Component document Name:" | i18next}}</span>\n         </div>\n         <div class="standard-content-admin-component-production-label">\n           <span>{{"Production version:" | i18next}}</span>\n         </div>\n         <div class="standard-content-admin-component-test-label">\n           <span>{{"Test version:" | i18next}}</span>\n         </div>\n        </div>\n        <div class="standard-content-admin-component-middle-column">\n         <div>\n          <a ng-if="isAdministrationMode" href="#" ng-click="goToComponentDocument()">{{selectionData.componentDocumentId}}</a>\n          <span ng-if="!isAdministrationMode">{{selectionData.componentDocumentId}}</span>\n         </div>\n         <div>\n          <span>{{selectionData.componentDocumentName}}</span>\n         </div>\n         <div class="standard-content-admin-component-select-container">\n           <select class="form-control" ng-disabled="isContentLoading || !selectionData.componentDocumentId" ng-model="versionData.newProductionVersionId" ng-options="version.versionId as version.versionName for version in versionData.availableVersions"></select>\n         </div>\n         <div class="standard-content-admin-component-select-container">\n           <select class="form-control" ng-disabled="isContentLoading || !selectionData.componentDocumentId" ng-model="versionData.newTestVersionId" ng-options="version.versionId as version.versionName for version in versionData.availableVersions"></select>\n         </div>\n        </div>\n        <div ng-if="isFullAdministrationMode" class="standard-content-admin-component-right-column">\n          <br/>\n          <br/>\n          <br/>\n          <div class="standard-content-admin-component-update-container">\n            <button class="btn btn-primary standard-content-admin-component-update-button" ng-disabled="isContentLoading || !selectionData.componentDocumentId || (versionData.productionVersionId === versionData.newProductionVersionId && versionData.testVersionId === versionData.newTestVersionId)" ng-click="updateVersions()">{{"Update" | i18next}}</button>\n          </div>\n        </div>\n        <br class="standard-content-admin-component-container-end"/>\n      </div>\n    </div>\n  </div>\n  <div class="modal-footer">\n    <button ng-if="!isAdministrationMode" class="btn btn-primary" ng-show="!isMarked" ng-click="reset()">{{"Reset" | i18next}}</button>\n    <button ng-if="!isAdministrationMode" class="btn btn-primary" ng-show="!isMarked" ng-click="mark()" ng-disabled="!canMark()">{{"Mark" | i18next}}</button>\n    <button class="btn btn-primary button-cancel" ng-click="cancel()">{{"__closeOrCancelText__" | i18next:{closeOrCancelText: isMarked || isAdministrationMode ? \'Close\' : \'Cancel\'} }}</button>\n  </div>\n</div>\n')}]),e.exports=i},35062:function(e,t,n){var i="/project/web/ts/debugPane/ng/debugPane.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="debug-pane-container">\n  <div class="document-panel-header">\n    <div class="document-panel-header-title">Debug</div>\n    <div class="os-row os-pin-right os-