 <ul ng-if="!NavbarController.isPublication()" uib-dropdown-menu class="dropdown-menu document-dropdown-menu" role="menu" ng-include="\'/project/web/woolsthorpe/app/partials/documentMenu.html\'"></ul>\n          <ul ng-if="NavbarController.isPublication()" uib-dropdown-menu class="dropdown-menu document-dropdown-menu" role="menu" ng-include="\'/project/web/woolsthorpe/app/partials/publicationMenu.html\'"></ul>\n        </div>\n      </div>\n\n      \x3c!-- NAVBAR: SEARCH BOX --\x3e\n      <div class="os-searchbox-container os-grow" ng-if="NavbarController.visibilityControls.searchBox">\n        <os-document-search></os-document-search>\n      </div>\n      <div class="os-searchbox-container os-grow" ng-if="NavbarController.visibilityControls.changeSearchBox">\n        <change-search></change-search>\n      </div>\n\n      \x3c!-- NAVBAR: CENTER REGION --\x3e\n      <div ng-if="NavbarController.visibilityControls.modelName" class="navbar-document-and-workspace-names os-row os-grow os-align-center" ng-class="{\'connection-document-center-region\' : openDocument && NavbarController.visibilityControls.connectionDocument}">\n\n        \x3c!-- Document and workspace/version name --\x3e\n        <div class="navbar-block-wrapper">\n          <div class="document-name-container os-row os-align-baseline" ng-class="{\'can-rename\': NavbarController.canOpenRenameDialog(), \'dialog-open\': NavbarController.isDialogOpen()}">\n            <div class="navbar-document-name"\n                  ng-style="{\'width\': documentNameWidth}"\n                  ng-mousedown="NavbarController.onDocumentNameMouseDown($event)"\n                  ng-click="NavbarController.renameDocument($event)"\n                  data-bs-original-title="{{openDocument.name}}"\n                  data-bs-placement="bottom">\n              <div class="navbar-document-name-overlay-wrapper">\n                <div class="navbar-document-name-overlay"></div>\n              </div>\n              {{openDocument.name}}\