ions"\n        [disabled-node-ids]="copyDisabledNodeIds"\n        [non-selectable-node-ids]="copyNonSelectableNodeIds"\n        (selected-node-change)="setSelectedCopyTargetNode($event.targetNode, $event.targetNodePathToRoot, $event.confirmedSelectedRootNodeId, $event.currentContainer)"\n        (tree-nodes-loaded)="onCopyTreeNodesLoaded($event)"\n        [starting-container-node]="startingContainerNodeCopy"\n        [should-watch-starting-container-node]="true"\n        [selected-root-node-id]="null"\n        [selected-nodes]="null"\n        [enable-sorting]="true"\n        [enable-create-new-folder]="isNewFolderCreationEnabled">\n      </osx-browse>\n\n      <div class="os-modal-control"\n           ng-if="!isCopying && !(isPublication && !createNewPublicationOnly)">\n        <label ng-if="!isPublication" class="control-label">{{ "Document location" | i18next}}</label>\n        <label ng-if="isPublication" class="control-label">{{ "Publication location" | i18next}}</label>\n        <div class="alert alert-warning connected-company-warning" ng-if="isConnectedCompanyNode">\n          <os-svg icon="performance-warning"></os-svg>\n          <span ng-if="isPublication">{{ "You cannot create publications within a connected enterprise." | i18next }}</span>\n          <span ng-if="!isPublication">{{ "You cannot create documents within a connected enterprise." | i18next }}</span>\n        </div>\n        <osx-browse\n          [browse-options]="createDocumentBrowseOptions"\n          [disabled-node-ids]="createDisabledNodeIds"\n          [non-selectable-node-ids]="createNonSelectableNodeIds"\n          (selected-node-change)="setSelectedTargetNode($event.targetNode, $event.targetNodePathToRoot, $event.confirmedSelectedRootNodeId, $event.currentContainer)"\n          (tree-nodes-loaded)="onCreateTreeNodesLoaded($event)"\n          [starting-container-node]="startingContainerNode"\n          [should-watch-starting-container-node]="true"\n          [selected-root-node-id]="nu