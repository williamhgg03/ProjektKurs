ht: true, appendTo: \'.modal-footer\', adjustLeft: 2, adjustTop: -6}">\n                <li class="dropdown-item" ng-repeat="action in ctrl.workflowableTask.actionsByUiHint[hint]">\n                  <button class="btn os-button os-clear hint-{{::hint}}"\n                          type="button"\n                          ng-disabled="ctrl.isSpinnerRunning() || ctrl.shouldDisableWorkflowAction(action, taskForm) || !(action.allowIfApprovers && ctrl.workflowableTask.hasApprovers() || action.allowIfNoApprovers && !ctrl.workflowableTask.hasApprovers())"\n                          ng-click="ctrl.exec(action)"\n                          data-original-tooltip="{{::action.tooltip}}">{{::action.label}}</button>\n                </li>\n              </ul>\n            </div>\n          </div>\n          <button class="btn btn-secondary button-cancel"\n                  ng-click="ctrl.close()">{{ \'Cancel\' | i18next }}</button>\n        </div>\n      </div>\n    </div>\n  </form>\n  <div ng-if="ctrl.spinner.show"\n       class="modal-body task-spinner">\n    <os-spinner spinner="ctrl.spinner"></os-spinner>\n  </div>\n</div>')}]),e.exports=i},66298:function(e,t,n){var i="/project/web/ts/tasks/task-pane.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="os-col task-pane-container">\n  <task-pane-component></task-pane-component>\n</div>')}]),e.exports=i},74036:function(e,t,n){var i="/project/web/ts/tasks/workflowable-task/workflowableTaskItem-body.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="os-row generic-task-details" ng-if="!$ctrl.isInsidePanel">\n  <div class="os-col col-one">\n    <div ng-if="$ctrl.task.description">\n      <span class="task-details-label">{{\'Description:\' | i18next}}</span>\n      <div class="description" ng-bind-html="$ctrl.task.description | osSanitize | prettyUrl | trustAsHtml"></div>\n    </div>\n  </div>\n  <div class="col-two">\n    <div class="os-row">\n      <div class="col-one"