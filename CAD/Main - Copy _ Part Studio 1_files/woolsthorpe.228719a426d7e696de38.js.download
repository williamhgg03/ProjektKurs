ck">{{"Cannot compare a rolled back feature. Roll this feature forward in your Part Studio and try again." | i18next}}</div>\n        </div>\n        <div ng-if="numberOfFeaturesSelected <= 1 && selectedFeatureForParameters.canBeCompared()" class="parameter-compare-container">\n          <div class="os-parameter-compare-column">\n\n            <div class="os-parameter-compare-header" ng-if="showParameterDialog(true)">\n              <span>{{getFeatureName(true)}}</span>\n            </div>\n            <div class="os-parameter-compare-body" ng-if="showParameterDialog(true)">\n              <feature-parameter-comparison-field class="os-compare-base"\n                                                  ng-repeat="comparison in selectedFeatureForParameters.parameterComparisons"\n                                                  parameter-comparison="comparison" is-base="true"\n                                                  ng-class="{\'os-feature-parameter-highlight\': comparison.hasHoverHighlight}">\n              </feature-parameter-comparison-field>\n            </div>\n\n            <div class="os-parameter-compare-noexist" ng-if="selectedFeatureForParameters && !showParameterDialog(true)">{{"Feature does not exist in base." | i18next}}</div>\n          </div>\n          <div class="os-parameter-compare-column">\n            <div class="os-parameter-compare-header" ng-if="showParameterDialog(false)">\n              <span>{{getFeatureName(false)}}</span>\n            </div>\n            <div class="os-parameter-compare-body" ng-if="showParameterDialog(false)">\n              <feature-parameter-comparison-field class="os-compare-target"\n                                                  ng-repeat="comparison in selectedFeatureForParameters.parameterComparisons"\n                                                  parameter-comparison="comparison" is-target="true"\n                                                  ng-class="{\'os-feature-parameter-highlight\': comparis