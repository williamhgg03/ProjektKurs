 Existing EnumValues --\x3e\n      <div class="clearfix" ng-if="$ctrl.restricted">\n        <div class="custom-properties-form-group col-md-4"\n          ng-if="$ctrl.property.valueType === 5 && !$ctrl.isInitialPublishStatePending()">\n          <label for="enumExistingValuesId" class="control-label">\n            {{ \'Existing list values\' | i18next }}\n            <span class="control-label control-info os-user-preference-info os-question-mark os-svg-icon"\n                  popover-trigger="\'mouseenter\'"\n                  popover-append-to-body="true"\n                  uib-popover-html="$ctrl.getEnumExistingValuesPopoverHTML()"\n                  popover-placement="right"\n                  ng-if="!$ctrl.restricted">\n            </span>\n          </label>\n          <input ngclipboard\n                 ngclipboard-success="$ctrl.onEnumCopy()"\n                 id="old-copy-enums-button"\n                 data-clipboard-text="{{$ctrl.enumValuesForCopy}}"\n                 class="btn btn-primary form-control-spacer ng-isolate-scope clipboard-button"\n                 type="button"\n                 value="{{\'Copy to clipboard\' | i18next}}"\n                 ng-disabled="$ctrl.readOnly"\n          />\n          <div id="enumExistingValuesId"\n            class="form-control enum-value-display"\n            disabled="disabled">\n            <p ng-repeat="enumItem in $ctrl.propertyConfig.enumValues">\n              {{ enumItem.label ? enumItem.label : enumItem.value }}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      \x3c!-- New EnumValues --\x3e\n      <div class="clearfix">\n        <div class="custom-properties-form-group col-lg-10" ng-if="$ctrl.property.valueType === 5 && !$ctrl.restricted">\n          <div class="label-container">\n             <label for="enumValuesId" class="control-label">\n              {{ $ctrl.getListValuesLabel() }}\n              <span class="control-label control-info os-user-preference-info os-question