and re-encodes the median in the\n * returned value.\n */\nvec4 median() {\n  vec3 n[9];  // normals\n  float d[9]; // depths\n\n  for(int dX = -1; dX <= 1; ++dX) {\n    for(int dY = -1; dY <= 1; ++dY) {\n      vec2 offset = vec2(float(dX), float(dY));\n      vec2 uv = (gl_FragCoord.xy + offset - uViewport.xy) / uViewport.zw;\n      vec4 textureSample = TEXTURE_2D(uNormalDepthTexture, uv);\n      n[(dX + 1) * 3 + (dY + 1)] = decodeNormal(textureSample.xy);\n      d[(dX + 1) * 3 + (dY + 1)] = decodeDepth(textureSample.zw);\n    }\n  }\n\n  vec3 tempN;\n  float tempD;\n\n  mnmx6(0, 1, 2, 3, 4, 5);\n  mnmx5(1, 2, 3, 4, 6);\n  mnmx4(2, 3, 4, 7);\n  mnmx3(3, 4, 8);\n\n  vec4 result;\n  result.xy = encodeNormal(n[4]);\n  result.zw = encodeDepth(d[4]);\n\n  return result;\n}\n\nvoid main(void) {\n  FRAG_COLOR = median();\n}\n'},33212:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\n\n{{{normalDepthWithMaskFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    discardIfDepthMatchesMask();\n\n    FRAG_COLOR = encodeDepthWithZeroNormalColor();\n}\n"},22976:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nuniform mat4 uPMatrix_fs;\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN FRAGMENT_PRECISION vec3 vNormal;\n\n{{{normalDepthWithMaskFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n    discardIfNormalDepthMatchesMask(facingNormal);\n\n    FRAG_COLOR = encodeNormalDepthColor(facingNormal);\n}\n"},98049:function(e,t){"use strict";t.A="{{{compatibility}}}\n\n{{{normalDepthWithMaskFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    discardIfDepthMatchesMask();\n\n    FRAG_COLOR = encod