iv class="flyout-toggle-button" ng-class="{\'os-expanded\': NavbarController.getIsNoticePaneOpen()}">\n              <div class="notices-toggle-content" ng-controller="ErrorFlyoutToggleController">\n                <os-svg icon="{{getErrorButtonIcon()}}"></os-svg>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \x3c!-- FeatureScript search --\x3e\n        <div ng-show="NavbarController.visibilityControls.crossElementSearchButton"\n            class="dropdown"\n            data-bs-original-title="{{\'tooltips:::Search Feature Studios (Ctrl-Shift-f / ⌘-Shift+f)\' | i18next}}"\n            data-bs-placement="bottom">\n          <div class="btn nav-item nav-notifications feature-script-search-toggle-button"\n               ng-click="NavbarController.toggleFeatureScriptSearch()">\n            <div class="flyout-toggle-button" ng-class="{\'os-expanded\': NavbarController.getIsSearchPaneOpen()}">\n              <div class="cross-element-search-toggle-content">\n                <os-svg icon="search"></os-svg>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \x3c!-- Explore Onshape--\x3e\n        <div class="navbar-btn-container" ng-if="NavbarController.visibilityControls.exploreOnshape">\n          <button class="btn btn-secondary explore-onshape-btn"\n            ng-click="NavbarController.goToExploreOnshape()"\n            data-bs-original-title="{{\'tooltips:::Go to Explore Onshape\' | i18next}}"\n            data-bs-placement="bottom">\n            <os-svg icon="explore-onshape"></os-svg>{{ "Explore Onshape" | i18next}}\n          </button>\n        </div>\n\n        \x3c!-- Notifications --\x3e\n        <div ng-show="NavbarController.isUserLoggedIn && !NavbarController.hideUserMenu && NavbarController.visibilityControls.notificationButton"\n             id="user-notification-status"\n             class="dropdown"\n             aria-label="{{\'tooltips:::Notifications\' | i18next}}"\n             role="button"\n             data-bs-original-title="{{\'tooltips:::Notifications\' | i18next}}"\n             data-bs-placement="bottom" tabindex="0">\n          <osx-user-notifications-toggle></osx-user-notifications-toggle>\n        </div>\n\n        \x3c!-- Action items button --\x3e\n        <div data-inapp-location="action-items-button" ng-if="NavbarController.visibilityControls.goToActionItems">\n          <div class="navbar-header-btn-container d-lg-block">\n            <button class="btn nav-item"\n                    ng-click="NavbarController.goToActionItems()"\n                    data-bs-original-title="{{\'tooltips:::View all Action items\' | i18next}}"\n                    data-bs-placement="bottom"\n                    data-identifier="Action items"\n                    type="button"\n                    aria-label="{{ \'Navigates you to Action items page in a new window.\' | i18next}}"\n                    role="link">\n              <os-svg aria-hidden="true" icon="navbar-action-items"></os-svg></button>\n          </div>\n        </div>\n\n        \x3c!-- Appstore button --\x3e\n        <div data-inapp-location="appstore-button" ng-if="NavbarController.visibilityControls.goToAppStore">\n          <div class="navbar-header-btn-container d-lg-block">\n            <button class="btn nav-invite nav-item" ng-click="NavbarController.goToAppStore()"\n                    data-bs-original-title="{{\'tooltips:::Go to App Store\' | i18next}}" data-bs-placement="bottom"\n                    type="button" aria-label="{{ \'Navigates you to Onshape app store in a new window.\'  | i18next}}" role="link">\n              <os-svg aria-hidden="true" icon="navbar-app-store"></os-svg></button>\n          </div>\n        </div>\n\n        \x3c!-- Learning center button --\x3e\n        <div data-inapp-location="learning-center-button" ng-if="NavbarController.visibilityControls.goToLearningCenter">\n          <div class="navbar-header-btn-container d-lg-block">\n       