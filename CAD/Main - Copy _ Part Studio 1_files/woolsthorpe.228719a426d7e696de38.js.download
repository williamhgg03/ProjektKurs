llFilters()"\n                    on-select="setHighlightedTab(tab)"></element-tree>\n    </div>\n  </div>\n\n  \x3c!-- Element thumbnail --\x3e\n  <div class="element-thumbnail" ng-if="view.preview && numberOfResults > 0">\n    <div class="element-name d-flex align-items-center" data-bs-original-title="{{highlightedTab.getElementName()}}" overflow-tooltip="true">\n      <os-svg class="element-icon add-space-right" icon="{{highlightedTab.getIconSrc()}}"></os-svg>\n      {{highlightedTab.getElementName()}}\n    </div>\n    <os-thumbnail class="thumbnail-image"\n                  document-id="{{documentId}}"\n                  has-thumbnail="{{::highlightedTab.hasThumbnail()}}"\n                  workspace-id="{{workspaceId}}"\n                  version-id={{versionId}}\n                  element-id="{{highlightedTab.elementId}}"\n                  api-configuration="{{highlightedTab.getCachedConfigurationEncoded()}}"\n                  part-id="{{highlightedTab.getPartIdForThumbnail()}}"\n                  document-thumbnail-stamp="{{highlightedTab.getDocumentThumbnailStamp()}}"\n                  ideal-width="300"\n                  ideal-height="170"\n                  is-publication="{{TabCtrl.isPublication}}"\n                  fallback-image="{{highlightedTab.getDefaultIconSrc()}}"\n                  watch-changes="true">\n    </os-thumbnail>\n    <div class="collaborator-list">\n      <div class="collaborator-badge"\n            ng-repeat="collaborator in selectedTab.collaborators"\n            ng-style="{\'background-color\': collaborator.color}">\n        <span class="collaborator-name">{{collaborator.name}}</span>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Footer --\x3e\n  <div class="document-panel-footer">\n    <span class="help-text ellipseOverflowText">\n      <span ng-show="hasFocus" ng-i18next="[html:i18next]({arrowKeyUp:\'↑\', arrowKeyDown:\'↓\'})<key>tab</key> or <key>__arrowKeyUp__</key><key>__arrowKeyDown__</key> to navigate"></span>\n      &