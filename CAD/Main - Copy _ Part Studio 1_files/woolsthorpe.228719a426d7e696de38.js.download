ss="{strong: (drawing.customTemplate === \'existing\'), \'btn-link\': (drawing.customTemplate !== \'existing\')}" class="template-choice"\n                ng-click="changeToCustomOrExistingTemplate(\'existing\')">{{\'Existing templates\' | i18next}}</span>\n          <span ng-class="{strong: (drawing.customTemplate === \'custom\'), \'btn-link\': (drawing.customTemplate !== \'custom\')}" class="template-choice"\n                ng-click="changeToCustomOrExistingTemplate(\'custom\')">{{\'Custom template\' | i18next}}</span>\n        </div>\n        <hr ng-hide="restrictDrawingTemplates"/>\n        <div class="existing-template" ng-show="drawing.customTemplate === \'existing\'">\n          <div class="new-drawing-template-left" ng-hide="restrictDrawingTemplates">\n            <div class="templates-filter-area">\n              <osx-document-filters-component\n                [is-flat]="true"\n                display-source="documentVersionPicker"\n                [global-tree-nodes]="globalTreeNodes"\n                [selected-filter-onshape]="drawing.selectedFilterType === drawing.filterTypes.OWNED_BY_ONSHAPE"\n                [selected-node-id]="drawing.selectedNodeId"\n                [selected-team-id]="drawing.selectedTeamId"\n                (change-tree-node)="changeTreeNode($event.treeNode, $event.$event)"\n                (change-filter)="changeFilter($event.filterType)"\n                [user-teams]="drawing.userTeams"\n                (change-team)="changeTeam($event.team)"\n                [show-public-filter]="showPublicDocumentFilter"\n                [show-onshape-filter]="showOnshapeFilter">\n              </osx-document-filters-component>\n            </div>\n          </div>\n          <div class="new-drawing-template-right" ng-class="{\'no-filter-options\' : restrictDrawingTemplates}">\n            <div class="template-standard" ng-hide="restrictDrawingTemplates">\n              <span ng-repeat="standard in drawing.standards"\n                    ng-class="{strong: (drawing.selectedStandard === standard), \'btn-link\': (drawing.selectedStandard !== standard)}"\n                    class="standard-filter" ng-click="onStandardSelected(standard)">{{standard.displayName}}</span>\n            </div>\n            <table>\n              <thead class="new-drawing-table-header">\n              <tr>\n                <th class="os-template-name sort-header" ng-click="changeSort(\'elementName\')">\n                  {{ "Template" | i18next}}<span class="document-sort-arrow">&nbsp;{{sortArrow(\'elementName\')}}</span>\n                </th>\n                <th class="os-document-name sort-header" ng-click="changeSort(\'documentName\')">\n                  {{ "Document" | i18next}}<span class="document-sort-arrow">&nbsp;{{sortArrow(\'documentName\')}}</span>\n                </th>\n                <th class="os-document-owner sort-header" ng-click="changeSort(\'ownerName\')">\n                  {{ "Owner" | i18next}}<span class="document-sort-arrow">&nbsp;{{sortArrow(\'ownerName\')}}</span>\n                </th>\n              </tr>\n              </thead>\n              <tbody class="full-width">\n              <tr ng-if="!drawing.retrievingTemplates" ng-repeat="template in drawing.templates" ng-class="{\'selected\':template.selected}" auto-size-header header-class=".new-drawing-table-header">\n                <td ng-click="onSelectTemplate(template)" ng-dblclick="onSelectTemplateAndCloseDialog(template)" data-bs-placement="bottom" data-bs-original-title="{{template.elementName}}"><span>{{template.elementName}}</span></td>\n                <td ng-click="onSelectTemplate(template)" ng-dblclick="onSelectTemplateAndCloseDialog(template)"><span>{{template.documentName}}</span></td>\n                <td ng-click="onSelectTemplate(template)" ng-dblclick="onSelectTemplateAndCloseDialog(template)"><span>{{template.ownerName}}</span></td>\n              </tr>\n              <tr ng-if="!drawing.neverRetrievedTemplates && !drawing.retrievingTemplates && drawing.templates.length === 0">\n                <td colspan="3">\n                  <div class="no-templates-found">\n                    <span>{{ "No templates found" | i18next}}</span>\n                  </div>\n                </td>\n              </tr>\n              <tr ng-if="drawing.neverRetrievedTemplates || drawing.retrievingTemplates">\n                <td colspan="3">\n                  <div class="no-templates-found">\n                    <span>{{ "Retrieving templates…" | i18next}}</span>\n                  </div>\n                </td>\n              </tr>\n              <tr class="onshape-templates-link" ng-if="!drawing.retrievingTemplates && drawing.selectedFilterType !== drawing.filterTypes.OWNED_BY_ONSHAPE && !restrictDrawingTemplates">\n                <td colspan="3">\n                  <a class="btn-link" ng-click="onFilterChangedToOnshapeAll()" ng-class=\'{selected: drawing.selectedFilterType === drawing.filterTypes.OWNED_BY_ONSHAPE}\'>{{\'Show Onshape drawing templates\' | i18next}}</a>\n                </td>\n              </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        <div class="custom-template" ng-show="drawing.customTemplate === \'custom\' && !restrictDrawingTemplates">\n          <div class="custom-template-left">\n            <div class="standard-options radio-text-option">\n              <label class="options-label">{{ \'Standard\' | i18next}}</label>\n              <span ng-repeat="standard in drawing.standards" ng-if="standard.canBeCustomStandard"\n                    ng-class="{\'strong\': (drawing.customStandard === standard), \'btn-link\': (drawing.customStandard !== standard)}"\n                    class="radio-text-button"\n                    ng-click="onCustomStandardSelected(standard)">\n                {{ standard.name | i18next }}\n              </span>\n            </div>\n            <div class="language-options custom-option radio-text-option">\n              <label class="options-label">{{ \'Language\' | i18next}}</label>\n              <select ng-model="drawing.customLanguage"\n                      ng-options="language.displayNameNative for language in drawing.languages"\n                      ng-change="onLanguageSelect(drawing.customLanguage.name)">\n              </select>\n            </div>\n            <div class="size-options custom-option">\n              <label class="options-label">{{ \'Size\' | i18next }}</label>\n              <select ng-model="drawing.customSize"\n                      ng-change="onSizeChanged(drawing.customSize)" ng-options="size.name for size in drawing.customStandard.sizes">\n              </select>\n            </div>\n            <div class="units-options custom-option radio-text-option">\n              <label class="options-label">{{ \'Units\' | i18next }}</label>\n              <div>\n                <select ng-model="drawing.customUnits"\n                        ng-options="option.value as option.label for option in unitOptions">\n                </select>\n              </div>\n            </div>\n            <div class="decimal-options custom-option radio-text-option">\n              <label class="options-label">{{ \'Decimal separator\' | i18next}}</label>\n              <span ng-class="{\'strong\': (drawing.customDecimalSeparator === \'period\'), \'btn-link\': (drawing.customDecimalSeparator !== \'period\')}" class="radio-text-button" ng-click="drawing.customDecimalSeparator = \'period\'">{{\'Period (12.34)\' | i18next}}</span>\n              <span ng-class="{\'strong\': (drawing.customDecimalSeparator === \'comma\'), \'btn-link\': (drawing.customDecimalSeparator !== \'comma\')}" class="radio-text-button" ng-click="drawing.customDecimalSeparator = \'comma\'">{{\'Comma (12,34)\' | i18next}}</span>\n            </div>\n            <div class="projection-options custom-option">\n              <label class="options-label">{{ \'Projection\' | i18next}}</label>\n            