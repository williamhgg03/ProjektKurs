or, maxTraction, contactCount);\n    }\n\n    if (!foundMultiple) {\n        foundMultiple = getConnectionFromVectors(vContactTraction2, vContactPairCoordinate2,\n            contactColor, maxTraction, contactCount);\n    }\n\n    if (!foundMultiple) {\n        foundMultiple = getConnectionFromVectors(vContactTraction3, vContactPairCoordinate3,\n            contactColor, maxTraction, contactCount);\n    }\n\n    if (contactCount == 0.0) {\n        discard;\n    }\n\n    float alpha = clamp((maxTraction - uTractionContactThreshold) / (PERFECT_TRACTION - uTractionContactThreshold), 0.0, 1.0);\n    if ((uBlendTransparent > 0.0) != (alpha < 1.0)) {\n        discard;\n    }\n\n    vec4 outputColor;\n    outputColor.a = alpha;\n\n#ifdef DERIVATIVES_SUPPORTED\n    // A light from the right, up, behind direction at 0.5 power\n    vec3 directionalLight = vec3(0.288675, 0.288675, 0.288675);\n    float diffuseWeight = max(dot(normal, directionalLight), 0.0);\n    outputColor.rgb = (AMBIENT_FACTOR + diffuseWeight) * contactColor;\n#else\n    outputColor.rgb = contactColor;\n#endif\n\n    return outputColor;\n}\n'},18935:function(e,t){"use strict";t.A='uniform float uCylinderRadius;\nuniform vec3 uCylinderAxisX;\nuniform vec3 uCylinderAxisY;\nuniform vec3 uCylinderAxisZ;\nuniform vec3 uCylinderOrigin;\nuniform mat4 uMVMatrix_fs;\nuniform float uThreadPitch;\nuniform float uThreadLength;\n\n{{{constants}}}\n\nfloat getCylinderUValue(vec3 normal, vec3 cylinderAxisX, vec3 cylinderAxisY)\n{\n    float dotNormalOnCylinderSide = (dot(normalize(cylinderAxisX), normalize(normal)) + 1.) / 4.;\n\n    // Use step function to differentiate between sides of the cylinder, then invert the result\n    // to ensure the threads have correct handedness.\n    float uValue = 1. - mix(dotNormalOnCylinderSide, 0.5 + (0.5 - dotNormalOnCylinderSide),\n        step(0.0, dot(normalize(cylinderAxisY), normal)) );\n    return uValue;\n}\n\nvec3 rotateAroundAxis(vec3 toRotate, vec3 axis, float angle) {\n    axis = normalize(axis);\n    float cosAngle = cos(angle);\n    float sinAngle = sin(angle);\n    return toRotate * cosAngle + cross(axis, toRotate) * sinAngle + axis * dot(axis, toRotate) * (1.0 - cosAngle);\n}\n\nvec3 getUpdatedNormal(vec3 normal, vec3 binormal, float threadVal)\n{\n    // upNormal and downNormal indicate the surface normals on either side of the thread geometry.\n    vec3 upNormal = rotateAroundAxis(normal, binormal, PI / -6.);\n    vec3 downNormal = rotateAroundAxis(normal, binormal, PI / 6.);\n\n    // normalBlend is the threshold of how the surface normals will be smoothed to avoid aliasing on the peak and valley\n    // of the thread. The thresholds indicate the transition points from one normal direction to the other, which are\n    // set based on ISO thread standards (which is also very similar to ANSI standards): https://en.wikipedia.org/wiki/ISO_metric_screw_thread\n    float normalBlend = 1. / 8.;\n\n    vec3 mixed = normal;\n    mixed = mix(mixed, downNormal, smoothstep(0., normalBlend, threadVal));\n    mixed = mix(mixed, normal, smoothstep(.5 - normalBlend, .5, threadVal));\n    mixed = mix(mixed, upNormal, smoothstep(.5, .5 + normalBlend, threadVal));\n    mixed = mix(mixed, normal, smoothstep(1. - normalBlend, 1., threadVal));\n    return normalize(mixed);\n}\n\nvec3 getThreadedNormal(vec3 position, vec3 normal)\n{\n    mat3 transposeMatrix = mat3(uMVMatrix_fs);\n\n    vec3 cylinderAxisX = normalize(transposeMatrix * uCylinderAxisX);\n    vec3 cylinderAxisY = normalize(transposeMatrix * uCylinderAxisY);\n    vec3 cylinderAxisZ = normalize(transposeMatrix * uCylinderAxisZ);\n\n    vec3 cylinderOrigin = (uMVMatrix_fs * vec4(uCylinderOrigin, 1.0)).xyz;\n\n    // These values represent the uv coordinates of the fragment in relation to the threaded cylinder. clyinderU has a\n    // range of 0-1 (1 represents 2PI radians). cylinderV is the distance from the fragment to the origin of the thread.\n    float cylinderU = getCylinderUValue(normal, cylinderAxisX, cylinderAxisY);\n    float cylinderV = dot(cylinderAxisZ, position - cylinderOrigin);\n\n    // threadVal represents where the current pixel is in "threadspace", a 0-1 value covering the entire profile of\n    // the thread being rendered. Values of 0 and 1 represent the peak of the thread, .5 is the valley in between these\n    // peaks. 0-1 encapsulates the antire "pitch" of the thread.\n    float threadVal = mod(cylinderV, uThreadPitch) / uThreadPitch;\n\n    // Adjust the thread value by the relative location around the U coordinate of the cylinder. This achieves the spiral\n    // effect.\n    threadVal = fract(threadVal + cylinderU);\n\n    vec3 binormal = normalize(cross(cylinderAxisZ, normal));\n    // Adjust the provided vertex normal around the binormal according to where the pixel is in thread space. Use the\n    // adjusted normal to generate the light fragment.\n    vec3 threadedNormal = getUpdatedNormal(normal, binormal, threadVal);\n\n    float lengthBlendThreshold = uThreadPitch;\n    threadedNormal = mix(threadedNormal, normal, smoothstep(uThreadLength - lengthBlendThreshold,\n        uThreadLength, cylinderV));\n\n    return threadedNormal;\n}\n\n\n'},39559:function(e,t){"use strict";t.A="FRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN FRAGMENT_PRECISION vec3 vModelPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN lowp float vOpacity;\n\nuniform sampler2D uAmbientTexture;\n\nuniform mat4 uDecalProjection;\nuniform mat3 uUvTransform;\nuniform float uCylinderRadius;\n\n{{{constants}}}\n\nvec4 getDecalColor() {\n    vec2 projectedUv;\n    if (uCylinderRadius > 0.0) {\n      vec3 vectorToCylinderOrigin = vModelPosition - uDecalProjection[3].xyz;\n      vec3 directionFromCylinderAxis = normalize(vectorToCylinderOrigin);\n      float theta = atan(dot(uDecalProjection[1].xyz, directionFromCylinderAxis), dot(uDecalProjection[0].xyz, directionFromCylinderAxis));\n\n      // Depending on how the cylinder UV is offset, we need to adjust theta such that\n      // it makes a continuous U value as it crosses it crosses PI.\n      if (uUvTransform[2][0] <= 0.0 && theta < 0.0) {\n        theta += TWO_PI;\n      } else if (uUvTransform[2][0] >= 1.0 && theta > 0.0) {\n        theta -= TWO_PI;\n      }\n\n      projectedUv[0] = theta * uCylinderRadius;\n      projectedUv[1] = dot(vectorToCylinderOrigin, uDecalProjection[2].xyz);\n    } else {\n      projectedUv = (uDecalProjection * vec4(vModelPosition, 1.0)).xy;\n    }\n\n    vec3 textureCoordinate = uUvTransform * vec3(projectedUv, 1.0);\n\n    if (textureCoordinate.x < 0.0 || textureCoordinate.x > 1.0 ||\n      textureCoordinate.y < 0.0 || textureCoordinate.y > 1.0) {\n        discard;\n    }\n\n    textureCoordinate.y = 1.0 - textureCoordinate.y;\n\n    return TEXTURE_2D(uAmbientTexture, textureCoordinate.xy);\n}\n"},63030:function(e,t){"use strict";t.A="#if HAS_FRAG_HIGHP\n\n#ifndef TWO_TO_TWENTY_FOUR\n#define TWO_TO_TWENTY_FOUR 16777216.0\n#endif\n\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvec4 packFloatIntoRGBA(highp float f) {\n    vec4 color;\n    color.b = floor(f / 256.0 / 256.0);\n    color.g = floor((f - color.b * 256.0 * 256.0) / 256.0);\n    color.r = floor(f - color.b * 256.0 * 256.0 - color.g * 256.0);\n    color.a = 255.0; //We'll just put one in the alpha value\n    //Normalize the value for color output\n    return color / 255.0;\n}\n\nvec4 packDepthIntoRGBA(highp float pointZ, highp float pointW) {\n    //Convert the depth into a value between 0 and (2^24-1).\n    //8388608.0 is 2^24 / 2.  This is an attempt to convert\n    //the number into the desired range without losing too\n    //much precision.\n    highp float f = (8388608.0 / pointW) * pointZ + 8388607.0;\n    return packFloatIntoRGBA(f);\n}\n\nvec4 packNormalizedFloatIntoRGBA(highp float f) {\n    return packFloatIntoRGBA(f * (TWO_TO_TWENTY_FOUR - 1.0));\n}\n\n#else\n\n#ifndef TWO_TO_FOURTEEN\n#define TWO_TO_FOURTEEN 16384.0\n#endif\n\nvec4 packFloatIntoRGBA(float f) {\n    vec4 color;\n    color.b = 0.0;\n    color.g = floor(f / 256.0);\n    color.r = floor(f - color.g * 256.0);\n    color.a = 255.0; //We'll just put one in the alpha value\n    //Normalize the value for color output\n    return color / 255.0;\n}\n\nvec4 packDepthIntoRGBA(float pointZ, float pointW) {\n    //If we're operating in medium precision mode, the best we can do is get a number between 0 and 2^14 - 1.\n    float f = (8192.0 / pointW) * pointZ + 8191.0;\n    return packFloatIntoRGBA(f);\n}\n\nvec4 packNormalizedFloatIntoRGBA(float f) {\n    return packFloatIntoRGBA(f * (TWO_TO_FOURTEEN - 1.0));\n}\n\n#endif\n\nvec2 encodeNormal(vec3 normal)\n{\n    // http://aras-p.info/texts/CompactNormalStorage.html#method04spheremap\n    float f = sqrt(8.0 * normal.z + 8.0);\n    return normal.xy / f + 0.5;\n}\n\n#if HAS_FRAG_HIGHP\nvec2 encodeDepth(highp float depth) {\n    highp float d = 65535.0 * depth;\n#else\nvec2 encodeDepth(float depth) {\n    float d = 16383.0 * depth;\n#endif\n    float x = floor(d / 256.0) / 255.0;\n    float y = mod(d, 256.0) / 255.0;\n    return vec2(x, y);\n}\n\n#if HAS_FRAG_HIGHP\nhighp float decodeDepth(highp vec2 encoded) {\n  // We want to calculate:  (256 * encoded[0] * 255 + encoded[1] * 255) / (2^16-1)   This reduces to:\n  highp float d = (256.0 * encoded.x + encoded.y) / 257.0;\n  return d;\n}\n#else\nfloat decodeDepth(vec2 encoded) {\n  // For medium precision, there will only be six bits of precision in the first byte.  This means that the range\n  // of possible numbers will be between 0 and 63.\n  float d = 255.0 * ((256.0 * encoded.x + encoded.y) / 16383.0);\n  return d;\n}\n#endif\n\nvec3 decodeNormal(vec2 encoded)\n{\n    // http://aras-p.info/texts/CompactNormalStorage.html#method04spheremap\n    vec2 e = 4.0 * encoded - 2.0;\n    float f = dot(e, e);\n    float g = sqrt(1.0 - f / 4.0);\n    vec3 n;\n    n.xy = e * g;\n    n.z = 1.0 - f / 2.0;\n    return n;\n}\n\nvec3 flipNormalTowardViewer(vec3 normal, vec3 position, mat4 projMatrix)\n{\n    float signPerspective = sign(dot(normal, -position));\n    float signOrthographic = sign(normal.z);\n    float sign = projMatrix[3][3] * signOrthographic - projMatrix[2][3] * signPerspective;\n    return sign * normal;\n}\n"},40349:function(e,t){"use strict";t.A="// This defines the width of the fall-off around lines' edges.  This fall-off provides anti-aliasing.\nuniform mediump float uLineFilterWidth;\nuniform mediump float uBackgroundMixProportion;\nuniform lowp vec4 uBackgroundColor;\nuniform lowp float uUsePrimitiveLines;\n\nbool isGap(highp float edgeLength, vec4 lineStipple) {\n  // line stipple defines 4 intervals, 2 of which are gaps, where fragments need to be discarded\n  float gapStart1 = lineStipple.x;\n  float gapStop1 = gapStart1 + lineStipple.y;\n  float gapStart2 = gapStop1 + lineStipple.z;\n  float stippleLength = gapStart2 + lineStipple.w;\n\n  float stippleDistance = mod(edgeLength, stippleLength + impulse(0.0, stippleLength));\n  return (stippleDistance > gapStart1 && stippleDistance < gapStop1) ||\n         (stippleDistance > gapStart2 && stippleDistance < stippleLength);\n}\n\nvoid discardIfIsGap(highp float edgeLength, vec4 lineStipple) {\n  if (isGap(edgeLength, lineStipple)) {\n    discard;\n  }\n}\n\nfloat getStippleAlphaMultiplier(highp float edgeLength, vec4 lineStipple) {\n  return float(!isGap(edgeLength, lineStipple));\n}\n\nvec4 edgeColor(vec4 inputColor, float lineWidth, float filterDistance) {\n  // apply edge filter\n  float opacityScale = smoothstep(0.0, uLineFilterWidth, 0.5 * (lineWidth + uLineFilterWidth) - abs(filterDistance));\n\n  vec4 color = inputColor;\n  color.rgb = mix(inputColor.rgb, uBackgroundColor.rgb, uBackgroundMixProportion);\n  color.a *= opacityScale;\n  return color;\n}\n"},14157:function(e,t){"use strict";t.A="VERT_IN vec4 aEdgeData;  // XYZ = direction, abs(W)-1 = length, length(XYZ) = corner index, sign(W) = infinite if negative\nVERT_IN float aEdgeLength;\nuniform lowp float uUsePrimitiveLines;\n\nfloat edgeCornerIndex() {\n  return round(length(aEdgeData.xyz));\n}\n\nfloat edgeNormalDirectionFlag(float cornerIndex) {\n  return -impulse(1.0, cornerIndex) - impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) + impulse(4.0, cornerIndex);\n}\n\nfloat edgeTangentDirectionFlag(float cornerIndex) {\n  return -impulse(1.0, cornerIndex) + impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) - impulse(4.0, cornerIndex);\n}\n\nbool edgeIsInfinite() {\n  return aEdgeData.a < 0.0;\n}\n\nfloat edgeLength() {\n  return abs(aEdgeData.a) - 1.0;\n}\n\nvoid computeTangentAndNormalOffsets(mat4 modelViewMatrix, vec4 projectedPosition, float lineWidth, out vec2 tangentOffset, out vec2 normalOffset) {\n  vec3 edgeDirection = normalize(aEdgeData.xyz);\n  bool isInfinite = edgeIsInfinite();\n  float cornerIndex = edgeCornerIndex();\n  float normalDirectionFlag = edgeNormalDirectionFlag(cornerIndex);\n  float tangentDirectionFlag = edgeTangentDirectionFlag(cornerIndex);\n\n  vec4 projectedDirection = uPMatrix * (modelViewMatrix * vec4(edgeDirection, 0.0));\n\n  // compute tangent and normal offsets that will make the line quad\n  tangentOffset = vec2(0.0, 0.0);\n  vec2 screenNormal = vec2(0.0, 0.0);\n  bool isOrthographic = (uPMatrix[3][3] > 0.0);\n  if (isOrthographic) {\n    // orthographic projection is simpler\n\n    screenNormal = normalize(uViewport.wz * vec2(-projectedDirection.y, projectedDirection.x));\n\n    // make infinite line\n    if (isInfinite) {\n      tangentOffset = tangentDirectionFlag * (length(projectedPosition.xy) + 2.0) * normalize(projectedDirection.xy);\n    }\n  } else {\n    // perspective projection is trickier\n\n    float flip = sign(projectedPosition.w + projectedDirection.w);\n    vec4 projectedEnd = projectedPosition + flip * projectedDirection;\n    vec2 screenTangent = flip * normalize(uViewport.zw * (projectedEnd.xy / projectedEnd.w - projectedPosition.xy / projectedPosition.w));\n    screenNormal = vec2(-screenTangent.y, screenTangent.x);\n\n    // make infinite line\n    if (isInfinite) {\n      vec2 screenPosition = (projectedPosition.xy / projectedPosition.w + vec2(1.0, 1.0)) * uViewport.zw;\n      vec2 screenOffset = tangentDirectionFlag * (length(screenPosition) + length(uViewport.zw)) * screenTangent;\n      tangentOffset = projectedPosition.w * (screenOffset / uViewport.zw);\n    }\n  }\n\n  // offset the projected vertex\n  normalOffset = (lineWidth * normalDirectionFlag * projectedPosition.w) * (screenNormal / uViewport.zw);\n}\n"},90807:function(e,t){"use strict";t.A="{{{constants}}}\n\n#ifndef UPMATRIX_DEFINE\nuniform mat4 uPMatrix_fs;\n#define UPMATRIX_DEFINE\n#endif\n\nuniform float uStripeCount;\nuniform float uStripeRotation;\nuniform float uFilterWidth;\nuniform float uRespectOrthographic;\n\nconst float VERTICAL_OFFSET = 0.02;\n\nvec4 zebraStripeFragment(FRAGMENT_PRECISION vec3 position, vec3 normal) {\n  bool isOrthographic = (uPMatrix_fs[3][3] > 0.0);\n\n  // pick a look vector, -z for orthogonal and eye(origin) -> position for perpective\n  vec3 look = (isOrthographic && bool(uRespectOrthographic)) ? vec3(0.0, 0.0, -1.0) : normalize(position.xyz);\n\n  // reflect about the surface normal\n  vec3 reflection = normalize(reflect(look, normalize(normal)));\n\n  // calculate vertical inclination of reflection, clamping to avoid dots at 0 and pi\n  float xFactor = sin(uStripeRotation);\n  float yFactor = cos(uStripeRotation);\n  float rotatedComponent = acos(xFactor * reflection.x + yFactor * reflection.y);\n\n  float inclination = clamp(rotatedComponent, VERTICAL_OFFSET, PI - VERTICAL_OFFSET);\n\n  // create sawtooth function\n  float bandHeight = PI / uStripeCount;\n  float stripe = mod(inclination, 2.0 * bandHeight);\n\n  // transform the function into a sine wave\n  stripe = sin(stripe * uStripeCount);\n\n  // transform sine to solid stripes with smooth transitions\n  stripe = smoothstep(-uFilterWidth, uFilterWidth, stripe);\n\n  return clamp(vec4(stripe, stripe, stripe, 1.0), 0.0, 1.0);\n}\n"},98264:function(e,t){"use strict";t.A="\n#ifndef UPMATRIX_DEFINE\nuniform mat4 uPMatrix_fs;\n#define UPMATRIX_DEFINE\n#endif\n\nuniform vec4 uViewport;\n\nuniform float uShininess;\nuniform sampler2D uAmbientTexture;\nuniform float uAmbientTextureFactor;\n\nuniform sampler2D uOcclusionMap;\nuniform float uOcclusionFactor;\n\nuniform bool uApplyTranslucentAlphaToAll;\n\n{{{getNormalSign}}}\n\nvec4 lightFragment(vec3 ambient, vec3 diffuse, vec3 specular, float opacity,\n                   vec3 position, vec3 normal, vec2 textureCoordinate, vec4 fragCoord) {\n    if (uAmbientTextureFactor > 0.0) {\n      vec4 ambientSample = TEXTURE_2D(uAmbientTexture, textureCoordinate);\n      ambient = mix(ambient, ambientSample.rgb, uAmbientTextureFactor);\n\n      // Since these textures are really only used for labels right now, the translucent rendering mode\n      // needs to ignore them.\n      // TODO: update how textures are handled by the translucent rendering mode if we start using them on part bodies\n      opacity = ambientSample.a * mix(opacity, 1.0, float(uApplyTranslucentAlphaToAll));\n    }\n\n    vec4 fragColor = vec4(ambient, opacity);\n\n    bool isLit = (dot(diffuse, diffuse) + dot(specular, specular) > 0.0);\n    if (isLit) {\n      vec3 normalDirection = normalize(normal);\n      normalDirection *= getNormalSign(vNormal, vPosition);\n\n      vec3 lightDiffuse  = vec3(0.5);\n      vec3 lightSpecular = vec3(1.0);\n      vec3 lightDirection = normalize(vec3(1.0, 1.0, 1.0));\n\n      float diffuseWeight = max(dot(normalDirection, lightDirection), 0.0);\n\n      vec3 eyeDirection = normalize(-vPosition);\n      vec3 halfVector = normalize(lightDirection + eyeDirection);\n      float specularWeight = pow(max(dot(normalDirection, halfVector), 0.0), uShininess);\n\n      fragColor.rgb += diffuseWeight * lightDiffuse * diffuse\n                     + specularWeight * lightSpecular * specular;\n    }\n    if (uOcclusionFactor > 0.0) {\n      vec2 uv = (fragCoord.xy - uViewport.xy) / uViewport.zw;\n      float occlusion = TEXTURE_2D(uOcclusionMap, uv).r;\n      fragColor.rgb *= pow(1.0 - occlusion, uOcclusionFactor);\n    }\n\n    return fragColor;\n}"},76541:function(e,t){"use strict";t.A="#if defined(GL_OES_standard_derivatives) && defined(DERIVATIVES_SUPPORTED)\n#extension GL_OES_standard_derivatives : enable\n#endif\n\n{{{compatibility}}}\n\n{{{contactVisualizationFunctions}}}\n{{{weightFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    vec4 contactColor = getContactColorOrDiscard();\n    FRAG_COLOR = getAccumulationColor(contactColor);\n}\n"},98741:function(e,t){"use strict";t.A="{{{compatibility}}}\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN mediump vec2 vTextureCoordinate;\nFRAG_IN lowp vec3 vAmbient;\nFRAG_IN lowp vec3 vDiffuse;\nFRAG_IN lowp vec3 vSpecular;\nFRAG_IN lowp float vOpacity;\n\n{{{weightFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n{{{cosmeticThreadFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec3 threadedNormal = getThreadedNormal(vPosition, vNormal);\n    vec4 baseColor = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, threadedNormal, vTextureCoordinate, gl_FragCoord);\n\n    FRAG_COLOR = getAccumulationColor(baseColor);\n}\n"},27793:function(e,t){"use strict";t.A="{{{compatibility}}}\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{decalFunctions}}}\n{{{weightFunctions}}}\n\nuniform bool uApplyTranslucentAlphaToAll;\nuniform bool uOutsideIsolation;\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 color = getDecalColor();\n\n    if (uApplyTranslucentAlphaToAll || uOutsideIsolation) {\n      color.a *= vOpacity;\n    } else if (color.a >= 1.0) {\n      // OIT