ass="control-label">{{ "Format" | i18next }}</label>\n        <select tabindex="1" id="export-format-dropdown" class="form-control" ng-model="options.format"\n                ng-change="onFormatChanged()" ng-options="p.displayName || p.name for p in formats"></select>\n        <label class="csv-export-message" ng-show="options.format.name === \'INSPECTION_LIST\'">{{ "Exported csv file will contain an ordered list of all inspection symbols." | i18next }}</label>\n      </div>\n      <div class="alert alert-warning" ng-if="showDeprecatedExportWarning()">\n          <os-svg class="add-space-bottom" icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{ \'Export support for __formatName__ will be deprecated as of May 4, 2026.\' | i18next:{formatName: options.format.name} }}\n          </span>\n      </div>\n      <div class="form-check" ng-show="!isCAMToolPathExport() && !isUrdfExport() && isElementNative && options.format.name !== \'INSPECTION_LIST\'">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="axis-checkbox" class="form-check-input" type="checkbox" ng-model="options.yAxisIsUp" ng-checked="options.yAxisIsUp">{{ "Export models oriented Y axis up" | i18next }}</label>\n      </div>\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'STEP\' && isStepParasolidPreprocessingEnabled">\n        <label class="control-label">{{ "Preprocessing" | i18next }}</label>\n          <select class="form-control" id="step-parasolid-preprocessing-on-read"  ng-model="options.stepParasolidPreprocessingOption"\n                  ng-options="p.value as p.name for p in stepParasolidPreprocessing"></select>\n      </div>\n      <div class="form-group" ng-show="isElementNative && isUrdfExport()">\n        <label class="control-label">{{ "Geometry format" | i18next }}</label>\n          <select class="form-control" id="urdf-geometry-format-dropdown"  ng-model="options.urdfMeshFormat"\n                  ng-options="p.value as p.name for p in urdfMeshFormatOptions"></select>\n      </div>\n\n      <div class="form-group" ng-show="isUrdfExport() && options.urdfMeshFormat == GBTUrdfMeshFormat.STL">\n        <label class="control-label">{{"STL Format" | i18next}}</label>\n        <select class="stl-export-mode form-control" ng-model="options.urdfStlEncoding" ng-options="exportMode.value as exportMode.name for exportMode in stlEncodingChoices"> </select>\n      </div>\n\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'STEP\'">\n        <label class="control-label">{{ "Version" | i18next }}</label>\n          <select class="form-control" id="step-export-version-dropdown" tabindex="2" ng-model="options.stepVersionString"\n                  ng-options="v for v in stepVersions" ng-disabled="options.useLatestStepVersion" ng-change="updateWarnMeshExport()"></select>\n      </div>\n      <div class="alert alert-warning" ng-if="!!(getMbdCompositeStepWarning() && options.format.name === \'STEP\')">\n          <os-svg class="add-space-bottom" icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{getMbdCompositeStepWarning()}}\n          </span>\n      </div>\n\n      <div class="alert alert-warning" ng-if="!!(allowMBDExport() && (mbdInvalidAnnotationSymbolWarning = getMbdInvalidAnnotationSymbolWarning()))">\n          <os-svg class="add-space-bottom" icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{mbdInvalidAnnotationSymbolWarning}}\n          </span>\n      </div>\n\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'RHINO\'">\n        <div>\n          <label class="control-label">{{ "Version" | i18next }}</label>\n          <select class="form-control" id="export-version-dropdown" tabindex="2" ng-model="options.rhinoVersion"\n                  ng-options="v for v in rhinoVersions" ng-disabled="options.