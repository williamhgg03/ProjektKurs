eTabs(documentInsertableSet)"\n       class="os-dialog-tab-group os-no-shrink">\n    <div class="os-dialog-tab insert-filter"\n         ng-repeat="insertableGroup in documentInsertableSet.getGroups()"\n         ng-class="{\'active-tab\': documentInsertableSet.getIsGroupActive(insertableGroup)}"\n         ng-click="documentInsertableSet.switchToInsertableGroup(insertableGroup)">\n      {{insertableGroup.getDisplayName()}}\n    </div>\n  </div>\n\n  \x3c!-- Document search box --\x3e\n  <div ng-show="viewState.shouldShowDocumentSearchBox()"\n       class="os-control-container document-version-picker-search-container ng-cloak">\n    <search-box class="os-row search-box select-item-document-search"\n                placeholder="viewState.documentSearchPlaceholder"\n                search-query="viewState.documentSearchText"\n                with-query="viewState.documentSearchText"\n                with-criteria="true"\n                is-active="viewState.shouldShowDocumentSearchBox()"\n                excluded-fields="viewState.getDocumentSelector().getCriteriaToExcludeFromSearch()"\n                searchable-types="::(viewState.getDocumentSelector().getSearchableTypes())"\n                initially-focused="viewState.isSearchInitiallyFocused"\n    ></search-box>\n  </div>\n\n  \x3c!-- Insertables search box --\x3e\n  <div class="os-control-container document-version-picker-search-container"\n       ng-if="viewState.shouldShowInsertablesSearchBox(Ctrl.insertableSelector)">\n    <div class="os-control-row">\n      <os-search-box class="select-item-insertables-search os-search-box-container os-grow os-field"\n                     trim="false"\n                     search-text="viewState.insertablesSearchText"\n                     placeholder="viewState.insertablesSearchPlaceholder"\n                     initially-focused="viewState.isSearchInitiallyFocused">\n      </os-search-box>\n\n      \x3c!-- Insertables sort selector (reuses the Angular 20 osx-sort-dropdown, do