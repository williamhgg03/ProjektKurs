.status">\n          {{ ctrl.WorkflowableTaskService.getTaskStatusString(ctrl.workflowableTask) }}\n        </span>\n      </h3>\n      <button type="button"\n        class="btn-close"\n        ng-if="!ctrl.spinner.show"\n        ng-disabled="!ctrl.isModelReady() || ctrl.spinner.show"\n        ng-click="ctrl.close()"\n        aria-hidden="true">\n      </button>\n  </div>\n  <form name="taskForm"\n        class="task-form"\n        ng-if="!ctrl.spinner.show && ctrl.isModelReady()"\n        autocomplete="off"\n        novalidate="novalidate"\n        ng-model-options="{updateOn: \'default blur\', debounce: {\'default\': 300, \'blur\': 0} }"\n        ng-class="{\'editing-task\': !ctrl.editingAllProperties, \'is-setup\': ctrl.workflowableTask.isSetup}">\n    \x3c!-- root, contains just one panel --\x3e\n    <os-layout os-axis="y"\n               class="layout-root"\n               resize-last="true"\n               os-disabled="{{ctrl.collapsed}}">\n      \x3c!-- the row contains left and right panels--\x3e\n\n      <os-layout class="top-row"\n                 os-axis="x"\n                 os-size="100%"\n                 resize-last="true"\n                 os-disabled="{{ctrl.collapsed}}">\n        <os-layout os-hidden="{{ctrl.showingComments}}" os-size="false" os-min-size="280">\n          <div class="os-grow flyout-content">\n            <task-workflow-property-sheet class="container-fluid flyout-tab"\n                                          form-ctrl="taskForm"\n                                          placeholders="placeholders"\n                                          task="ctrl.workflowableTask"\n                                          on-change="ctrl.onPropertyChange(propertyId, value)"\n                                          show-full-comments="ctrl.toggleComments"></task-workflow-property-sheet>\n          </div>\n        </os-layout>\n        \x3c!-- property sheet --\x3e\n        <os-layout os-size="{{ctrl.detailsPaneWidth}}"\n                   os-min-size="{{ctrl.detailsCurrentMinSize}}"\n                   storage-id="{{ctrl.taskDialogStorageId}}"\n                   os-hidden="{{ctrl.showingComments}}"\n                   id="task-detail-pane">\n          <div class="tabbed-panel">\n            <div class="os-column-splitter-container os-grow os-full-height">\n              <div class="os-row os-grow os-full-height">\n                <div class="os-row">\n                  <div class="button-bar os-col">\n                    <div class="button-bar-group os-col">\n                      <div class="button-container os-row disable-user-select"\n                           ng-repeat="tab in ctrl.getTabList()">\n                        <button type="button" class="action-button"\n                             ng-class="{\'active\': ctrl.getSelectedTab().id === tab.id,\'button-is-extension\': !!tab.tabData}"\n                             data-bs-original-title="{{ tab.tooltip }}"\n                             data-bs-placement="left"\n                             aria-label="{{ tab.title }}"\n                             ng-click="ctrl.selectTab(tab)">\n                          <span ng-class="{\'detail-pane-tab-is-extension\' : !!tab.tabData}">\n                            <os-svg icon="{{ tab.icon }}"\n                                    bt-no-focus\n                                    class="os-change-item-flyout-toggle os-icon"\n                                    alt="{{ tab.tooltip }}"\n                                    ng-if="!tab.iconUrl"></os-svg>\n                            <img ng-src="{{ tab.iconUrl }}"\n                                 bt-no-focus\n                                 class="os-change-item-flyout-toggle os-icon"\n                                 alt="{{ tab.tooltip }}"\n                                 ng-if="!!tab.iconUrl" />\n                          </span>\n                        </button>\n                        <div class="tab-selector"\n                             ng-if="ctrl.getSelectedTab().id === tab.id"></div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div class="os-col os-grow flyout-content"\n                     ng-if="ctrl.getSelectedTab()">\n                  <div class="flyout-tab"\n                       ng-if="ctrl.getSelectedTab().id === ctrl.panelTabs.PROPERTIES">\n                    <task-metadata-property-sheet form-ctrl="taskForm"\n                                                  company-id="ctrl.companyId"\n                                                  object-types="ctrl.objectTypes"\n                                                  placeholders="placeholders"\n                                                  task="ctrl.workflowableTask"\n                                                  on-change="ctrl.onPropertyChange(propertyId, value)"\n                                                  show-company-dropdown="ctrl.workflowableTask.isMultiCompany">\n                    </task-metadata-property-sheet>\n                    <div class="picker-container workflow-picker" ng-if="::ctrl.getIsEnterprise()">\n                      <label class="control-label"><span>{{\'Task workflow\' | i18next }}</span></label>\n                      <div class="os-row workflow-select-row">\n                        <select class="form-control workflow-selector no-margin"\n                                ng-model="ctrl.selectedTaskWorkflow"\n                                ng-options="option as ctrl.getDisplayName(option) for option in ctrl.workflows track by option.id"\n                                ng-change="ctrl.handleWorkflowChange(option)"\n                                ng-disabled="ctrl.shouldDisableWorkflowSelector()"\n                        ></select>\n                        <button class="os-button"\n                           ng-click="ctrl.toggleWorkflowDiagram($event)"\n                           data-bs-original-title="{{ \'tool