wElementFsVersion()">\n        <span class="row-title">Element FS version:</span>\n        <span class="row-content">{{ ctrl.getElementFsVersionNumber() }} ({{ ctrl.getElementFsVersionString() }})</span>\n      </div>\n\n      \x3c!-- Entity ids. --\x3e\n      <div class="debug-pane-collapsible" ng-if="ctrl.getIsInPartStudio() || ctrl.getIsInAssembly()">\n        <div class="debug-pane-collapsible-header" ng-click="ctrl.toggleTagDebugExpanded()">\n          <os-svg ng-class="{\'expanded\': ctrl.tagDebugExpanded}" icon="collapsed"></os-svg>\n          <span class="debug-pane-collapsible-header-title">Entity ids</span>\n        </div>\n        <div class="debug-pane-collapsible-content" ng-if="ctrl.tagDebugExpanded">\n          <div class="debug-pane-row">\n            <span class="row-title">Encoded id:</span>\n            <span class="row-content">{{ ctrl.tagDebugEncodedId }}</span>\n          </div>\n          <div class="debug-pane-row">\n            <span class="row-title">Decoded id:</span>\n            <input type="text" class="debug-pane-tag-input" ng-model="ctrl.tagDebugDecodedId" ng-keypress="$event.keyCode === 13 && ctrl.tagDebugHighlightEnteredId(ctrl.tagDebugDecodedId)"/>\n          </div>\n          <div class="ns-selection-details-section" ng-if="ctrl.tagDebugSelectionDetails.length > 0">\n            <div class="ns-selection-details">\n              <div class="ns-selection-detail-item" ng-repeat="detail in ctrl.tagDebugSelectionDetails">\n                <div class="ns-selection-detail-name">{{ detail.detailName }}:&nbsp;</div>\n                <div class="ns-selection-detail-value">{{ detail.detail }}</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \x3c!-- Microversion chain. --\x3e\n      <div class="debug-pane-collapsible" ng-if="ctrl.getIsInPartStudio() || ctrl.getIsInAssembly()">\n        <div class="debug-pane-collapsible-header microversion-chain-header" ng-click="ctrl.toggleMicroversionChainExpanded()">\n          <os-svg ng-class="{\'expanded\': ctrl.microversionChainExpanded}" icon="collapsed"></os-svg>\n          <span class="debug-pane-collapsible-header-title">Microversions&nbsp;</span>\n          <input type="number" min="1" ng-attr-max="{{ ctrl.microversionChainMaxLength }}"\n                 class="debug-pane-tag-input microversion-chain-length-input"\n                 ng-model="ctrl.microversionChainRequestedLength"\n                 ng-change="ctrl.onMicroversionChainLengthChanged()"\n                 ng-click="$event.stopPropagation()"/>\n          <button ng-if="!ctrl.microversionChainSubscribed"\n                  class="btn btn-secondary small-secondary-btn clickable"\n                  ng-click="$event.stopPropagation(); ctrl.getMicroversionChainOnce()">\n            Get\n          </button>\n          <button ng-if="!ctrl.microversionChainSubscribed"\n                  class="btn btn-secondary small-secondary-btn clickable"\n                  ng-click="$event.stopPropagation(); ctrl.toggleMicroversionChainSubscription()">\n            Subscribe\n          </button>\n          <button ng-if="ctrl.microversionChainSubscribed"\n                  class="btn btn-secondary small-secondary-btn clickable"\n                  ng-click="$event.stopPropagation(); ctrl.toggleMicroversionChainSubscription()">\n            Unsubscribe\n          </button>\n          <span ng-if="ctrl.microversionChainSubscribed" class="microversion-chain-warning">\n            Remember to turn this off\n          </span>\n        </div>\n        <div class="debug-pane-collapsible-content" ng-if="ctrl.microversionChainExpanded">\n          <os-message-viewer messages="ctrl.microversionChainMessages"></os-message-viewer>\n        </div>\n      </div>\n    </div>\n\n    \x3c!-- Part studio or variable studio. --\x3e\n    <div ng-if="ctrl.getIsInPartOrVariableStudio()">\n      \x3c!-- Model tree. --\x3e\n      <div class="debug-pane-section" ng-if="ctrl.getShouldShowPartStudioModelTree()">\n        <os-message-viewer messages="ctrl.modelTreeMessages"></os-message-viewer>\n      </div>\n\n      \x3c!-- Part properties. --\x3e\n      <div class="debug-pane-section" ng-if="ctrl.getShouldShowPartProperties()">\n        <div class="debug-pane-update-bar">\n          <button class="clear-websocket-messages-button btn btn-secondary small-secondary-btn clickable" ng-click="ctrl.updatePartProperties()">\n            <os-svg class="os-icon-small" icon="refresh-button"></os-svg>\n            Update\n          </button>\n          <div ng-if="ctrl.partPropertiesLoading" class="os-spinner-small os-spinner-spinning debug-pane-update-spinner"></div>\n          <span ng-if="!ctrl.partPropertiesLoading && ctrl.partPropertiesElapsedMillis !== null" class="debug-pane-elapsed-text">Elapsed: {{ ctrl.partPropertiesElapsedMillis }} ms</span>\n        </div>\n        <os-message-viewer messages="ctrl.partPropertiesMessages"></os-message-viewer>\n      </div>\n\n      \x3c!-- Computed data. --\x3e\n      <div class="debug-pane-section" ng-if="ctrl.getShouldShowPartStudioComputedData()">\n        <os-message-viewer messages="ctrl.partStudioComputedDataMessages"></os-message-viewer>\n      </div>\n    </div>\n\n    \x3c!-- Assembly. --\x3e\n    <div ng-if="ctrl.getIsInAssembly()">\n      \x3c!-- Assembly tree. --\x3e\n      <div class="debug-pane-section" ng-if="ctrl.getShouldShowAssemblyTree()">\n        <os-message-viewer messages="ctrl.assemblyTreeMessages"></os-message-viewer>\n      </div>\n    </div>\n\n    \x3c!-- Selection filter (part studio and assembly only). --\x3e\n    <div class="debug-pane-section" ng-if="ctrl.getIsSelectionTabSelected()">\n      <div class="form-switch debug-websocket-view-header">\n        <div class="debug-websocket-switch-container">\n          <input class="form-check-input user-select-auto" type="checkbox" role="button" id="selection-debug-switch" ng-checked="ctrl.debugSelectionFilter" ng-click="ctrl.toggleDebugSelectionFilter($event)">\n          <label class="form-check-label mb-0 clickable" for="selection-debug-switch">{{ "Debug selection filter" }}</label>\n        </div>\n        <button class="clear-websocket-messages-button btn btn-secondary small-secondary-btn clickable" ng-click="ctrl.clearSelectionDebugEntries()">\n          Clear\n          <os-svg class="os-icon-small" icon="close-x"/>\n        </button>\n      </div>\n      <div ng-repeat="entry in ctrl.selectionDebugEntries" class="debug-selection-entry">\n        <div class="debug-selection-header">{{ entry.timestamp }} {{ entry.selectionId }}</div>\n        <div class="debug-selection-tree"\n             ng-mouseleave="entry.hoveredLine = -1">\n          <div ng-repeat="line in entry.filterLines"\n               class="debug-selection-line"\n               ng-class="ctrl.getSelectionLineClass(entry, $index)"\n               ng-mouseenter="entry.hoveredLine = $index">\n            <span class="debug-selection-prefix">{{ line.prefix }}</span><span class="debug-selection-icon">{{ line.passed ? \'✓\' : \'✗\' }}</span>\n            <span class="debug-selection-name">{{ line.name }}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \x3c!-- Drawing. --\x3e\n    <div class="debug-drawing-content" ng-if="ctrl.getIsInDrawing()">\n      \x3c!-- Drawing JSON. --\x3e\n      <div class="debug-pane-section debug-drawing-json-section" ng-if="ctrl.getShouldShowDrawingJson()">\n        <div class="debug-pane-update-bar">\n          <button class="clear-websocket-messages-button btn btn-secondary small-secondary-btn clickable" ng-click="ctrl.loadDrawingJson()">\n            Refresh\n          </button>\n          <label class="debug-pane-checkbox-label">\n            <input type="checkbox" ng-model="ctrl.drawingJsonFull" ng-change="ctrl.onDrawingJsonFullChange()">\n            Full\n          </label>\n        </div>\n        <os-message-viewer messages="ctrl.drawingJsonMessages"></os-message-viewer>\n      </div>\n\n      \x3c!-- Drawing client messaging. --\x3e\n      <div class="debug-pane-section debug-client-messaging-section" ng-if="ctrl.getShouldShowDrawingClientMessaging()" ng-init="ctrl.initializeDrawingClientMessageEditor()">\n        <div class="debug-client-messaging-controls">\n          <span class="row-title">Message type:</span>\n          <select class="form-control" ng-model="ctrl.selectedDrawingClientMessageType" ng-change="ctrl.onDrawingClientMessageTypeChange()"\n                  ng-options="template.value as template.label for template in ctrl.drawingClientMessageTemplates"></select>\n        </div>\n\n        <div class="debug-pane-row">\n          <span class="row-title">Payload:</span>\n        </div>\n        <div id="drawing-client-message-editor" class="debug-json-editor" aria-label="Drawing client message payload editor"></div>\n\n        <div class="debug-pane-update-bar">\n          <button class="clear-websocket-messages-button btn btn-secondary small-secondary-btn clickable" ng-click="ctrl.sendDrawingClientMessage()">\n            Send PostMessage\n          </button>\n        </div>\n\n        <div class="debug-response-section-header" ng-click="ctrl.toggleDrawingClientMessageResponses()">\n          <os-svg ng-class="{\'expanded\': ctrl.drawingClientMessageResponsesExpanded}" icon="collapsed" class="debug-response-toggle-icon"></os-svg>\n          <span class="debug-response-title">Response</span>\n          <span class="debug-response-count" ng-if="ctrl.drawingClientMessageResponses.length > 0">({{ctrl.drawingClientMessageResponses.length}})</span>\n        </div>\n\n        <div class="debug-response-section" ng-if="ctrl.drawingClientMessageResponsesExpanded">\n          <os-message-viewer messages="ctrl.drawingClientMessageResponses"></os-message-viewer>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Document tab content. --\x3e\n  <div class="debug-pane-content" ng-if="ctrl.getIsDocumentTabSelected()">\n    \x3c!-- Container. --\x3e\n    <div class="debug-pane-section" ng-if="ctrl.getShouldShowDocumentContainer()">\n      <os-message-viewer messages="ctrl.documentContainerMessages"></os-message-viewer>\n    </div>\n    \x3c!-- Document ids. --\x3e\n    <div class="debug-pane-section" ng-if="ctrl.getShouldShowDocumentIds()">\n      <div class="debug-pane-row">\n        <span class="row-title">Document id:</span>\n        <span class="row-content">{{ ctrl.getDocumentId() }}</span>\n      </div>\n      <div class="debug-pane-row">\n        <span class="row-title">Microversion id:</span>\n        <span class="row-content">{{ ctrl.getDocumentMvId() }}</span>\n      </div>\n      <div class="debug-pane-row" ng-if="ctrl.getIsDocumentOwnedByCompany()">\n        <span class="row-title">Owner:</span>\n        <span class="row-content">{{ ctrl.getDocumentOwnerId() }} ({{ ctrl.getDocumentOwnerName() }})</span>\n      </div>\n      <div class="debug-pane-row">\n        <span class="row-title">Document FS version:</span>\n        <span class="row-content">{{ ctrl.getDocumentFsVersionNumber() }} ({{ ctrl.getDocumentFsVersionString() }})</span>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Global tab content. --\x3e\n  <div class="debug-pane-content" ng-if="ctrl.getIsGlobalTabSelected()">\n    <div class="debug-pane-section">\n      <div class="debug-pane-update-bar">\n        <button class="clear-websocket-messages-button btn btn-secondary small-secondary-btn clickable" ng-click="ctrl.resetFeatureSettings()" ng-disabled="ctrl.resetFeatureSettingsLoading">\n          Reset feature settings\n        </button>\n        <span class="debug-pane-elapsed-text">{{ ctrl.getCurrentFeatureKey() || \'(empty — resets all features)\' }}</span>\n        <div ng-if="ctrl.resetFeatureSettingsLoading" class="os-spinner-small os-spinner-spinning debug-pane-update-spinner"></div>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Websocket tab content. --\x3e\n  <div class="debug-pane-content" ng-if="ctrl.getIsWebsocketTabSelected()">\n    <div class="debug-pane-section">\n      <div class="form-switch debug-websocket-view-header">\n        <div class="debug-websocket-switch-container">\n          <input class="form-check-input user-select-auto" type="checkbox" role="button" id="websocket-debug-switch" ng-checked="ctrl.debugWebsocket" ng-click="ctrl.toggleDebugWebsocket($event)">\n          <label class="form-check-label mb-0 clickable" for="websocket-debug-switch">{{ "Debug websocket messages" }}</label>\n        </div>\n        <button class="clear-websocket-messages-button btn btn-secondary small-secondary-btn clickable" ng-click="ctrl.clearWebsocketMessages()">\n          Clear\n          <os-svg class="os-icon-small" icon="close-x"/>\n        </button>\n      </div>\n      <os-message-viewer messages="ctrl.websocketMessages" collapsible="true"></os-message-viewer>\n    </div>\n  </div>\n</div>\n')}]),e.exports=i},54324:function(e,t,n){var i="/project/web/ts/document-list/osPublicStats.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<span>\n  <div data-bs-placement="bottom" data-bs-original-title=\'{{"Copies" | i18next }}\'>\n    <os-svg icon="document-copies" alt="Copies"></os-svg><p>{{document.numberOfTimesCopied}}</p>\n  </div>\n</span>\n<span>\n  <div data-bs-placement="bottom" data-bs-original-title=\'{{"Links" | i18next }}\'>\n    <os-svg icon="inserted-version" alt="Links"></os-svg><p>{{document.numberOfTimesReferenced}}</p>\n  </div>\n</span>\n<span>\n  <div ng-class="{btn: !document.isAccessedAsAnonymous}" ng-click="toggleLike(document)"\n       data-bs-placement="bottom" data-bs-original-title="{{likeTooltip}}">\n    <os-svg icon="{{likeIcon}}" alt="Likes"></os-svg>\n    <p>{{document.likes}}</p>\n  </div>\n</span>')}]),e.exports=i},43456:function(e,t,n){var i="/project/web/ts/document/ElementBanner/ElementBanner.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="element-banner" ng-class="{\'context-banner-present\': $ctrl.isAnyContextBannerActive()}">\n  <div class="context-mode-caption transient-context os-row light-blue-background"\n    ng-class="{\'grey-background\': $ctrl.banner.shouldUseGreyBackground()}">\n    <div data-bs-placement="bottom" data-bs-original-title="{{$ctrl.banner.message}}" class="banner-message">{{ $ctrl.banner.message }}</div>\n    <div class="context-caption-spacer"></div>\n\n    <button ng-if="$ctrl.banner.shouldShowButton()"\n      ng-click="$ctrl.banner.onButtonClick()"\n      class="btn btn-secondary btn-sm small-secondary-btn action-button">\n        {{ $ctrl.banner.getButtonText() }}\n    </button>\n\n    <div class="btn-group os-no-shrink" ng-if="$ctrl.banner.shouldShowSelect()">\n      <button class="btn btn-secondary btn-sm small-secondary-btn" type="button">\n        {{ $ctrl.banner.config.placeholderText | i18next }}\n      </button>\n      <button type="button"\n        class="btn btn-secondary btn-sm small-secondary-btn dropdown-toggle"\n        data-bs-toggle="dropdown"\n        aria-haspopup="true"\n        aria-expanded="false">\n          <span class="visually-hidden">Toggle Dropdown</span>\n      </button>\n      <ul class="dropdown-menu float-end">\n        <li ng-repeat="action in $ctrl.banner.getConfigActions()" >\n          <a class="dropdown-item" href="#" data-action="action.text" ng-click="$ctrl.banner.onSelectOptionClick(action)">\n            <span>{{ action.text }}</span>\n            <os-svg icon="check_mark"\n              class="icon option-selected"\n              ng-if="$ctrl.banner.config.selectedAction === action.text"></os-svg>\n          </a>\n        </li>\n      </ul>\n    </div>\n  </div>\n</div>\n')}]),e.exports=i},55106:function(e,t,n){var i="/project/web/ts/document/featureScriptNotice.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<tbody>\n  <tr class="notice-location-row compact-table-row-clickable"  ng-click="notice.toggleIsExpanded()">\n    <td class="notice-expander-cell">\n      <div ng-if="notice.hasAStackTrace() && notice.getIsExpanded()" class="notice-collapse-button">\n        <os-svg\n          class="os-icon-xsmall"\n          icon="expanded">\n        </os-svg>\n      </div>\n      <div ng-if="notice.hasAStackTrace() && !notice.getIsExpanded()" class="notice-expand-button">\n        <os-svg\n          class="os-icon-xsmall"\n          icon="collapsed">\n        </os-svg>\n      </div>\n    </td>\n    <td class="icon-cell">\n      <div class="ace_gutter-cell" ng-class="{\'fs-notice-error\': notice.getIsError(), \'fs-notice-warning\': notice.getIsWarning(), \'fs-notice-info\': notice.getIsInfo()}" data-bs-original-title="{{::notice.getTooltipMessage()}}"></div>\n    </td>\n    <td colspan="2" class="error-text-td">\n      <div class="notice-location-message">{{::notice.getMessage()}}</div>\n    </td>\n  </tr>\n\n  <tr class="notice-location-row compact-table-row-clickable"\n      ng-if="notice.hasAStackTrace() && notice.getIsExpanded()"\n      ng-repeat="noticeLocation in notice.getStackTrace()"\n      ng-click="goToStackFrame(noticeLocation)">\n    <td class="notice-expander-cell"></td>\n    <td class="icon-cell">\n      <img class="external-notice-location" ng-if="::!noticeLocation.isWithinCurrentDocumentWorkspace()" src="/images/arrow-up-right2.svg" alt="" data-bs-original-title="{{ \'Definition is in a linked reference external to this workspace\' | i18next}}"/>\n    </td>\n    <td class="compact-table-numeric compact-table-secondary">\n      <span ng-if="::noticeLocation.getHasPosition()"><span class="notice-location-line-number">{{::noticeLocation.getLine()}}</span>:<span class="notice-location-column-number">{{::noticeLocation.getColumn()}}</span></span>&nbsp;&nbsp;&nbsp;\n    </td>\n    <td class="error-list-error-text">\n      <div class="notice-location-message">{{::noticeLocation.getModuleName()}}<span ng-if="::noticeLocation.hasMethodName()">&nbsp;({{::noticeLocation.getMethodName()}})</span></div>\n    </td>\n  </tr>\n</tbody>\n')}]),e.exports=i},3361:function(e,t,n){var i="/project/web/ts/document/featureScriptNotices.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="notices-container">\n  <div class="notices-content" ng-include="\'/project/web/woolsthorpe/app/partials/errorsList.html\'"></div>\n</div>\n')}]),e.exports=i},36442:function(e,t,n){var i="/project/web/ts/document/featureScriptSearch.html";n(82414).module("ng").run(["$templateCache",function(e){e.put(i,'<div class="feature-script-search-container" os-controller-name="FeatureScriptSearchController" os-keyboard-scope os-escape="onEscape()" ng-click="autoCloseFlyouts()" oncontextmenu="return false;">\n  <div class="feature-script-search-and-replace-wrapper">\n    <div class="feature-script-caret-column" ng-if="canShowReplaceField()" data-bs-original-title="{{\'tooltips:::Toggle replace\' | i18next}}" data-bs-placement="bottom"\n         ng-click="toggleReplaceSection()">\n      <os-svg ng-if="searchState.getShouldShowReplaceSection()" class="os-icon-small" icon="expanded"></os-svg>\n      <os-svg ng-if="!searchState.getShouldShowReplaceSection()" class="os-icon-small" icon="collapsed"></os-svg>\n    </div>\n    <div class="feature-script-content-column">\n      <os-form>\n        <div class="feature-script-search-query">\n          <div class="feature-script-search-mode-and-entry">\n            <osx-search-mode-dropdown class="feature-script-search-mode-dropdown"\n                                      ng-if="isFindUsagesCapabilityEnabled"\n                                      [options]="searchModeOptions"\n                                      [active-option-id]="getActiveSearchModeId()"\n                                      [toggle-tooltip]="\'tooltips:::Search mode\' | i18next"\n                                      (option-selected)="onSearchModeSelected($event)">\n            </osx-search-mode-dropdown>\n            <div class="text-input-container">\n              <input class="form-control" text-dropdown-list="searchState.searchHistoryStack" external-handle="dropdownControl" placeholder="{{searchState.getSearchTextPlaceholder()}}" type="text" name="searchString" required ng-model="searchState.searchString" spellcheck="false" autocomplete="off" os-focus-select="onReady" ng-disabled="searchState.getIsSymbolSearchMode()">\n              <div class="os-caret os-text-input-dropdown-caret"\n                   ng-if="!searchState.getIsSymbolSearchMode()"\n                   ng-click="onCaretClick($event)"\n                   ng-class="{ \'os-caret-active\': dropdownControl.isExpanded()}">\n                <svg class="caret"></svg>\n              </div>\n            </div>\n          </div>\n          <div class="feature-script-search-option" ng-if="!searchState.getIsSymbolSearchMode()">\n            <input type="checkbox" id="isCaseSensitive" name="isCaseSensitive" ng-model="searchState.isCaseSensitive">\n            <label for="isCaseSensitive" data-bs-original-title="{{\'tooltips:::Case-sensitive search\' | i18next}}" data-bs-placement="bottom">{{ \'Match case\' | i18next}}</label>\n          </div>\n          <div class="feature-script-search-option" ng-if="!searchState.getIsSymbolSearchMode()">\n            <input type="checkbox" id="isRegularExpression" name="isRegularExpression" ng-model="searchState.isRegularExpression">\n            <label for="isRegularExpression" data-bs-original-title="{{\'tooltips:::Regular expression search\' | i18next}}" data-bs-placement="bottom">{{ \'Regex\' | i18next}}</label>\n          </div>\n          <div class="text-input-container" ng-if="!searchState.getIsSymbolSearchMode()">\n            <input class="form-control" placeholder="{{\'Feature Studio name filter\' | i18next}}" type="text" name="elementGlobFilter" ng-model="searchState.elementGlobFilter" spellcheck="false" autocomplete="off">\n          </div>\n          <button class="btn btn-primary feature-script-search-button" ng-disabled="osForm.$error.required">{{\'Find\' | i18next}}</button>\n          <button type="button" class="btn-close close-feature-script-search" ng-click="closeFeatureScriptGlobalFind()"></button>\n        </div>\n      </os-form>\n      \x3c!-- Replace section: only show if workspace is editable --\x3e\n      <os-form ng-if="searchState.getShouldShowReplaceSection() && canShowReplaceField()">\n        <div class="feature-script-replace-query">\n          <input class="form-control" placeholder="{{\'Replace with\' | i18next}}" type="text" name="replaceString" ng-model="searchState.replaceString" spellcheck="false" autocomplete="off" os-focus-select-on-request="searchState" ng-disabled="searchState.getIsReplacing()" ng-enter="!getSymbolRenameError() && onReplaceAll()" ng-class="{\'feature-script-input-invalid\': searchState.replaceString && getSymbolRenameError()}">\n          <button class="btn btn-primary feature-script-replace-button" ng-click="onReplaceAll()" ng-disabled="!searchState.replaceString || !searchState.getShouldShowResults() || searchState.getIsReplacing() || getSymbolRenameError()" ng-class="{\'is-replacing\': searchState.getIsReplacing()}">\n            <span ng-if="!searchState.getIsReplacing() && searchState.getIsSymbolSearchMode()">{{\'Rename\' | i18next}}</span>\n            <span ng-if="!searchState.getIsReplacing() && !searchState.getIsSymbolSearchMode()">{{\'Replace all\' | i18next}}</span>\n            <span ng-if="searchState.getIsReplacing()">{{\'Replacing…\' | i18next}}</span>\n          </button>\n        </div>\n        <div class="feature-script-replace-error" ng-if="searchState.replaceString && getSymbolRenameError()"><span class="feature-script-rename-error-identity"><span class="feature-script-rename-error-prefix">{{\'Cannot rename symbol:\' | i18next}} "</span><span class="feature-script-rename-error-name ellipseOverflowText">{{searchState.replaceString}}</span><span class="feature-script-rename-error-quote">"</span></span> <span class="feature