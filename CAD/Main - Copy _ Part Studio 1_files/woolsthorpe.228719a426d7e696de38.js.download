rategyIcon(overallStrategy) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div ng-bind-html="ctrl.getOverallReplaceTitleHtml()" class="overall-preview-strategy-title"></div>\n              <div data-automation="overall-change-count" ng-if="ctrl.targetTabChangesCount === 0"><i>{{ ctrl.getOverallChangeCountString() }}</i></div>\n              <p ng-if="ctrl.targetTabChangesCount >= 1" class="compare-with-base-link">\n                <a class="btn-link" ng-click="ctrl.compareTargetAndSource()">\n                  <span ng-if="ctrl.targetTabChangesCount > 1" data-automation="overall-change-count">{{ ctrl.getOverallChangeCountString() }}</span>\n                  <span ng-if="ctrl.targetTabChangesCount === 1" data-automation="overall-change-count">{{ ctrl.getOverallChangeCountString() }}</span>\n                  <os-svg icon="arrow-up-right" class="new-tab-icon"></os-svg>\n                </a>\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \x3c!-- Customized restore strategy section --\x3e\n    <h4 class="modal-title">{{ \'Tabs\' | i18next }}</h4>\n    <div class="element-preview-strategy-table" os-select-dropdown-bounds prevent-scrolling="true">\n      \x3c!-- Headers of the table --\x3e\n      <div class="table-head">\n        <div class="table-row">\n          <div ng-if="ctrl.elementsWithChanges.length !== 1" class="tab-name">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.elementsWithChanges.length} }}</div>\n          <div ng-if="ctrl.elementsWithChanges.length === 1" class="tab-name">{{ \'1 tab has changes\' | i18next }}</div>\n          <div class="tab-changes selective-restore-tab-changes" ng-bind-html="ctrl.getChangesTitleHtml()"></div>\n          <div class="tab-strategy selective-restore-tab-strategy">{{ \'Tab restore strategy\' | i18next }}</div>\n        </div>\n      </div>\n\n      \x3c!-- Body of the table --\x3