e guests" | i18next }}</span>\n              </div>\n            </div>\n            <div class="role-identities"  ng-if="ctrl.isTabSelected(\'Individuals\')">\n              <div class="form-group os-project-role-input-container">\n                <label class="control-label">{{ "Add users to project roles" | i18next}}</label>\n                <div class="os-row align-items-center">\n                  <span class="os-row os-grow os-rolemap-user-input">\n                    <os-suggestions class="add-email"\n                      get-suggestions="ctrl.findFriends(query)"\n                      is-valid-new-suggestion="ctrl.isNewEmailValid(query)"\n                      os-input-tokens\n                      on-suggestion-selected="TokenController.addToken(suggestion)"\n                      placeholder="{{ ctrl.suggestionPlaceholder }}">\n                    </os-suggestions>\n                  </span>\n                  <span class="os-row os-rolemap-role-select">\n                    <ui-select class="os-grow" ng-model="ctrl.roleUserMapper.selectedSchemeEntry" theme="bootstrap" append-to-body="false" skip-focusser="true" data-bs-original-title="{{$select.selected.role.name}}">\n                      <ui-select-match placeholder="{{\'Select a role\' | i18next}}">{{$select.selected.role.name}}</ui-select-match>\n                      <ui-select-choices repeat="option in ctrl.schemeEntryList | filter: $select.search">\n                        <div data-bs-original-title="{{ctrl.getRoleNameTooltip(option)}}" data-bs-placement="right">\n                          <div class="permission-role-name" ng-bind-html="option.role.name">{{\'Select a role\' | i18next}}</div>\n                          <div class="small text-muted permission-name-text">{{option.displayPermissionName}}</div>\n                        </div>\n                      </ui-select-choices>\n                    </ui-select>\n                  </span>\n                  <span>\n                    <button t