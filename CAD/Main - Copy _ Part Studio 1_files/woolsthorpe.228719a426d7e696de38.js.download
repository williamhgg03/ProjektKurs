e.html\'" ng-controller="InsertItemsController as ctrl" class="insert-items-container" ng-show="viewState.shouldShowNonGeometricItems()"></div>\n\n  \x3c!-- Document filter list--\x3e\n  <div class="document-version-picker-section document-version-picker-document-filters select-item-dialog-subdialog-container"\n    ng-show="viewState.shouldShowDocumentFilterList()">\n    <osx-document-filters-component\n      [is-flat]="true"\n      display-source="documentVersionPicker"\n      [view-state]="viewState"\n      [global-tree-nodes]="globalTreeNodes"\n      (change-tree-node)="changeTreeNode($event.treeNode, $event.$event)"\n      (change-filter)="changeFilter($event.filterType)"\n      (change-filter-to-recently-referenced)="changeFilterToRecentlyReferenced($event.fullParameterId)"\n      [user-teams]="userTeams"\n      (change-team)="changeTeam($event.team)"\n      [user-labels]="userLabels"\n      (change-label)="changeLabel($event.label)"\n      [show-public-filter]="showPublicDocumentFilter">\n    </osx-document-filters-component>\n  </div>\n\n  \x3c!-- Element Libraries--\x3e\n  <div ng-include="\'/project/web/ts/elementLibrary/elementLibraryComponentTemplate.html\'"\n    ng-controller="ElementLibraryController as ctrl" ng-if="viewState.shouldShowElementLibraries()"\n    class="os-element-library-container"></div>\n\n  \x3c!-- Toolbar FS tables--\x3e\n  <div ng-include="\'/project/web/ts/selectItem/toolbarFsTableComponentTemplate.html\'"\n    ng-controller="ToolbarFsTableController as ctrl" ng-if="viewState.shouldShowToolbarFsTables()"\n    class="toolbar-fs-tables-container"></div>\n\n  \x3c!-- Document list--\x3e\n  <div class="document-version-picker-section document-version-picker-document-list select-item-dialog-subdialog-content"\n       ng-if="viewState.shouldShowDocumentsList()" when-scrolled="viewState.getDocumentSelector().documentVersionPickerSearchResult.loadNextDocuments()">\n    <div ng-show="viewState.getDocumentSelector().documentVersionPickerSearchResult.isFetchingFirstPage()" class="ns-select-item-dialog-item-empty">\n      <span>{{"Loading…" | i18next}}</span>\n    </div>\n    <div ng-if="!viewState.getDocumentSelector().documentVersionPickerSearchResult.isFetchingFirstPage()">\n      <div ng-show="viewState.getDocumentSelector().documentVersionPickerSearchResult.isEmpty()" class="ns-select-item-dialog-item-empty">\n        <span ng-if="!viewState.documentSearchText">{{"No documents found" | i18next}}</span>\n        <span ng-if="viewState.documentSearchText">{{"No results found" | i18next}}</span>\n\n      </div>\n      <picker-item-list class="select-item-tree" doc-selector="viewState.getDocumentSelector()"></picker-item-list>\n    </div>\n  </div>\n\n  \x3c!-- Version graph--\x3e\n  <div class="os-col document-version-picker-section document-version-picker-version-graph"\n       ng-if="viewState.shouldShowVersionGraph()"\n       ng-class="Ctrl.documentVersionPicker.getVersionGraphNgClasses()">\n    <div class="os-dialog-title-row os-version-graph-legend os-no-shrink">\n      <os-svg icon="workspace"></os-svg>\n      <span class="workspace-name">{{"Workspace" | i18next}}</span>\n      <os-svg icon="version"></os-svg>\n      <span class="version-name">{{"Version" | i18next}}</span>\n    </div>\n    <div class="os-dialog-title-row os-version-graph-legend os-no-shrink" ng-if="isReleaseEnabled()">\n      <os-svg icon="revision-pending"></os-svg>\n      <span class="version-name">{{"Release candidate" | i18next}}</span>\n      <os-svg icon="revision"></os-svg>\n      <span class="version-name">{{"Release" | i18next}}</span>\n    </div>\n    <div class="os-versions-container os-grow">\n      <div ng-if="doingQueries" class="os-padded-centered-holder">\n        <span >{{ "Loading versions…" | i18next}}</span>\n      </div>\n      <div ng-if="doingQueries" class="os-padded-centered-holder">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div os-version-graph\n           class="os-version-graph"\n           ng-show="showContent"\n           ng-style="{width: svgWidth + \'px\'}">\n      </div>\n      <div ng-show="showContent" class="os-version-list os-col">\n        <div ng-repeat="workspaceOrVersion in displayedWorkspacesAndVersions"\n             class="os-row os-align-center os-version-row os-selectable-item {{viewState.getDocumentSelector().isWorkspaceOrVersionSelectable(workspaceOrVersion) ? \'os-selectable-version\' : \'os-disabled-version\'}}"\n             ng-class="{\'os-selected\': viewState.getDocumentSelector().getIsCurrentWorkspaceOrVersion(workspaceOrVersion.id)}"\n             ng-click="viewState.getDocumentSelector().selectVersion(documentId, workspaceOrVersion)"\n             ng-style="{\'padding-left\': svgWidth + \'px\'}"\n             data-bs-original-title="{{workspaceOrVersion.name}}">\n          <span class="version-name">{{workspaceOrVersion.name}}</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Filter buttons --\x3e\n  <div class= "os-control-container os-wrap os-no-shrink" ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getShouldShowFilterBar() && viewState.getIsShowingInsertablesView() && !Ctrl.insertableSelector.getIsLoadingElementsOrConfigurations()">\n    <div class="os-control-row" >\n      <button ng-repeat="filter in Ctrl.insertableSelector.getCurrentInsertablesGroup().getFilterBar().filterButtons"\n              class="os-button os-clear"\n              ng-class="{\'os-right-justified\': filter.isButtonRightJustified(), \'os-active\': filter.isFilterActive}"\n              ng-click="filter.toggleFilterButton()"\n              ng-if="filter.isFilterVisible"\n              ng-disabled="filter.isFilterDisabled"\n              data-bs-original-title="{{filter.filterDisplayName}}"\n              data-bs-placement="right">\n        <div class="button-content">\n          <os-svg icon="{{filter.iconName}}" class="button-icon"></os-svg>\n        </div>\n      </button>\n  