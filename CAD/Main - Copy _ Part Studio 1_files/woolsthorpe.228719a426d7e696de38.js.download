xt }}&ensp;\n                </div>\n\n                <ul class="add-column-dropdown-menu add-bom-column dropdown-menu dropdown-menu-end" role="menu" ng-switch="bomController.possibleColumns.length > 0">\n                  <li ng-switch-when="true" ng-repeat="column in bomController.possibleColumns">\n                    <a class="dropdown-item" ng-click="bomController.columnAdded(column, $event)" data-bs-original-title="{{ column.displayName }}">\n                      <span>{{ column.displayName }}</span>\n                    </a>\n                  </li>\n                  <li ng-switch-when="false">\n                    <a class="dropdown-item disabled"><span>{{"No columns available" | i18next}}</span></a>\n                  </li>\n                </ul>\n              </div>\n              <div class="dropdown-button-container">\n                <div ng-if="bomController.shouldShowApplyTemplates()"\n                     class="dropdown os-add-property-dropdown apply-bom-template" auto-close="always"\n                     data-bs-original-title="{{\'tooltips:::Apply template to BOM table\' | i18next}}"\n                     data-bs-placement="left">\n                  <div data-bs-toggle="dropdown"\n                       data-bs-offset="0,0"\n                       class="dropdown-toggle btn btn-secondary btn-sm small-secondary-btn manage-columns-button"\n                       >{{ "Apply template" | i18next }}&ensp;\n                  </div>\n\n                  <ul class="add-column-dropdown-menu apply-bom-template dropdown-menu dropdown-menu-end" role="menu"\n                      ng-switch="bomController.tableTemplates.length > 0">\n                    <li ng-switch-when="true" ng-repeat="template in bomController.tableTemplates">\n                      <a class="dropdown-item" ng-click="bomController.applyTemplateToBomTable(template)" data-bs-original-title="{{ template.name }}">\n                        <span>{{ template.name }}</span>\n                  