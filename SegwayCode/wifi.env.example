# Copy to wifi.env (gitignored) and fill in. Environment variables with the
# same names take precedence over this file.

# --- Normal WiFi (WPA2-Personal: home network, phone hotspot) ---
WIFI_SSID="your-network"
WIFI_PASS="your-password"

# --- Eduroam (WPA2-Enterprise): use these instead of the block above ---
# Setting WIFI_EAP_USERNAME is what switches the chip to enterprise mode.
# WIFI_SSID="eduroam"
# WIFI_EAP_USERNAME="abc123@university.se"
# WIFI_PASS="your-eduroam-password"
# Optional outer/anonymous identity, defaults to WIFI_EAP_USERNAME
# WIFI_EAP_IDENTITY="anonymous@university.se"

# Address of the PC running server/, reachable from the chip's network
SERVER_URL="http://sjumilaskogen.se"
