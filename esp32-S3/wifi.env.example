# Copy to wifi.env. Environment variables take precedence over this file.

# Normal WPA2-Personal:
WIFI_SSID="your-network"
WIFI_PASS="your-password"

# Eduroam / WPA2-Enterprise: set WIFI_EAP_USERNAME to enable enterprise mode.
# WIFI_SSID="eduroam"
# WIFI_EAP_USERNAME="abc123@university.se"
# WIFI_PASS="your-eduroam-password"
# Optional anonymous outer identity:
# WIFI_EAP_IDENTITY="anonymous@university.se"

SERVER_URL="http://sjumilaskogen.se"
